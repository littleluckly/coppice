<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>

    <script>
      document.documentElement.classList.add('js');
    </script>

    <script>
      try {
        if (localStorage.getItem('coppice:collection-view') === 'list') {
          document.documentElement.dataset.collectionView = 'list';
        }
      } catch (error) {

      }
    </script>

    {% render 'css-variables' %}

    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {{ 'compare.css' | asset_url | stylesheet_tag }}

    {% render 'meta-tags' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" href="{{ settings.favicon | image_url: width: 32, height: 32, crop: 'center' }}" sizes="32x32">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180, crop: 'center' }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name }}">

    {% render 'skip-link' %}

    {% sections 'header-group' %}

    <script src="{{ 'cart-badge.js' | asset_url }}" defer></script>
    <script src="{{ 'fly-to-cart.js' | asset_url }}" defer></script>

    <script src="{{ 'compare.js' | asset_url }}" defer></script>

    <script src="{{ 'reveal-on-scroll.js' | asset_url }}" defer></script>

    <script src="{{ 'bottom-sheet.js' | asset_url }}" defer></script>

    <script src="{{ 'back-to-top.js' | asset_url }}" defer></script>

    <script src="{{ 'tooltip.js' | asset_url }}" defer></script>

    <main id="MainContent" class="main-content" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'compare-toast' %}

    {% render 'compare-announcer' %}

    {% render 'back-to-top' %}

    {% section 'cart-drawer' %}
  </body>
</html>
