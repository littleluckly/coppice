

{%- if section.blocks.size > 0 -%}
  <hero-slideshow
    class="hero-slideshow full-width{% unless section.settings.product_float %} hero-slideshow--no-float{% endunless %}"
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ 'sections.hero_slideshow.aria_label' | t }}"
    data-status-template="{{ 'sections.hero_slideshow.slide_status' | t: index: '#', count: section.blocks.size | escape }}"
    style="--hero-product-x: {{ section.settings.product_position_x }}%; --hero-product-y: {{ section.settings.product_position_y }}%; --hero-product-size: {{ section.settings.product_size }}%;"
  >
    <div class="hero-slideshow__viewport">
      {%- for block in section.blocks -%}
        {%- liquid
          assign is_first = forloop.first
          assign loading = 'lazy'
          assign fetch_priority = 'low'
          if is_first
            assign loading = 'eager'
            assign fetch_priority = 'high'
          endif
        -%}
        <div
          class="hero-slideshow__slide"
          data-hero-slide="{{ forloop.index0 }}"
          {% unless is_first %}hidden{% endunless %}
          {{ block.shopify_attributes }}
        >

          <div class="hero-slideshow__bg">
            <div class="hero-slideshow__media">
              {%- if block.settings.image != blank -%}

                {%- capture hero_bg_img -%}
                  {{ block.settings.image
                    | image_url: width: 2400
                    | image_tag:
                      widths: '800, 1200, 1600, 2400',
                      sizes: '100vw',
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      loading: loading,
                      fetchpriority: fetch_priority,
                      alt: block.settings.image.alt
                  }}
                {%- endcapture -%}
                {%- unless hero_bg_img contains ' alt=' -%}
                  {%- assign hero_bg_img = hero_bg_img | replace: '<img ', '<img alt="" ' -%}
                {%- endunless -%}
                {%- if block.settings.image_mobile != blank -%}

                  <picture style="--focal-m: {{ block.settings.image_mobile.presentation.focal_point | default: '50% 50%' }}">
                    <source
                      media="(max-width: 749px)"
                      srcset="{{ block.settings.image_mobile | image_url: width: 900 }} 900w, {{ block.settings.image_mobile | image_url: width: 1400 }} 1400w"
                      sizes="100vw"
                      width="{{ block.settings.image_mobile.width }}"
                      height="{{ block.settings.image_mobile.height }}"
                    >
                    {{ hero_bg_img }}
                  </picture>
                {%- else -%}
                  {{ hero_bg_img }}
                {%- endif -%}
              {%- elsif is_first -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'hero-slideshow__placeholder' }}
              {%- endif -%}
            </div>

            <div class="hero-slideshow__fade" aria-hidden="true"></div>
          </div>

          {%- if block.settings.product_image != blank -%}
            <div class="hero-slideshow__product">

              {%- capture hero_island_img -%}
                {{ block.settings.product_image
                  | image_url: width: 1200
                  | image_tag:
                    widths: '400, 600, 800, 1200',
                    sizes: '(min-width: 990px) 46vw, 86vw',
                    width: block.settings.product_image.width,
                    height: block.settings.product_image.height,
                    loading: loading,
                    fetchpriority: fetch_priority,
                    alt: block.settings.product_image.alt,
                    class: 'hero-slideshow__product-img'
                }}
              {%- endcapture -%}
              {%- unless hero_island_img contains ' alt=' -%}
                {%- assign hero_island_img = hero_island_img | replace: '<img ', '<img alt="" ' -%}
              {%- endunless -%}

              {%- if block.settings.product_image_mobile != blank -%}
                <picture>
                  <source
                    media="(max-width: 989px)"
                    srcset="{{ block.settings.product_image_mobile | image_url: width: 600 }} 600w, {{ block.settings.product_image_mobile | image_url: width: 900 }} 900w"
                    sizes="62vw"
                    width="{{ block.settings.product_image_mobile.width }}"
                    height="{{ block.settings.product_image_mobile.height }}"
                  >
                  {{ hero_island_img }}
                </picture>
              {%- else -%}
                {{ hero_island_img }}
              {%- endif -%}
            </div>
          {%- endif -%}

          <div class="hero-slideshow__content">
            {%- assign line_index = 0 -%}

            {%- if block.settings.eyebrow != blank -%}
              <div class="hero-slideshow__line" style="--line-index: {{ line_index }};">
                <p class="hero-slideshow__eyebrow">{{ block.settings.eyebrow | escape }}</p>
              </div>
              {%- assign line_index = line_index | plus: 1 -%}
            {%- endif -%}

            {%- if block.settings.heading != blank -%}
              <div class="hero-slideshow__line" style="--line-index: {{ line_index }};">
                {%- if is_first -%}
                  <h1 class="hero-slideshow__heading">{{ block.settings.heading | escape }}</h1>
                {%- else -%}
                  <h2 class="hero-slideshow__heading">{{ block.settings.heading | escape }}</h2>
                {%- endif -%}
              </div>
              {%- assign line_index = line_index | plus: 1 -%}
            {%- endif -%}

            {%- if block.settings.subheading != blank -%}
              <div class="hero-slideshow__line" style="--line-index: {{ line_index }};">
                <p class="hero-slideshow__subheading">{{ block.settings.subheading | escape }}</p>
              </div>
              {%- assign line_index = line_index | plus: 1 -%}
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <div class="hero-slideshow__line" style="--line-index: {{ line_index }};">
                <div class="hero-slideshow__cta-row">
                  <a class="hero-slideshow__cta btn-solid" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                  {%- if block.settings.button_label_2 != blank and block.settings.button_link_2 != blank -%}
                    <a class="hero-slideshow__cta btn-solid btn-solid--quiet" href="{{ block.settings.button_link_2 }}">
                      {{ block.settings.button_label_2 | escape }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.blocks.size > 1 -%}
      <div class="hero-slideshow__controls">
        <button
          type="button"
          class="hero-slideshow__arrow"
          aria-label="{{ 'sections.hero_slideshow.previous' | t }}"
          data-hero-prev
        >
          {{ 'icon-chevron-down.svg' | inline_asset_content }}
        </button>

        <div class="hero-slideshow__dots">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="hero-slideshow__dot{% if forloop.first %} is-active{% endif %}"
              aria-label="{{ 'sections.hero_slideshow.go_to_slide' | t: index: forloop.index }}"
              {% unless forloop.first %}tabindex="-1"{% endunless %}
              data-hero-dot="{{ forloop.index0 }}"
            ></button>
          {%- endfor -%}
        </div>

        <button
          type="button"
          class="hero-slideshow__arrow hero-slideshow__arrow--next"
          aria-label="{{ 'sections.hero_slideshow.next' | t }}"
          data-hero-next
        >
          {{ 'icon-chevron-down.svg' | inline_asset_content }}
        </button>
      </div>
    {%- endif -%}

    <p class="hero-slideshow__status visually-hidden" aria-live="polite" data-hero-status>
      {{ 'sections.hero_slideshow.slide_status' | t: index: 1, count: section.blocks.size }}
    </p>
  </hero-slideshow>
{%- endif -%}

{% stylesheet %}

  .hero-slideshow {
    --hero-product-out-dur: 450ms;
    --hero-text-start-offset: 220ms;
    --hero-text-out-dur: 400ms;
    --hero-text-stagger: 90ms;
    --hero-bg-out-dur: 600ms;

    --hero-bg-out-delay: 300ms;

    --hero-next-in-dur: 600ms;
    --hero-next-in-advance: 600ms;
    --hero-ease-in: cubic-bezier(0.6, 0, 0.8, 0.4);
    --hero-ease-out: cubic-bezier(0.4, 0, 0.2, 1);

    --hero-roll-ease: cubic-bezier(0.4, 0, 0.2, 1);

    --hero-enter-offset: 300ms;

    --hero-float-dur: 11s;

    display: block;
    position: relative;
  }

  .hero-slideshow__viewport {
    position: relative;
    overflow: hidden;
    min-height: clamp(22rem, 56vw, 44rem);
    background-color: var(--color-background);
  }
  .hero-slideshow__slide {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  .hero-slideshow__slide[hidden] {
    display: none;
  }

  .hero-slideshow__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }
  .hero-slideshow__media {
    position: absolute;
    inset: 0;
  }
  .hero-slideshow__media img,
  .hero-slideshow__media svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media screen and (max-width: 749px) {
    .hero-slideshow__media picture img {
      object-position: var(--focal-m, 50% 50%) !important;
    }
  }

  .hero-slideshow__fade {
    position: absolute;
    top: 0;
    left: -5%;
    width: 55%;
    height: 100%;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      to right,
      var(--color-background) 0%,
      color-mix(in srgb, var(--color-background) 70%, transparent) 40%,
      transparent 80%
    );
    border-radius: 0 60% 50% 0 / 0 70% 50% 0;
  }

  .hero-slideshow__product {
    position: absolute;
    left: var(--hero-product-x, 62%);
    top: var(--hero-product-y, 50%);
    translate: -50% -50%;
    z-index: 2;
    width: var(--hero-product-size, 46%);

    perspective: 1200px;
    will-change: transform, opacity;
  }
  .hero-slideshow__product-img {
    display: block;
    width: 100%;
    height: auto;
    transform-origin: 50% 60%;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 25%));
    animation: hero-product-float var(--hero-float-dur, 11s) ease-in-out infinite;
    will-change: transform;
  }
  .hero-slideshow--no-float .hero-slideshow__product-img {
    animation: none;
  }

  @keyframes hero-product-float {
    0%,
    100% {
      transform: rotateX(2.2deg) rotateY(-3.4deg) rotateZ(0.5deg) translateY(0) scale(1);
    }
    25% {
      transform: rotateX(-1.4deg) rotateY(1.8deg) rotateZ(-0.6deg) translateY(-10px) scale(1.012);
    }
    50% {
      transform: rotateX(2.8deg) rotateY(3.6deg) rotateZ(0.4deg) translateY(-4px) scale(1);
    }
    75% {
      transform: rotateX(-2deg) rotateY(-1.6deg) rotateZ(0.9deg) translateY(-12px) scale(1.008);
    }
  }

  .hero-slideshow__content {
    position: absolute;
    top: 50%;
    left: 6%;
    z-index: 3;
    width: min(34rem, 88vw);
    transform: translateY(-50%);
  }
  .hero-slideshow__line {
    will-change: transform, opacity;
  }
  .hero-slideshow__eyebrow {
    margin: 0 0 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.125em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
  }
  .hero-slideshow__heading {
    margin: 0;
    font-size: clamp(2.25rem, 4.6vw, 4.125rem);
    line-height: 1.08;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--color-foreground);
  }
  .hero-slideshow__subheading {
    margin: 1rem 0 0;
    max-width: 30rem;
    font-size: clamp(1rem, 1.25vw, 1.125rem);
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
  }
  .hero-slideshow__cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
    margin-block-start: 1.75rem;
  }

  .hero-slideshow__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.875rem 1.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
  }
  .hero-slideshow__cta:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }

  .hero-slideshow__controls {
    position: absolute;
    bottom: 1.75rem;
    left: 50%;
    translate: -50% 0;
    z-index: 10;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }
  .hero-slideshow__dots {
    display: flex;
    align-items: center;
    gap: 0.125rem;
  }

  .hero-slideshow__dot {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .hero-slideshow__dot::after {
    content: "";
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 72%, transparent);
    transition:
      width 0.28s var(--hero-ease-out, cubic-bezier(0.4, 0, 0.2, 1)),
      background-color 0.28s ease;
  }

  .hero-slideshow__dot.is-active::after {
    width: 1.125rem;
    background-color: var(--color-brand);
  }
  .hero-slideshow__dot:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 0;
  }

  .hero-slideshow__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.125rem;
    height: 2.125rem;
    padding: 0;
    border: 0;
    border-radius: 50%;

    background-color: color-mix(in srgb, var(--color-background) 55%, transparent);
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease;
  }
  .hero-slideshow__arrow:hover,
  .hero-slideshow__arrow:focus-visible {

    background-color: color-mix(in srgb, var(--color-background) 82%, transparent);
    color: var(--color-brand);
  }
  .hero-slideshow__arrow:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: -2px;
  }  .hero-slideshow__arrow svg {
    width: 0.75rem;
    height: 0.75rem;
  }
  .hero-slideshow__arrow--next svg {
    transform: rotate(-90deg);
  }
  .hero-slideshow__arrow:not(.hero-slideshow__arrow--next) svg {
    transform: rotate(90deg);
  }

  .hero-slideshow__product.is-out {
    animation: hero-product-out var(--hero-product-out-dur, 450ms)
      var(--hero-ease-in, cubic-bezier(0.6, 0, 0.8, 0.4)) forwards;
  }
  @keyframes hero-product-out {
    to {
      transform: translateY(-120px);
      opacity: 0;
    }
  }

  .hero-slideshow__line.is-out {
    animation: hero-text-out var(--hero-text-out-dur, 400ms)
      var(--hero-ease-in, cubic-bezier(0.6, 0, 0.8, 0.4)) forwards;
    animation-delay: calc(var(--line-index, 0) * var(--hero-text-stagger, 90ms));
  }
  @keyframes hero-text-out {
    to {
      transform: translateY(-80px);
      opacity: 0;
    }
  }

  .hero-slideshow__bg.is-out {
    animation: hero-bg-out var(--hero-bg-out-dur, 600ms)
      var(--hero-roll-ease, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
  }
  @keyframes hero-bg-out {
    to {
      transform: translateY(-100%);
    }
  }

  .hero-slideshow__slide.is-next-in {
    animation: hero-next-in var(--hero-next-in-dur, 600ms)
      var(--hero-roll-ease, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
  }
  @keyframes hero-next-in {
    from {
      transform: translateY(100%);
    }
    to {
      transform: translateY(0);
    }
  }

  .hero-slideshow__line.is-in {
    animation: hero-text-in var(--hero-text-out-dur, 400ms)
      var(--hero-ease-out, cubic-bezier(0.4, 0, 0.2, 1)) both;
    animation-delay: calc(
      var(--hero-enter-offset, 300ms) + var(--line-index, 0) * var(--hero-text-stagger, 90ms)
    );
  }
  @keyframes hero-text-in {
    from {
      transform: translateY(60px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .hero-slideshow__product.is-in {
    animation: hero-product-in var(--hero-product-out-dur, 450ms)
      var(--hero-ease-out, cubic-bezier(0.4, 0, 0.2, 1)) both;
    animation-delay: var(--hero-enter-offset, 300ms);
  }
  @keyframes hero-product-in {
    from {
      transform: translateY(60px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-slideshow__product.is-out,
    .hero-slideshow__product.is-in,
    .hero-slideshow__line.is-out,
    .hero-slideshow__line.is-in,
    .hero-slideshow__bg.is-out,
    .hero-slideshow__slide.is-next-in {
      animation-duration: 1ms !important;
      animation-delay: 0ms !important;
    }

    .hero-slideshow__product-img {
      animation: none !important;
    }
  }

  @media screen and (max-width: 989px) {

    .hero-slideshow__viewport {
      min-height: 24rem;
    }

    .hero-slideshow__product {
      top: 0;
      left: 50%;
      translate: -50% 0;
      width: 75%;
      height: 75%;
      max-width: none;
    }
    .hero-slideshow__product-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center bottom;
    }

    .hero-slideshow__content {
      top: auto;
      bottom: 18%;
      left: 50%;
      transform: translate(-50%, 0);
      text-align: center;
    }

    .hero-slideshow__eyebrow,
    .hero-slideshow__subheading {
      display: none;
    }

    .hero-slideshow__cta-row {
      justify-content: center;
      margin-block-start: 1rem;
    }

    .hero-slideshow .hero-slideshow__cta {
      box-shadow:
        0 4px 15px color-mix(in srgb, var(--color-brand) 20%, transparent),
        0 8px 20px rgb(0 0 0 / 22%);
    }

    .hero-slideshow__heading {
      color: #fff;
      text-shadow: 0 1px 14px rgb(0 0 0 / 32%);
    }

    .hero-slideshow__fade {
      top: auto;
      left: 0;

      bottom: 0;
      width: 100%;
      height: 25%;
      border-radius: 0;
      background: linear-gradient(
        to top,
        var(--color-background) 0%,
        color-mix(in srgb, var(--color-background) 70%, transparent) 40%,
        transparent 80%
      );
    }

    .hero-slideshow__controls {
      bottom: 0.5rem;
      gap: 0;
    }
    .hero-slideshow__arrow {
      display: none;
    }

    .hero-slideshow__bg.is-out { animation-name: hero-bg-out-x; }
    .hero-slideshow__slide.is-next-in { animation-name: hero-next-in-x; }
    .hero-slideshow__product.is-out { animation-name: hero-product-out-x; }
    .hero-slideshow__line.is-out { animation-name: hero-text-out-x; }
    .hero-slideshow__line.is-in { animation-name: hero-text-in-x; }
    .hero-slideshow__product.is-in { animation-name: hero-product-in-x; }

    [data-hero-dir='prev'] .hero-slideshow__bg.is-out { animation-name: hero-bg-out-x-rev; }
    [data-hero-dir='prev'] .hero-slideshow__slide.is-next-in { animation-name: hero-next-in-x-rev; }
    [data-hero-dir='prev'] .hero-slideshow__product.is-out { animation-name: hero-product-out-x-rev; }
    [data-hero-dir='prev'] .hero-slideshow__line.is-out { animation-name: hero-text-out-x-rev; }
    [data-hero-dir='prev'] .hero-slideshow__line.is-in { animation-name: hero-text-in-x-rev; }
    [data-hero-dir='prev'] .hero-slideshow__product.is-in { animation-name: hero-product-in-x-rev; }

    .hero-slideshow__bg.is-out .hero-slideshow__fade {
      animation: hero-fade-hold-out var(--hero-bg-out-dur, 600ms)
        var(--hero-roll-ease, cubic-bezier(0.4, 0, 0.2, 1)) forwards;
    }
    .hero-slideshow__slide.is-next-in .hero-slideshow__fade {
      animation: hero-fade-hold-in var(--hero-next-in-dur, 600ms)
        var(--hero-roll-ease, cubic-bezier(0.4, 0, 0.2, 1)) both;
    }
    [data-hero-dir='prev'] .hero-slideshow__bg.is-out .hero-slideshow__fade {
      animation-name: hero-fade-hold-out-rev;
    }
    [data-hero-dir='prev'] .hero-slideshow__slide.is-next-in .hero-slideshow__fade {
      animation-name: hero-fade-hold-in-rev;
    }
    @keyframes hero-fade-hold-out {
      to { transform: translateX(100%); }
    }
    @keyframes hero-fade-hold-out-rev {
      to { transform: translateX(-100%); }
    }
    @keyframes hero-fade-hold-in {
      from { transform: translateX(-100%); }
      to { transform: translateX(0); }
    }
    @keyframes hero-fade-hold-in-rev {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }

    @keyframes hero-bg-out-x {
      to { transform: translateX(-100%); }
    }
    @keyframes hero-bg-out-x-rev {
      to { transform: translateX(100%); }
    }
    @keyframes hero-next-in-x {
      from { transform: translateX(100%); }
      to { transform: translateX(0); }
    }
    @keyframes hero-next-in-x-rev {
      from { transform: translateX(-100%); }
      to { transform: translateX(0); }
    }

    @keyframes hero-product-out-x {
      to { transform: translateX(-56px); opacity: 0; }
    }
    @keyframes hero-product-out-x-rev {
      to { transform: translateX(56px); opacity: 0; }
    }
    @keyframes hero-text-out-x {
      to { transform: translateX(-48px); opacity: 0; }
    }
    @keyframes hero-text-out-x-rev {
      to { transform: translateX(48px); opacity: 0; }
    }
    @keyframes hero-text-in-x {
      from { transform: translateX(48px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes hero-text-in-x-rev {
      from { transform: translateX(-48px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes hero-product-in-x {
      from { transform: translateX(56px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    @keyframes hero-product-in-x-rev {
      from { transform: translateX(-56px); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  }
{% endstylesheet %}

