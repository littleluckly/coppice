

{%- liquid
  assign s = section.settings

  assign heading_text = s.heading
  if heading_text == blank
    assign heading_text = '404.title' | t
  endif

  assign body_text = s.body
  if body_text == blank
    assign body_text = '404.not_found' | t
  endif

  assign primary_label = s.primary_label
  if primary_label == blank
    assign primary_label = '404.back_to_home' | t
  endif

  assign secondary_label = s.secondary_label
  if secondary_label == blank
    assign secondary_label = '404.browse_products' | t
  endif

  assign primary_link = s.primary_link
  if primary_link == blank
    assign primary_link = routes.root_url
  endif

  assign secondary_link = s.secondary_link
  if secondary_link == blank
    assign secondary_link = routes.all_products_collection_url
  endif

  assign has_image = false
  if s.image != blank
    assign has_image = true
  endif
-%}

<div class="not-found{% if has_image %} not-found--image{% endif %} full-width">
  {%- if has_image -%}

    {%- assign hero_img = s.image
      | image_url: width: 2400
      | image_tag:
        widths: '750, 1100, 1500, 2000, 2400',
        sizes: '100vw',
        loading: 'eager',
        fetchpriority: 'high'
    -%}
    {%- assign hero_img = hero_img | replace: '<img ', '<img alt="" ' -%}
    <span class="not-found__media" style="--focal: {{ s.image.presentation.focal_point | default: '50% 50%' }}">
      {{ hero_img }}
    </span>
    <span class="not-found__scrim" aria-hidden="true"></span>
  {%- endif -%}

  <div class="not-found__inner">
    <div class="not-found__copy">
      {%- if s.show_code -%}
        <p class="not-found__code" aria-hidden="true">
          <span class="not-found__digit">4</span>
          <svg class="not-found__zero" viewBox="0 0 74 100" aria-hidden="true" focusable="false">
            <ellipse cx="37" cy="50" rx="28.5" ry="41" fill="none" stroke="currentColor" stroke-width="19" />
            <path d="M46 31Q58.5 60.4 27 66Q14.5 36.6 46 31Z" fill="currentColor" />
            <path d="M28 65Q36.5 48.5 45 32" fill="none" stroke="var(--color-background)" stroke-width="3" stroke-linecap="round" />
          </svg>
          <span class="not-found__digit">4</span>
        </p>
      {%- endif -%}

      <h1 class="not-found__heading">{{ heading_text | escape }}</h1>

      {%- if body_text != blank -%}
        <p class="not-found__body">{{ body_text | escape }}</p>
      {%- endif -%}

      <div class="not-found__actions">
        <a class="btn-solid not-found__cta" href="{{ primary_link }}">
          {{- 'icon-arrow-left.svg' | inline_asset_content -}}
          <span>{{ primary_label | escape }}</span>
        </a>
        {%- if s.show_secondary -%}
          <a class="btn-solid btn-solid--quiet not-found__cta" href="{{ secondary_link }}">
            <span>{{ secondary_label | escape }}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}

  .not-found {
    position: relative;
    display: grid;
    grid-template-areas: 'stage';
    align-items: center;

    min-block-size: 32rem;
    min-block-size: max(32rem, 82vh);
    min-block-size: max(32rem, 82svh);
    background-color: var(--color-background);
    overflow: hidden;
  }

  .not-found:not(.not-found--image) {
    background-image: radial-gradient(
      120% 100% at 28% 42%,
      color-mix(in srgb, var(--color-brand) 9%, var(--color-background)) 0%,
      var(--color-background) 62%
    );
  }

  .not-found:not(.not-found--image) .not-found__inner {
    grid-template-columns: minmax(0, 22rem);
    justify-content: center;
    padding-inline-start: 0;
  }

  .not-found__media {
    grid-area: stage;
    position: absolute;
    inset: 0;
    display: block;
    z-index: 0;
  }

  .not-found__media img {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
    object-position: var(--focal, 50% 50%);
  }

  .not-found__scrim {
    grid-area: stage;
    position: absolute;
    inset: 0;
    display: block;
    z-index: 1;
    background-image: linear-gradient(
      90deg,
      var(--color-background) 0%,
      var(--color-background) 32%,
      color-mix(in srgb, var(--color-background) 80%, transparent) 40%,
      color-mix(in srgb, var(--color-background) 44%, transparent) 49%,
      color-mix(in srgb, var(--color-background) 14%, transparent) 58%,
      transparent 68%
    );
  }

  .not-found__inner {
    grid-area: stage;
    position: relative;
    z-index: 2;

    inline-size: 100%;
    max-inline-size: var(--content-width, 90rem);
    margin-inline: auto;
    padding-block: clamp(3rem, 7vw, 5.5rem);

    padding-inline-start: clamp(0px, 5vw, 4.5rem);

    display: grid;
    grid-template-columns: minmax(0, 22rem) 1fr;
    align-items: center;
  }

  .not-found__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-inline-size: 0;
  }

  .not-found__code {
    display: flex;
    align-items: center;
    margin: 0;
    font-size: clamp(4.5rem, 12.5vw, 11rem);
    font-weight: 700;

    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--color-brand);
  }

  .not-found__digit {
    display: block;
  }

  .not-found__zero {
    display: block;
    flex: none;
    inline-size: 0.533em;
    block-size: 0.72em;
  }

  .not-found__heading {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--color-brand);
  }

  .not-found__code + .not-found__heading {
    margin-block-start: clamp(1.25rem, 2.4vw, 1.75rem);
  }

  .not-found__body {
    margin: clamp(0.75rem, 1.4vw, 1rem) 0 0;
    font-size: clamp(0.9375rem, 1.1vw, 1.0625rem);
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;

    gap: 0.625rem;
    margin-block-start: clamp(1.5rem, 3vw, 2.125rem);
  }

  .not-found__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.8125rem 1.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;

    white-space: nowrap;
  }

  .not-found__cta svg {
    flex: none;
    inline-size: 1.125em;
    block-size: 1.125em;

    margin-inline-start: -0.125rem;
  }

  @media (max-width: 749px) {
    .not-found {
      grid-template-areas:
        'media'
        'stage';

      min-block-size: 0;
    }

    .not-found__media {
      position: static;
      grid-area: media;

      aspect-ratio: 4 / 3;
    }

    .not-found__scrim {
      display: none;
    }

    .not-found__inner {
      grid-area: stage;
      grid-template-columns: minmax(0, 1fr);
      padding-block: clamp(2.25rem, 8vw, 3rem) clamp(2.5rem, 9vw, 3.5rem);

      padding-inline-start: 0;
    }

    .not-found__code {
      font-size: clamp(4rem, 26vw, 6.5rem);
    }
  }

  @media (max-width: 419px) {
    .not-found__cta {
      inline-size: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__cta {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.404",
  "tag": "section",
  "class": "not-found-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.not_found.labels.image",
      "info": "t:sections.not_found.labels.image_info"
    },
    {
      "type": "checkbox",
      "id": "show_code",
      "label": "t:sections.not_found.labels.show_code",
      "info": "t:sections.not_found.labels.show_code_info",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "Oops! Page Not Found"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "t:sections.not_found.labels.body",
      "default": "The page you're looking for might have been removed, had its name changed, or is temporarily unavailable."
    },
    {
      "type": "header",
      "content": "t:sections.not_found.labels.actions"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "t:sections.not_found.labels.primary_label",
      "default": "Back to Home"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "t:sections.not_found.labels.primary_link",
      "info": "t:sections.not_found.labels.primary_link_info"
    },
    {
      "type": "checkbox",
      "id": "show_secondary",
      "label": "t:sections.not_found.labels.show_secondary",
      "default": true
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "t:sections.not_found.labels.secondary_label",
      "default": "Browse Products"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "t:sections.not_found.labels.secondary_link",
      "info": "t:sections.not_found.labels.secondary_link_info"
    }
  ],
  "presets": [
    {
      "name": "t:general.404"
    }
  ]
}
{% endschema %}
