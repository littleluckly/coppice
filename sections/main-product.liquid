            { "value": "returns", "label": "t:sections.main_product.blocks.trust_item.icons.returns" },
            { "value": "warranty", "label": "t:sections.main_product.blocks.trust_item.icons.warranty" }
          ],
          "default": "shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.main_product.blocks.trust_item.text",
          "info": "t:sections.main_product.blocks.trust_item.text_info"
        }
      ]
    },
    {
      "type": "pickup",
      "name": "t:sections.main_product.blocks.pickup.name",
      "limit": 1
    },
    {
      "type": "compare",
      "name": "t:sections.main_product.blocks.compare.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main_product.name",
      "blocks": [
        { "type": "spec_bullets" },
        { "type": "trust_warranty" },
