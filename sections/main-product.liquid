

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign media_count = product.media.size
  assign form_id = 'product-form-' | append: section.id

  assign has_model = false
  assign image_count = 0
  for media in product.media
    if media.media_type == 'model'
      assign has_model = true
    elsif media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor

  # 价格基线（G-12，2026-11-18）：URL 带 ?selling_plan= 时平台会给出选中计划
  # （`product.selected_selling_plan_allocation`），此时价格区必须显示计划价，
  # 否则刷新后页头价与加购价对不上。无计划选中时它就是变体自身价。
  assign displayed_price = current_variant.price
  assign displayed_compare = current_variant.compare_at_price
  assign selected_allocation = product.selected_selling_plan_allocation
  if selected_allocation != blank
    assign displayed_price = selected_allocation.price
    assign displayed_compare = selected_allocation.compare_at_price | default: current_variant.compare_at_price
  endif

  assign save_percent = 0
  if displayed_compare > displayed_price
    assign price_diff = displayed_compare | minus: displayed_price
    assign save_percent = price_diff | times: 100.0 | divided_by: displayed_compare | round
  endif

  # 媒体框的宽高比（2026-10-28）：取第一张媒体的 preview_image。视频与 3D 也有
  # preview_image（视频是自动截的封面帧），所以三种类型都有值。
  # 用 preview_image 而不是原始媒体尺寸：预览图才是页面上真正被看到的那一版。
  # 取不到时按 1（正方）兜底——宁可方正，也不要让框塌成 0。
  assign gallery_ratio = 1
  assign first_media = product.media.first
  if first_media.preview_image
    assign gallery_ratio = first_media.preview_image.aspect_ratio
  endif
-%}

<script src="{{ 'product-gallery.js' | asset_url }}" defer></script>
<script src="{{ 'product-form.js' | asset_url }}" defer></script>
<script src="{{ 'pickup-availability.js' | asset_url }}" defer></script>
{%- if product.gift_card? and section.settings.show_gift_card_recipient -%}
  <script src="{{ 'gift-card-recipient.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if product.selling_plan_groups.size > 0 and section.settings.show_selling_plans -%}
  <script src="{{ 'selling-plan-picker.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if has_model -%}
  <link
    rel="stylesheet"
    href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
  >
  <script
    src="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.js"
    defer
  ></script>
{%- endif -%}

<section
  class="main-product"
  data-section-id="{{ section.id }}"
  data-save-template="{{ 'products.product.save_percent' | t: percent: '[percent]' }}"
>
  {%- if section.settings.show_breadcrumb -%}
    <nav class="main-product__breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
      <ol class="main-product__breadcrumb-list" role="list">
        <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>
        {%- if collection != blank -%}
          <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
        {%- endif -%}
        <li><span aria-current="page">{{ product.title | escape }}</span></li>
      </ol>
    </nav>
  {%- endif -%}

  <div class="main-product__layout">
    <product-gallery
      class="product-gallery{% if media_count > 1 %} product-gallery--thumbnails{% endif %}"
      data-media-count="{{ media_count }}"
    >
      <div class="product-gallery__stage">
        <ul class="product-gallery__slides" role="list" style="--gallery-ratio: {{ gallery_ratio }}">
          {%- for media in product.media -%}
            {%- assign is_first = false -%}
            {%- if forloop.first -%}{%- assign is_first = true -%}{%- endif -%}
            <li
              class="product-gallery__slide{% if is_first %} is-active{% endif %}"
              data-media-id="{{ media.id }}"
              data-media-type="{{ media.media_type }}"
              {% unless is_first %}
                hidden
              {% endunless %}
              aria-roledescription="slide"
              aria-label="{{ 'products.product.media_slide' | t: index: forloop.index, total: media_count }}"
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    if is_first
                      assign img_loading = 'eager'
                      assign img_priority = 'high'
                    else
                      assign img_loading = 'lazy'
                      assign img_priority = 'auto'
                    endif
                  -%}

                  <button
                    type="button"
                    class="product-gallery__zoom"
                    data-gallery-zoom
                    data-zoom-alt="{{ media.alt | default: product.title | escape }}"
                    aria-haspopup="dialog"
                    aria-label="{{ 'products.product.media_expand' | t }}"
                  >
                    {{
                      media
                      | image_url: width: 1600
                      | image_tag:
                        loading: img_loading,
                        fetchpriority: img_priority,
                        widths: '400,600,800,1200,1600',
                        sizes: '(min-width: 1100px) 48vw, 100vw',
                        class: 'product-gallery__img',
                        alt: media.alt
                    }}
                  </button>
                {%- when 'video', 'external_video', 'model' -%}

                  <div class="product-gallery__deferred" data-deferred-media>
                    <button
                      type="button"
                      class="product-gallery__deferred-button"
                      data-deferred-trigger
                      aria-label="{% if media.media_type == 'model' %}{{ 'products.product.view_in_3d' | t }}{% else %}{{ 'products.product.play_video' | t }}{% endif %}"
                    >
                      {%- if media.preview_image -%}
                        {{
                          media.preview_image
                          | image_url: width: 1600
                          | image_tag:
                            loading: 'lazy',
                            widths: '400,600,800,1200,1600',
                            sizes: '(min-width: 1100px) 48vw, 100vw',
                            class: 'product-gallery__img',
                            alt: media.alt
                        }}
                      {%- endif -%}
                      <span class="product-gallery__deferred-icon" aria-hidden="true">
                        {%- if media.media_type == 'model' -%}
                          3D
                        {%- else -%}
                          {{- 'icon-play.svg' | inline_asset_content -}}
                        {%- endif -%}
                      </span>
                    </button>
                    <template>

                      {%- case media.media_type -%}
                        {%- when 'video' -%}
                          {{ media | video_tag: controls: true, playsinline: true, preload: 'metadata' }}
                        {%- when 'external_video' -%}
                          {{ media | external_video_url: autoplay: 1 | external_video_tag }}
                        {%- when 'model' -%}
                          {{ media | model_viewer_tag }}
                      {%- endcase -%}
                    </template>
                  </div>
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>

        {%- if media_count > 1 -%}
          <button
            type="button"
            class="product-gallery__arrow product-gallery__arrow--prev"
            data-gallery-prev
            aria-label="{{ 'products.product.media_previous' | t }}"
          >
            {{- 'icon-chevron-left.svg' | inline_asset_content -}}
          </button>
          <button
            type="button"
            class="product-gallery__arrow product-gallery__arrow--next"
            data-gallery-next
            aria-label="{{ 'products.product.media_next' | t }}"
          >
            {{- 'icon-chevron-right.svg' | inline_asset_content -}}
          </button>
          <div class="product-gallery__dots">
            {%- for media in product.media -%}
              <button
                type="button"
                class="product-gallery__dot{% if forloop.first %} is-active{% endif %}"
                data-gallery-dot="{{ forloop.index0 }}"
                aria-label="{{ 'products.product.media_slide' | t: index: forloop.index, total: media_count }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              ></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- if media_count > 1 -%}
        <ul class="product-gallery__thumbs" role="list">
          {%- for media in product.media -%}

            {%- liquid
              if media.media_type == 'model'
                assign thumb_label = 'products.product.media_slide_3d' | t: index: forloop.index, total: media_count
              elsif media.media_type == 'video' or media.media_type == 'external_video'
                assign thumb_label = 'products.product.media_slide_video' | t: index: forloop.index, total: media_count
              else
                assign thumb_label = 'products.product.media_slide' | t: index: forloop.index, total: media_count
              endif
            -%}
            <li>
              <button
                type="button"
                class="product-gallery__thumb{% if forloop.first %} is-active{% endif %}"
                data-gallery-thumb="{{ forloop.index0 }}"
                data-media-type="{{ media.media_type }}"
                aria-label="{{ thumb_label | escape }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >
                {%- if media.preview_image -%}
                  {{
                    media.preview_image
                    | image_url: width: 200
                    | image_tag:
                      loading: 'lazy',
                      widths: '100,150,200',
                      sizes: '76px',
                      class: 'product-gallery__thumb-img',
                      alt: ''
                  }}
                {%- endif -%}
                {%- if media.media_type != 'image' -%}

                  <span class="product-gallery__thumb-badge" aria-hidden="true">
                    {%- if media.media_type == 'model' -%}
                      3D
                    {%- else -%}
                      {{- 'icon-play.svg' | inline_asset_content -}}
                    {%- endif -%}
                  </span>
                {%- endif -%}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if image_count > 0 -%}

        <dialog
          class="product-lightbox"
          data-gallery-lightbox
          scroll-lock
          aria-label="{{ 'products.product.media_viewer' | t }}"
          data-counter-template="{{ 'products.product.media_counter' | t: index: '[index]', total: '[total]' }}"
        >
          <div class="product-lightbox__bar">
            <p class="product-lightbox__counter" data-lightbox-counter aria-live="polite"></p>
            <button
              type="button"
              class="product-lightbox__close"
              data-lightbox-close
              aria-label="{{ 'products.product.media_close' | t }}"
            >
              {{- 'icon-close.svg' | inline_asset_content -}}
            </button>
          </div>
          <div class="product-lightbox__stage">
            <button
              type="button"
              class="product-lightbox__arrow product-lightbox__arrow--prev"
              data-lightbox-prev
              aria-label="{{ 'products.product.media_previous' | t }}"
            >
              {{- 'icon-chevron-left.svg' | inline_asset_content -}}
            </button>
            <div class="product-lightbox__canvas" data-lightbox-canvas></div>
            <button
              type="button"
              class="product-lightbox__arrow product-lightbox__arrow--next"
              data-lightbox-next
              aria-label="{{ 'products.product.media_next' | t }}"
            >
              {{- 'icon-chevron-right.svg' | inline_asset_content -}}
            </button>
          </div>
        </dialog>
      {%- endif -%}
    </product-gallery>

    <div class="main-product__info">
      <h1 class="main-product__title">{{ product.title | escape }}</h1>

      {%- capture badges -%}
        {%- assign sub_width = product.metafields.spec.cutting_width_mm.value -%}
        {%- assign sub_bar = product.metafields.spec.bar_length_mm.value -%}
        {%- assign sub_op = product.metafields.spec.operation_type.value -%}
        {%- if product.metafields.spec.power_source.value == 'Battery' -%}
          {%- assign sub_power = product.metafields.spec.power_w.value -%}
          {%- assign sub_power_unit = 'power_w' -%}
          {%- if sub_power == blank -%}
            {%- assign sub_power = product.metafields.platform.battery_platform.value -%}
            {%- assign sub_power_unit = 'raw' -%}
          {%- endif -%}
        {%- else -%}
          {%- assign sub_power = product.metafields.spec.displacement_cc.value -%}
          {%- assign sub_power_unit = 'displacement_cc' -%}
        {%- endif -%}

        {%- if sub_width != blank -%}
          <span class="main-product__badge">
            {%- render 'spec-value', value: sub_width, unit_type: 'length_mm' -%}
          </span>
        {%- elsif sub_bar != blank -%}
          <span class="main-product__badge">
            {%- render 'spec-value', value: sub_bar, unit_type: 'length_mm' -%}
          </span>
        {%- endif -%}

        {%- if sub_op != blank and sub_op != 'N/A' -%}
          <span class="main-product__badge">{{ sub_op }}</span>
        {%- endif -%}

        {%- if sub_power != blank -%}
          {%- if sub_power_unit == 'raw' -%}
            <span class="main-product__badge">{{ sub_power }}</span>
          {%- else -%}
            <span class="main-product__badge">
              {%- render 'spec-value', value: sub_power, unit_type: sub_power_unit -%}
            </span>
          {%- endif -%}
        {%- endif -%}
      {%- endcapture -%}
      {%- assign badges_text = badges | strip_html | strip -%}
      {%- if badges_text != blank -%}
        <div class="main-product__badges">{{ badges }}</div>
      {%- endif -%}

      <div class="main-product__price">
        <span class="main-product__price-current" data-price>{{ displayed_price | money }}</span>
        <s
          class="main-product__price-compare"
          data-compare-price
          {% unless displayed_compare > displayed_price %}
            hidden
          {% endunless %}
        >
          {{- displayed_compare | money -}}
        </s>
        <span
          class="main-product__price-save"
          data-save-badge
          {% unless displayed_compare > displayed_price %}
            hidden
          {% endunless %}
        >
          {{- 'products.product.save_percent' | t: percent: save_percent -}}
        </span>
      </div>

      {%- if current_variant.unit_price_measurement -%}
        <p class="main-product__unit-price" data-unit-price>
          {{- current_variant.unit_price | money -}}
          <span aria-hidden="true">/</span>
          <span class="visually-hidden">{{ 'products.product.unit_price_separator' | t }}</span>
          {{- current_variant.unit_price_measurement.reference_value -}}
          {{- current_variant.unit_price_measurement.reference_unit -}}
        </p>
      {%- endif -%}

      {%- if section.settings.show_description and product.description != blank -%}
        <div class="main-product__excerpt">
          {{ product.description | strip_html | truncatewords: section.settings.description_words }}
        </div>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        {%- capture variants_json -%}
          [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | money | json }},
              "compare": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
              "save": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | times: 100.0 | divided_by: variant.compare_at_price | round }}{% else %}0{% endif %},
              "unitPrice": {% if variant.unit_price_measurement %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
              "unitReference": {% if variant.unit_price_measurement %}{{ variant.unit_price_measurement.reference_value }}{{ variant.unit_price_measurement.reference_unit }}{% else %}null{% endif %},
              "mediaId": {{ variant.featured_media.id | default: 0 }}
            }{%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
          ]
        {%- endcapture -%}

        <variant-picker class="product-variant">
          <script type="application/json" data-variant-json>{{ variants_json | strip }}</script>
          {%- for option in product.options_with_values -%}
            <fieldset class="product-variant__group">
              <legend class="product-variant__label">{{ option.name | escape }}</legend>
              <div class="product-variant__values">
                {%- for value in option.values -%}
                  {%- assign input_id = 'option-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                  <input
                    type="radio"
                    class="product-variant__radio visually-hidden"
                    id="{{ input_id }}"
                    name="options[{{ option.name | escape }}]"
                    value="{{ value | escape }}"
                    form="{{ form_id }}"
                    data-option-position="{{ option.position }}"
                    {% if option.selected_value == value %}
                      checked
                    {% endif %}
                  >
                  <label class="product-variant__pill" for="{{ input_id }}">{{ value | escape }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
        </variant-picker>
      {%- endunless -%}

      <product-form class="product-form" data-section-id="{{ section.id }}">
        {%- form 'product', product, id: form_id, class: 'product-form__form', novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-input>

          {%- if product.gift_card? and section.settings.show_gift_card_recipient -%}
            {%- render 'gift-card-recipient', product: product, form: form, section: section -%}
          {%- endif -%}

          {%- if product.selling_plan_groups.size > 0 and section.settings.show_selling_plans -%}
            {%- render 'selling-plan-picker', product: product, section: section, variant: current_variant -%}
          {%- endif -%}

          <div class="product-form__row">
            <quantity-input class="quantity">
              <button
                type="button"
                class="quantity__button"
                data-quantity-minus
                aria-label="{{ 'products.product.decrease_quantity' | t }}"
              >
                <span aria-hidden="true">&minus;</span>
              </button>
              <input
                class="quantity__input"
                type="number"
                name="quantity"
                id="Quantity-{{ section.id }}"
                value="1"
                min="1"
                step="1"
                data-quantity-input
              >
              <label class="visually-hidden" for="Quantity-{{ section.id }}">
                {{- 'products.product.quantity' | t -}}
              </label>
              <button
                type="button"
                class="quantity__button"
                data-quantity-plus
                aria-label="{{ 'products.product.increase_quantity' | t }}"
              >
                <span aria-hidden="true">+</span>
              </button>
            </quantity-input>

            <button
              type="submit"
              class="product-form__submit btn-solid"
              data-add-button
              data-added-label="{{ 'products.product.added' | t }}"
              data-added-message="{{ 'products.product.added_message' | t: title: product.title }}"
              data-error-message="{{ 'products.product.add_error' | t }}"
              data-sold-out-label="{{ 'products.product.sold_out' | t }}"
              data-add-label="{{ 'products.product.add_to_cart' | t }}"
              {% unless current_variant.available %}
                disabled
              {% endunless %}
            >
              {%- if current_variant.available -%}
                {{ 'products.product.add_to_cart' | t }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </button>
          </div>

          <p class="product-form__status" data-form-status role="status" aria-live="polite"></p>

          {%- if section.settings.show_accelerated_checkout -%}
            <div class="product-form__accelerated">{{ form | payment_button }}</div>
          {%- endif -%}

          {%- if section.settings.show_payment_terms -%}
            <div class="product-form__terms">{{ form | payment_terms }}</div>
          {%- endif -%}
        {%- endform -%}
      </product-form>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'trust_warranty', 'trust_item', 'spec_bullets' -%}
            {%- continue -%}

          {%- when 'pickup' -%}

            {%- assign pickup_items = current_variant.store_availabilities | where: 'pick_up_enabled', true -%}
            {%- if pickup_items.size > 0 -%}
              <div class="main-product__block" data-pickup-block aria-live="polite" {{ block.shopify_attributes }}>
                <pickup-availability
                  class="pickup"
                  data-variant-id="{{ current_variant.id }}"
                  data-section-id="{{ section.id }}"
                  data-url="{{ product.url }}"
                  data-label-checking="{{ 'products.product.pickup_checking' | t }}"
                >
                  <h2 class="pickup__heading">{{ 'products.product.pickup_heading' | t }}</h2>
                  {%- assign any_pickup = false -%}
                  <ul class="pickup__list" role="list">
                    {%- for item in pickup_items -%}
                      {%- if item.available -%}
                        {%- assign any_pickup = true -%}
                        <li class="pickup__item">
                          <span class="pickup__store">{{ item.location.name | escape }}</span>

                          {%- if item.pick_up_time != blank -%}
                            <span class="pickup__time">{{ item.pick_up_time | escape }}</span>
                          {%- endif -%}
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                  {%- unless any_pickup -%}
                    <p class="pickup__unavailable">{{ 'products.product.pickup_unavailable' | t }}</p>
                  {%- endunless -%}
                </pickup-availability>
              </div>
            {%- endif -%}

          {%- when 'compare' -%}
            <div class="main-product__block main-product__block--compare" {{ block.shopify_attributes }}>
              {% render 'compare-button', product: product %}
            </div>

          {%- when '@app' -%}

            {% render block %}
        {%- endcase -%}
      {%- endfor -%}

      {%- assign has_spec = false -%}
      {%- assign has_trust = false -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'spec_bullets' -%}
          {%- assign has_spec = true -%}
        {%- elsif block.type == 'trust_warranty' or block.type == 'trust_item' -%}
          {%- assign has_trust = true -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_spec -%}
        <div class="main-product__specs">
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec_bullets' -%}
              <div {{ block.shopify_attributes }}>
                {% render 'spec-bullets', product: product %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_trust -%}
        <div class="main-product__trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_warranty' -%}
              {%- assign warranty = product.metafields.spec.warranty_months.value -%}
              {%- if warranty != blank and warranty != 0 -%}
                <div class="trust-item" {{ block.shopify_attributes }}>
                  <span class="trust-item__icon" aria-hidden="true">
                    {{- 'icon-warranty.svg' | inline_asset_content -}}
                  </span>
                  <span class="trust-item__text">
                    {%- assign warranty_rest = warranty | modulo: 12 -%}
                    {%- if warranty_rest == 0 -%}
                      {%- assign warranty_years = warranty | divided_by: 12 -%}
                      {{- 'products.product.warranty_years' | t: years: warranty_years -}}
                    {%- else -%}
                      {{- 'products.product.warranty_months' | t: months: warranty -}}
                    {%- endif -%}
                  </span>
                </div>
              {%- endif -%}
            {%- elsif block.type == 'trust_item' -%}
              {%- if block.settings.text != blank -%}
                <div class="trust-item" {{ block.shopify_attributes }}>
                  <span class="trust-item__icon" aria-hidden="true">
                    {%- case block.settings.icon -%}
                      {%- when 'shipping' -%}
                        {{- 'icon-truck.svg' | inline_asset_content -}}
                      {%- when 'returns' -%}
                        {{- 'icon-return.svg' | inline_asset_content -}}
                      {%- else -%}
                        {{- 'icon-warranty.svg' | inline_asset_content -}}
                    {%- endcase -%}
                  </span>
                  <span class="trust-item__text">{{ block.settings.text | escape }}</span>
                </div>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .main-product {
    padding-block: 1rem 2.5rem;
  }

  .main-product__breadcrumb-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    font-size: 0.82rem;
    color: var(--color-foreground-muted);
  }
  .main-product__breadcrumb-list li + li::before {
    content: '/';
    margin-inline-end: 0.35rem;
    opacity: 0.6;
  }
  .main-product__breadcrumb-list a {
    color: inherit;
    text-decoration: none;
  }
  .main-product__breadcrumb-list a:hover {
    color: var(--color-brand);
    text-decoration: underline;
  }
  .main-product__breadcrumb-list [aria-current='page'] {
    color: var(--color-foreground);
  }

  .main-product__layout {
    display: grid;
    gap: 1.5rem;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 1100px) {
    .main-product__layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      gap: 2.5rem;
      align-items: start;
    }
  }

  .product-gallery {
    display: block;
    min-inline-size: 0;
  }
  .product-gallery__stage {
    position: relative;
    display: block;
  }
  .product-gallery__slides {
    position: relative;
    margin: 0;
    padding: 0;
    list-style: none;
    border-radius: calc(var(--style-border-radius-inputs) * 1.5);
    background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
    overflow: hidden;

    box-shadow: 0 10px 30px color-mix(in srgb, var(--color-brand) 8%, transparent);

    aspect-ratio: var(--gallery-ratio, 1);
    max-block-size: 78vh;

    margin-inline: auto;
  }

  .product-gallery__slide {
    position: absolute;
    inset: 0;
    margin: 0;
  }
  .product-gallery__slide[hidden] {
    display: none;
  }

  .product-gallery__img,
  .product-gallery__slide :is(video, iframe, model-viewer) {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    background-color: var(--color-background);
  }
  .product-gallery__deferred {
    position: absolute;
    inset: 0;
  }
  .product-gallery__deferred-button {

    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .product-gallery__deferred-icon {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    inline-size: 64px;
    block-size: 64px;
    border-radius: 999px;
    background-color: var(--color-brand);
    color: var(--color-background);
    font-size: 0.95rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-foreground) 28%, transparent);
  }
  .product-gallery__deferred-icon svg {
    inline-size: 26px;
    block-size: 26px;
  }

  .product-gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-background) 92%, transparent);
    color: var(--color-foreground);
    cursor: pointer;
    transition:
      background-color 0.22s ease,
      border-color 0.22s ease,
      color 0.22s ease,
      box-shadow 0.22s ease;
  }
  .product-gallery__arrow svg {
    width: 18px;
    height: 18px;
  }
  .product-gallery__arrow--prev {
    inset-inline-start: 0.75rem;
  }
  .product-gallery__arrow--next {
    inset-inline-end: 0.75rem;
  }
  .product-gallery__arrow:hover,
  .product-gallery__arrow:focus-visible {
    border-color: var(--color-brand);
    background-color: var(--color-brand);
    color: var(--color-background);
    box-shadow: 0 4px 14px color-mix(in srgb, var(--color-brand) 34%, transparent);
  }
  @media (prefers-reduced-motion: reduce) {
    .product-gallery__arrow {
      transition: none;
    }
  }
  @media (min-width: 750px) {
    .product-gallery__arrow {
      display: grid;
    }
  }

  .product-gallery__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }
  .product-gallery__dot {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 28%, transparent);
    cursor: pointer;
    transition: width 0.2s ease, background-color 0.2s ease;
  }
  .product-gallery__dot.is-active {
    width: 20px;
    background-color: var(--color-brand);
  }

  @media (min-width: 1100px) {
    .product-gallery__dots {
      display: none;
    }
  }

  .product-gallery__thumbs {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: thin;
  }
  .product-gallery__thumb {
    display: block;
    position: relative;
    width: 76px;
    padding: 0;
    border: 2px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    cursor: pointer;
    overflow: hidden;
  }
  .product-gallery__thumb.is-active {
    border-color: var(--color-brand);
  }
  .product-gallery__thumb-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: contain;
  }

  .product-gallery__thumb-badge {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    inline-size: 32px;
    block-size: 32px;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 80%, transparent);
    color: var(--color-background);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.02em;
    pointer-events: none;
  }
  .product-gallery__thumb-badge svg {
    inline-size: 18px;
    block-size: 18px;
  }

  .product-gallery__zoom {

    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .product-gallery__zoom:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  @media (min-width: 1100px) {

    .product-gallery--thumbnails {
      display: grid;
      grid-template-columns: 76px minmax(0, 1fr);
      gap: 0.75rem;
      align-items: start;
    }
    .product-gallery__thumbs {
      order: -1;
      flex-direction: column;
      overflow-y: auto;
      max-height: 78vh;
    }
  }

  .product-lightbox {
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    overflow: hidden;
  }

  .product-lightbox:not([open]) {
    display: none;
  }
  .product-lightbox[open] {
    display: grid;

    grid-template-rows: auto minmax(0, 1fr);
  }

  .product-lightbox::backdrop {
    background-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }

  .product-lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem clamp(0.75rem, 3vw, 1.5rem);
  }

  .product-lightbox__counter {
    padding: 0.3rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 999px;
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground);
  }

  .product-lightbox__close,
  .product-lightbox__arrow {
    display: grid;
    place-items: center;

    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-foreground);
    cursor: pointer;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .product-lightbox__close:hover,
  .product-lightbox__arrow:hover {
    border-color: var(--color-brand);
    color: var(--color-brand);
  }
  .product-lightbox__close:focus-visible,
  .product-lightbox__arrow:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .product-lightbox__close svg,
  .product-lightbox__arrow svg {
    inline-size: 20px;
    block-size: 20px;
  }

  .product-lightbox__arrow[hidden] {
    display: none;
  }

  .product-lightbox__stage {

    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(0.25rem, 2vw, 1.5rem);
    min-block-size: 0;
    padding: 0 clamp(0.5rem, 3vw, 1.5rem) clamp(1rem, 4vh, 2.5rem);
  }

  .product-lightbox__canvas {

    grid-column: 2;

    container-type: size;
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 0;
    min-block-size: 0;
    block-size: 100%;
  }

  .product-lightbox__img {
    inline-size: auto;
    block-size: auto;
    max-inline-size: 100%;
    max-block-size: 100%;
    max-inline-size: 100cqw;
    max-block-size: 100cqh;
    object-fit: contain;
  }

  .main-product__info {
    min-inline-size: 0;
  }
  .main-product__title {
    margin: 0 0 0.35rem;
    font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
  }

  .main-product__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
  }
  .main-product__badge {
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-brand) 12%, transparent);
    color: var(--color-brand);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .main-product__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    margin-block-end: 0.25rem;
  }
  .main-product__price-current {
    font-size: clamp(1.75rem, 1.5rem + 0.8vw, 2rem);
    font-weight: 700;
    color: var(--color-brand);
  }
  .main-product__price-compare {
    color: var(--color-foreground-muted);
    font-size: 1rem;
  }
  .main-product__price-save {
    padding: 3px 10px;
    border-radius: 999px;

    background-color: var(--color-sale-surface);
    color: var(--color-sale);
    font-size: 0.8rem;
    font-weight: 600;
  }
  .main-product__unit-price {
    margin: 0 0 1rem;
    font-size: 0.82rem;
    color: var(--color-foreground-muted);
  }
  .main-product__excerpt {
    margin-block: 1rem;
    color: var(--color-foreground-muted);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .product-variant__group {
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }
  .product-variant__label {
    padding: 0;
    margin-block-end: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .product-variant__values {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .product-variant__pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
    font-size: 0.9rem;
  }
  .product-variant__radio:checked + .product-variant__pill {
    border-color: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand);
    color: var(--color-brand);
    font-weight: 500;
  }
  .product-variant__radio:focus-visible + .product-variant__pill {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }

  .product-plans {
    display: block;
    margin-block-end: 1rem;
  }
  .product-plans__set {
    margin: 0;
    padding: 0;
    border: 0;
  }
  .product-plans__heading {
    padding: 0;
    margin-block-end: 0.5rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-foreground);
  }
  .product-plans__group + .product-plans__group {
    margin-block-start: 0.75rem;
  }
  .product-plans__group-name {
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-foreground-muted);
  }
  .product-plans__option {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    padding: 0.6rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
    border-radius: var(--style-border-radius-inputs);
    cursor: pointer;
  }

  .product-plans__option[hidden] {
    display: none;
  }
  .product-plans__option + .product-plans__option {
    margin-block-start: 0.5rem;
  }
  .product-plans__option:has(.product-plans__radio:checked) {
    border-color: var(--color-brand);
    box-shadow: inset 0 0 0 1px var(--color-brand);
  }
  .product-plans__option:has(.product-plans__radio:focus-visible) {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }
  .product-plans__option:has(.product-plans__radio:disabled) {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .product-plans__radio {
    flex: none;
    margin-block-start: 0.25rem;
    accent-color: var(--color-brand);
  }
  .product-plans__body {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    min-inline-size: 0;
  }
  .product-plans__name {
    font-size: 0.9rem;
    line-height: 1.4;
  }
  .product-plans__save {
    padding: 0.05rem 0.4rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-brand) 12%, transparent);
    color: var(--color-brand);
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .product-form__row {
    display: flex;
    gap: 0.75rem;
    margin-block-start: 1rem;
  }
  .quantity {
    display: inline-flex;
    align-items: stretch;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);

    border-radius: 999px;
    overflow: hidden;
    flex: 0 0 auto;
    transition: border-color 0.2s ease;
  }

  .quantity:hover {
    border-color: var(--color-brand);
  }
  .quantity__button {
    width: 44px;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font-size: 1rem;
    cursor: pointer;
    transition: transform 0.1s ease, color 0.2s ease;
  }
  .quantity__button:hover {
    background-color: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }
  .quantity__button:active {
    transform: scale(0.8);
    color: var(--color-brand);
  }
  .quantity__input {
    width: 3.25rem;
    min-height: 44px;
    border: 0;
    background: none;
    color: var(--color-foreground);
    font: inherit;
    text-align: center;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .quantity__input::-webkit-outer-spin-button,
  .quantity__input::-webkit-inner-spin-button {
    appearance: none;
    margin: 0;
  }

  .product-form__submit {
    flex: 1 1 auto;
    padding: 10px 1.25rem;
    font: inherit;
    font-weight: 500;
  }
  .product-form__status {
    margin: 0.5rem 0 0;
    min-height: 1.2em;
    font-size: 0.85rem;
    color: var(--color-foreground-muted);
  }
  .product-form__accelerated,
  .product-form__terms {
    margin-block-start: 0.75rem;
  }

  .product-form__accelerated shopify-accelerated-checkout {
    --shopify-accelerated-checkout-button-border-radius: 999px;
    --shopify-accelerated-checkout-button-block-size: 44px;
    --shopify-accelerated-checkout-button-box-shadow: inset 0 0 0 1.5px var(--color-brand);
  }
  .product-form__accelerated .shopify-payment-button__button--unbranded {
    border-radius: 999px;
    background-color: transparent;
    color: var(--color-brand);
    box-shadow: inset 0 0 0 1.5px var(--color-brand);
  }
  .product-form__accelerated .shopify-payment-button__button--unbranded:hover:not([disabled]) {
    background-color: color-mix(in srgb, var(--color-brand) 7%, transparent);
  }

  .gift-recipient {

    display: block;
    margin-block-start: 1rem;
    padding: 0.75rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background-color: color-mix(in srgb, var(--color-foreground) 3%, transparent);
  }
  .gift-recipient__toggle {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-block-size: 32px;
    font-size: 0.88rem;
    font-weight: 600;
    cursor: pointer;
  }
  .gift-recipient__checkbox:focus-visible + .gift-recipient__toggle {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .gift-recipient__tick {
    position: relative;
    flex: 0 0 auto;
    inline-size: 20px;
    block-size: 20px;
    border: 1.5px solid color-mix(in srgb, var(--color-foreground) 35%, transparent);
    border-radius: 5px;
    background-color: var(--color-background);
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .gift-recipient__tick::after {
    content: '';
    position: absolute;
    inset-block-start: 46%;
    inset-inline-start: 50%;
    inline-size: 9px;
    block-size: 4px;
    border-inline-start: 2px solid var(--color-background);
    border-block-end: 2px solid var(--color-background);
    opacity: 0;
    translate: -50% -50%;
    rotate: -45deg;
  }
  .gift-recipient__checkbox:checked + .gift-recipient__toggle .gift-recipient__tick {
    border-color: var(--color-brand);
    background-color: var(--color-brand);
  }
  .gift-recipient__checkbox:checked + .gift-recipient__toggle .gift-recipient__tick::after {
    opacity: 1;
  }

  .gift-recipient__fields {
    display: grid;
    gap: 0.75rem;
    margin-block-start: 0.75rem;
    padding-block-start: 0.75rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }
  .gift-recipient:defined:not([open]) .gift-recipient__fields {
    display: none;
  }

  .gift-recipient__field {
    display: grid;
    gap: 0.3rem;
  }
  .gift-recipient__label {
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-foreground-muted);
  }
  .gift-recipient__input {
    inline-size: 100%;
    min-block-size: 44px;
    padding: 0.55rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 20%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    color: var(--color-foreground);
    font: inherit;
    font-size: 0.9rem;
  }
  .gift-recipient__input::placeholder {
    color: var(--color-foreground-muted);
    opacity: 1;
  }
  .gift-recipient__input:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 1px;
  }
  .gift-recipient__textarea {
    min-block-size: 4.5rem;
    resize: vertical;
  }
  .gift-recipient__hint {
    font-size: 0.75rem;
    color: var(--color-foreground-muted);
  }

  .main-product__block {
    margin-block-start: 0.75rem;
  }

  .main-product__specs {
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
  }

  .main-product__trust {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem 1rem;
    margin-block-start: 1.25rem;
    padding-block-start: 1.25rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
  }
  .trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-foreground-muted);
    transition: color 0.2s ease;
  }
  .trust-item:hover {
    color: var(--color-brand);
  }
  .trust-item__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--color-brand);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .trust-item:hover .trust-item__icon {
    transform: scale(1.25) rotate(5deg);
  }
  .trust-item__icon svg {
    width: 20px;
    height: 20px;
  }
  .pickup__heading {
    margin: 0 0 0.35rem;
    font-size: 0.88rem;
    font-weight: 500;
  }
  .pickup__list {
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--color-foreground-muted);
  }
  .pickup__item {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .pickup__item + .pickup__item {
    margin-block-start: 0.5rem;
  }
  .pickup__store {
    color: var(--color-foreground);
  }

  .pickup__time {
    flex-basis: 100%;
    font-size: 0.8rem;
    color: var(--color-foreground-muted);
  }
  .pickup__unavailable {
    margin: 0;
    font-size: 0.85rem;
    color: var(--color-foreground-muted);
  }

  .product-compare__button {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 44px;
    padding: 0.25rem;
    border: 0;
    background: none;
    color: var(--color-brand);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
  }
  .product-compare__box {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;

    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
    color: var(--color-brand);
    border: 1.5px solid color-mix(in srgb, var(--color-brand) 55%, transparent);
    border-radius: 6px;
    transition: transform 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }
  .product-compare__box svg {
    width: 16px;
    height: 16px;
  }

  .product-compare__button:hover .product-compare__box {
    transform: scale(1.05) rotate(5deg);
    border-color: var(--color-brand);
  }
  .product-compare__button:hover .product-compare__label {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .product-compare__button[aria-pressed='true'] .product-compare__box {
    background-color: var(--color-brand);
    color: var(--color-background);
    border-color: var(--color-brand);
  }
  .product-compare__button[aria-pressed='true'] {
    color: var(--color-brand-accent);
  }

  .spec-bullets {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.5rem 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .spec-bullets__item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-foreground-muted);
    transition: color 0.2s ease;
  }
  .spec-bullets__item:hover {
    color: var(--color-brand);
  }
  .spec-bullets__icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    color: var(--color-brand);
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }
  .spec-bullets__item:hover .spec-bullets__icon {
    transform: scale(1.25) rotate(5deg);
  }
  .spec-bullets__icon svg {
    width: 18px;
    height: 18px;
  }
  .spec-bullets__text {
    display: inline-flex;
    gap: 0.3rem;
    align-items: baseline;
  }
  .spec-bullets__text .spec-value,
  .spec-bullets__value {
    color: var(--color-foreground);
    font-weight: 500;
  }

  @keyframes main-product-rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .main-product__title,
    .main-product__badges,
    .main-product__price,
    .main-product__unit-price,
    .main-product__excerpt,
    .product-variant,
    .product-form,
    .main-product__block,
    .main-product__specs,
    .main-product__trust {
      animation: main-product-rise 0.4s ease both;
    }

    .main-product__title { animation-delay: 0s; }
    .main-product__badges { animation-delay: 0.05s; }
    .main-product__price,
    .main-product__unit-price { animation-delay: 0.1s; }
    .main-product__excerpt,
    .product-variant { animation-delay: 0.15s; }
    .product-form { animation-delay: 0.2s; }
    .main-product__block { animation-delay: 0.25s; }
    .main-product__specs { animation-delay: 0.28s; }
    .main-product__trust { animation-delay: 0.32s; }
  }

  @media (max-width: 749px) {
    .product-form__row {
      flex-wrap: wrap;
    }
    .quantity {
      order: 2;
    }
    .product-form__submit {
      order: 1;
      flex: 1 0 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.main_product.name",
  "tag": "section",
  "class": "main-product-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "t:sections.main_product.labels.show_breadcrumb",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:sections.main_product.labels.show_description",
      "default": true
    },
    {
      "type": "range",
      "id": "description_words",
      "min": 20,
      "max": 80,
      "step": 10,
      "label": "t:sections.main_product.labels.description_words",
      "default": 40
    },
    {
      "type": "header",
      "content": "t:sections.main_product.headers.purchase_options"
    },
    {
      "type": "checkbox",
      "id": "show_selling_plans",
      "label": "t:sections.main_product.labels.show_selling_plans",
      "info": "t:sections.main_product.labels.selling_plans_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.headers.checkout"
    },
    {
      "type": "checkbox",
      "id": "show_accelerated_checkout",
      "label": "t:sections.main_product.labels.show_accelerated_checkout",
      "info": "t:sections.main_product.labels.accelerated_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_terms",
      "label": "t:sections.main_product.labels.show_payment_terms",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.main_product.headers.gift_card"
    },
    {
      "type": "checkbox",
      "id": "show_gift_card_recipient",
      "label": "t:sections.main_product.labels.show_gift_card_recipient",
      "info": "t:sections.main_product.labels.gift_card_recipient_info",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "spec_bullets",
      "name": "t:sections.main_product.blocks.spec_bullets.name",
      "limit": 1
