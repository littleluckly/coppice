

{%- liquid
  assign compare_group = ''
  assign compare_handle = page.handle | default: ''

  assign tail = compare_handle | slice: -8, 8
  if tail == '-compare'
    assign compare_group = compare_handle | remove: '-compare'
  endif

  assign compare_row_keys_captured = ''
-%}

{%- capture compare_row_keys_captured -%}{%- render 'compare-row-keys', group: compare_group -%}{%- endcapture -%}

{%- liquid
  assign row_keys = compare_row_keys_captured | strip | split: ','

  assign compare_collection = blank
  for candidate in settings.compare_collections
    assign declared = candidate.metafields.custom.compare_group.value
    if declared == blank
      assign declared = candidate.handle
    endif
    assign declared = declared | strip | downcase | remove: '-compare'
    if declared == compare_group
      assign compare_collection = candidate
      break
    endif
  endfor

  assign compare_products = compare_collection.products
  assign compare_total = 0
  if compare_collection != blank
    assign compare_total = compare_products.size
  endif

  assign over_limit = false
  if compare_total > 50
    assign over_limit = true
  endif

  assign datasheet_limit = 50

  assign compare_heading = section.settings.heading
  if compare_heading == blank
    assign compare_heading = page.title
  endif
  if compare_heading == blank
    assign compare_heading = 'compare.page.default_title' | t
  endif
-%}

<span hidden data-compare-page-marker></span>

{%- if compare_group == blank -%}

  <div class="compare-page__notice">
    <p>{{ 'compare.page.group_missing' | t }}</p>
  </div>

{%- elsif compare_collection == blank -%}

  <div class="compare-page__notice">
    <p>{{ 'compare.page.collection_missing' | t }}</p>
    <a class="compare-page__back" href="{{ routes.all_products_collection_url }}">
      {{- 'compare.page.back' | t -}}
    </a>
  </div>

{%- elsif compare_total < 2 -%}

  <div class="compare-page__notice">
    <p>{{ 'compare.page.empty_group' | t }}</p>
    <a class="compare-page__back" href="{{ routes.all_products_collection_url }}">
      {{- 'compare.page.back' | t -}}
    </a>
  </div>

{%- else -%}

  <section class="compare-page" data-compare-page data-compare-group="{{ compare_group }}">
    <header class="compare-page__header">
      <h1 class="compare-page__title">
        {{ compare_heading }}
      </h1>
      {%- if section.settings.intro != blank -%}
        <div class="compare-page__intro">{{ section.settings.intro }}</div>
      {%- endif -%}
    </header>

    <div class="compare-table-wrap" data-compare-table-wrap></div>

    <div class="compare-empty" data-compare-empty>
      <p class="compare-empty__js">{{ 'compare.page.empty_selection' | t }}</p>
      <noscript>
        <p>{{ 'compare.page.no_js' | t }}</p>
      </noscript>
      <a class="compare-page__back" href="{{ routes.all_products_collection_url }}">
        {{- 'compare.page.back' | t -}}
      </a>
    </div>

    {%- if over_limit -%}
      <p class="compare-page__limit">
        {{ 'compare.page.over_limit' | t: count: compare_total, limit: 50 }}
      </p>
      {%- if request.design_mode -%}

        <p class="compare-page__editor-warning" role="note">
          {{ 'compare.page.editor_warning' | t: count: compare_total, limit: 50 }}
        </p>
      {%- endif -%}
    {%- endif -%}
  </section>

  {%- capture compare_rows_json -%}
    {%- for row_key in row_keys -%}
      {%- if forloop.index > 1 -%},{%- endif -%}
      {%- capture row_label -%}{%- render 'compare-row-label', row_key: row_key -%}{%- endcapture -%}{"k":{{ row_key | json }},"l":{{ row_label | strip | json }}}
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture compare_items_json -%}
    {%- for product in compare_products limit: datasheet_limit -%}
      {%- if forloop.index > 1 -%},{%- endif -%}
      {"h":{{ product.handle | json }},"t":{{ product.title | json }},"u":{{ product.url | json }},"n":{{ product.metafields.spec.spec_variance_note.value | json }},"v":[
      {%- for row_key in row_keys -%}
        {%- if forloop.index > 1 -%},{%- endif -%}
        {%- capture cell_text -%}{%- render 'compare-cell', product: product, row_key: row_key, as_text: true -%}{%- endcapture -%}
        {{ cell_text | strip | json }}
      {%- endfor -%}
      ]}
    {%- endfor -%}
  {%- endcapture -%}

  <script
    type="application/json"
    id="cmp-data"
    data-label-not-in-scope="{{ 'compare.page.not_in_scope' | t }}"
    data-label-variant-note="{{ 'compare.page.variant_note' | t }}"
    data-label-diff-only="{{ 'compare.page.diff_only' | t }}"
    data-label-loaded="{{ 'compare.page.loaded' | t: count: '[count]' }}"
    data-product-base="{{ routes.root_url }}products/"
    data-label-remove="{{ 'compare.remove' | t }}"
  >
    {"group":{{ compare_group | json }},"rows":[{{ compare_rows_json }}],"items":[{{ compare_items_json }}]}
  </script>

{%- endif -%}

{% stylesheet %}

.compare-page-section {
  --compare-border: color-mix(in srgb, var(--color-foreground) 14%, transparent);
  --compare-muted: color-mix(in srgb, var(--color-foreground) 60%, transparent);

  overflow-x: clip;
  min-inline-size: 0;
}

.compare-page {

  inline-size: 100%;
  max-inline-size: 1400px;
  margin-inline: auto;
  padding-block: clamp(2rem, 5vw, 4rem);
  padding-inline: clamp(1rem, 4vw, 2.5rem);

  min-inline-size: 0;
}

[data-compare-table-wrap]:not([data-ready]) {
  display: none;
}

html.js [data-compare-table-wrap][data-ready] {
  animation: compare-table-reveal 0.22s ease both;
}

@keyframes compare-table-reveal {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@media (prefers-reduced-motion: reduce) {
  html.js [data-compare-table-wrap] {
    animation: none;
  }
}

.compare-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
  padding-block: clamp(3rem, 8vw, 6rem);
  text-align: center;
  color: var(--color-foreground);
}

.compare-empty[hidden] {
  display: none;
}

html:not(.js) .compare-empty__js {
  display: none;
}

.compare-page__header {
  margin-block-end: clamp(1.5rem, 3vw, 2.5rem);
}

.compare-page__title {
  margin: 0 0 0.5rem;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  line-height: 1.15;
}

.compare-page__intro {
  max-inline-size: 62ch;
  color: var(--color-foreground);
}

.compare-page__notice {

  inline-size: 100%;
  max-inline-size: 62ch;
  margin-inline: auto;
  padding-block: clamp(3rem, 8vw, 6rem);
  padding-inline: clamp(1rem, 4vw, 2.5rem);
  text-align: center;
}

.compare-page__back {
  display: inline-flex;
  align-items: center;
  min-block-size: 44px;
  margin-block-start: 1rem;
  padding-inline: 1.25rem;
  border: 1px solid var(--color-foreground);
  border-radius: 4px;
  color: var(--color-foreground);
  text-decoration: none;
}

.compare-table__col--out-of-scope,
.compare-table__cell--out-of-scope {
  background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
}

.compare-table__out-of-scope {
  margin: 0 0 0.5rem;
  font-size: 0.8rem;
  line-height: 1.35;
  color: var(--compare-muted);
}

.compare-page__editor-warning {
  margin-block-start: 0.75rem;
  padding: 0.75rem 1rem;
  border: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
  border-radius: 4px;
  background-color: color-mix(in srgb, var(--color-foreground) 6%, var(--color-background));
  font-size: 0.85rem;
  line-height: 1.5;
}

.compare-page__limit {
  margin-block-start: 1rem;
  font-size: 0.85rem;
  color: var(--compare-muted);
}

.compare-table-wrap {
  overflow-x: auto;
  overscroll-behavior-x: contain;
}

.compare-table {

  inline-size: max(100%, 640px);
  min-inline-size: 640px;
  border-collapse: collapse;

  table-layout: fixed;
  font-size: 0.9rem;
}

.compare-table th,
.compare-table td {
  padding: 0.75rem 0.85rem;
  border-block-end: 1px solid var(--compare-border);
  text-align: start;
  vertical-align: top;
}

.compare-table thead th {
  border-block-end-width: 2px;
  font-weight: 400;
}

.compare-table__corner,
.compare-table__row-label {
  inline-size: 10rem;
}

.compare-table__col {
  inline-size: auto;
}

.compare-table__col {
  position: relative;
}

.compare-table__col-remove {
  position: absolute;
  inset-block-start: 0.3rem;
  inset-inline-end: 0.3rem;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  inline-size: 24px;
  block-size: 24px;
  padding: 0;
  border: 1px solid color-mix(in srgb, var(--color-foreground) 22%, transparent);
  border-radius: 50%;
  background-color: var(--color-background);
  color: var(--color-foreground);
  font-size: 0.85rem;
  line-height: 1;
  cursor: pointer;
}

.compare-table__col-remove::after {
  content: '';
  position: absolute;
  inset: -10px;
}

.compare-table__col-remove:hover {
  border-color: var(--color-foreground);
}

.compare-table__col-remove:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 2px;
}

.compare-table__product {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  color: inherit;
  text-decoration: none;
}

.compare-table__product img {
  inline-size: 100%;
  block-size: auto;
  aspect-ratio: 4 / 3;
  object-fit: contain;
  border-radius: 4px;
  background-color: color-mix(in srgb, var(--color-foreground) 4%, var(--color-background));
}

.compare-table__product-title {
  font-weight: 600;
  line-height: 1.3;
}

.compare-table__row-label {
  font-weight: 500;
  color: var(--compare-muted);
  white-space: nowrap;
}

.compare-table__value--missing {
  color: var(--compare-muted);
}

.compare-table tr[data-compare-diff] .compare-table__value {
  font-weight: 600;
}

.compare-page__diff-toggle {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  min-block-size: 44px;
  margin-block-end: 0.75rem;
  font-size: 0.85rem;
  cursor: pointer;
}

.compare-table__note {
  margin-block-start: 0.35rem;
  font-size: 0.8rem;
}

.compare-table__note summary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  inline-size: 20px;
  block-size: 20px;
  border: 1px solid var(--compare-border);
  border-radius: 50%;
  cursor: pointer;
  list-style: none;
}

.compare-table__note summary::-webkit-details-marker {
  display: none;
}

.compare-table__note p {
  margin: 0.4rem 0 0;
  color: var(--compare-muted);
}

@media (max-width: 767px) {
  .compare-table thead th {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    background-color: var(--color-background);
  }

}
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.compare_page.name",
  "tag": "div",
  "class": "compare-page-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.compare_page.settings.heading.label",
      "info": "t:sections.compare_page.settings.heading.info"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "t:sections.compare_page.settings.intro.label",
      "info": "t:sections.compare_page.settings.intro.info"
    }
  ],
  "presets": [
    {
      "name": "t:sections.compare_page.presets.name"
    }
  ]
}
{% endschema %}
