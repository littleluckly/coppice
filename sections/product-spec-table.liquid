

{%- liquid
  assign group = product.metafields.spec.compare_group.value
  assign group_key = group | downcase | remove: '-compare'
  if group_key == blank
    assign group_key = 'generic'
  endif

  assign variance_note = product.metafields.spec.spec_variance_note.value

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.product_spec_table.default_heading' | t
  endif
-%}

{%- capture row_keys_raw -%}{%- render 'compare-row-keys', group: group_key -%}{%- endcapture -%}
{%- assign row_keys = row_keys_raw | strip | split: ',' -%}

{%- capture table_rows -%}
  {%- for row_key in row_keys -%}
    {%- capture cell_text -%}
      {%- render 'compare-cell', product: product, row_key: row_key, as_text: true -%}
    {%- endcapture -%}
    {%- assign cell_text = cell_text | strip -%}
    {%- if cell_text != blank -%}
      <tr class="product-spec-table__row">
        <th class="product-spec-table__label" scope="row">
          {%- render 'compare-row-label', row_key: row_key -%}
        </th>
        <td class="product-spec-table__value">{{ cell_text }}</td>
      </tr>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- assign has_rows = false -%}
{%- if table_rows contains '<tr' -%}
  {%- assign has_rows = true -%}
{%- endif -%}

{%- if has_rows -%}
  <section class="product-spec-table" id="product-specs" data-reveal>
    <div class="product-spec-table__head">
      <h2 class="product-spec-table__heading">{{ heading }}</h2>

      {%- if variance_note != blank -%}
        <details class="product-spec-table__note">
          <summary class="product-spec-table__note-summary">
            {{- 'sections.product_spec_table.variance_label' | t -}}
          </summary>
          <p class="product-spec-table__note-text">{{ variance_note | escape }}</p>
        </details>
      {%- endif -%}
    </div>

    <table class="product-spec-table__table">
      <caption class="visually-hidden">{{ product.title | escape }} — {{ heading }}</caption>
      <tbody>
        {{ table_rows }}
      </tbody>
    </table>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-spec-table {
    padding-block: 2rem 0;
  }
  .product-spec-table__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    margin-block-end: 0.75rem;
  }
  .product-spec-table__heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .product-spec-table__note {
    font-size: 0.85rem;
  }
  .product-spec-table__note-summary {
    cursor: pointer;
    color: var(--color-brand);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .product-spec-table__note-text {
    margin: 0.35rem 0 0;
    max-width: 42ch;
    color: var(--color-foreground-muted);
    line-height: 1.55;
  }
  .product-spec-table__table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: calc(var(--style-border-radius-inputs) * 2.5);

    overflow: hidden;
    font-size: 0.9rem;
  }

  .product-spec-table__row:nth-child(odd) {
    background-color: color-mix(in srgb, var(--color-foreground) 4%, transparent);
  }
  .product-spec-table__label {
    width: 45%;
    padding: 0.9rem 1rem;
    text-align: start;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-foreground);
    vertical-align: top;
  }
  .product-spec-table__value {
    padding: 0.9rem 1rem;
    color: var(--color-foreground-muted);

    overflow-wrap: anywhere;
  }

  .product-spec-table__label,
  .product-spec-table__value {
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }
  .product-spec-table__row:last-child .product-spec-table__label,
  .product-spec-table__row:last-child .product-spec-table__value {
    border-block-end: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_spec_table.name",
  "tag": "div",
  "class": "product-spec-table-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.product_spec_table.default_heading"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_spec_table.name"
    }
  ]
}
{% endschema %}
