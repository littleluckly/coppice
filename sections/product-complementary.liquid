{% comment %}
  product-complementary — 互补整机推荐（task-product T-2.3/T-2.6，强制项 #14）。

  **为什么单独一个 section**（2026-10-28 二次拍板）：耗材区与互补区服务的是两种商品——
  主机有 `acc.consumables`，配件/电池没有。原先合成一个 section 用 if/else 二选一，
  结果是"同一块位置"承担两种语义，标题还得跟着换。拆开之后：
    · 本文件排在**概览之前**、紧跟买盒 —— 互补推荐是"买了这个还该买什么"，
      趁顾客还在看价格时摆出来才有用（Dawn 也把它放产品信息区）。
    · `product-supplies.liquid` 排在 Specifications **之后** —— 耗材是复购，
      顾客得先确认规格对得上自己的机器。
  两者**互斥**：有耗材 → 本文件整块不出；无耗材 → 本文件出、耗材区不出。

  **数据来源**：Search & Discovery 配的 complementary products，
  经 `/recommendations/products?intent=complementary` 取回（服务端首帧没有 `recommendations`
  对象，必须由 JS 拉，见 assets/product-recommendations.js）。

  空结果 → JS 把整块隐藏（含标题），不留空标题；失败也隐藏但会在控制台留 warn。
{% endcomment %}

{%- liquid
  assign consumables = product.metafields.acc.consumables.value
  assign supply_count = 0
  if consumables != null
    assign supply_count = consumables.size
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.product_complementary.default_heading' | t
  endif
  assign limit = section.settings.limit | default: 4
-%}

{%- if supply_count == 0 -%}
  <section class="product-complementary" id="product-pairs" data-section-id="{{ section.id }}">
    <script src="{{ 'product-recommendations.js' | asset_url }}" defer></script>
    <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
    <script src="{{ 'tilt-element.js' | asset_url }}" defer></script>
    {{ 'product-card.css' | asset_url | stylesheet_tag }}

    <product-recommendations
      data-intent="complementary"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent=complementary"
    >
      <div class="product-complementary__inner" data-recommendations-container>
        {%- if recommendations.performed and recommendations.products_count > 0 -%}
          <h2 class="product-complementary__heading">{{ heading }}</h2>
          <ul class="product-complementary__grid" role="list">
            {%- for item in recommendations.products limit: limit -%}
              <li>
                {% render 'product-card',
                  product: item,
                  lazy: true,
                  quick_add: true,
                  show_width: false,
                  show_cc: false,
                  show_power: false,
                  show_weight: false,
                  sizes: '(min-width: 1100px) 20vw, 45vw'
                %}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </product-recommendations>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-complementary {
    padding-block: 1.5rem 0;
  }
  .product-complementary__heading {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .product-complementary__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 750px) {
    .product-complementary__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .product-complementary__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_complementary.name",
  "tag": "div",
  "class": "product-complementary-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.product_complementary.default_heading"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "t:sections.product_complementary.limit",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_complementary.name"
    }
  ]
}
{% endschema %}
