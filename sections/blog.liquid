

{%- liquid
  assign per_page = section.settings.articles_per_page | default: 9
  assign show_excerpt = section.settings.show_excerpt
  assign show_reading_time = section.settings.show_reading_time
  assign show_card_tags = section.settings.show_card_tags
  assign show_newsletter = section.settings.show_newsletter
  assign cat_limit = section.settings.categories_limit | default: 6

  # H1 兜底：商家清空标题设置时回落博客名，每页始终恰好一个 h1
  assign hero_heading = section.settings.heading
  if hero_heading == blank
    assign hero_heading = blog.title
  endif

  # 分类计数只在「首页 + 总篇数 ≤ 50」时输出，理由见文件头第 3 条
  assign counts_visible = false
  if current_tags == blank and blog.articles_count > 0 and blog.articles_count <= 50
    assign counts_visible = true
  endif

  assign has_categories = false
  if blog.all_tags.size > 0 and cat_limit > 0
    assign has_categories = true
  endif

  assign has_sidebar = false
  if has_categories or show_newsletter
    assign has_sidebar = true
  endif

  # sizes 按实际列数：三列约 24vw（内容列 1100 时卡宽 356），两列 40vw，单列满宽
  assign card_sizes = '(min-width: 1080px) 24vw, (min-width: 560px) 40vw, 92vw'
-%}

<div class="blog-index__hero full-width{% if section.settings.image != blank %} blog-index__hero--image{% endif %}">
  {%- if section.settings.image != blank -%}

    <span class="blog-index__hero-media" style="--focal: {{ section.settings.image.presentation.focal_point | default: '50% 50%' }}">
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
      }}
    </span>
    <span class="blog-index__hero-scrim" aria-hidden="true"></span>
  {%- endif -%}

  <div class="blog-index__hero-inner">
    {%- if section.settings.eyebrow != blank -%}
      <p class="blog-index__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="blog-index__title">{{ hero_heading | escape }}</h1>

    {%- if section.settings.subheading != blank -%}
      <p class="blog-index__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}
  </div>
</div>

<div class="blog-index__page">
  <div class="blog-index__layout">
    {%- if has_sidebar -%}
      <aside class="blog-index__sidebar">
        {%- if has_categories -%}

          <nav class="blog-index__panel blog-index__panel--cats" aria-labelledby="blog-categories-title">
            <h2 class="blog-index__panel-title" id="blog-categories-title">
              {{- 'blog.list.categories' | t -}}
            </h2>
            <ul class="blog-index__cats" role="list">
              <li>
                <a
                  class="blog-index__cat{% if current_tags == blank %} is-active{% endif %}"
                  href="{{ blog.url }}"
                  {% if current_tags == blank %}aria-current="page"{% endif %}
                >
                  <span class="blog-index__cat-label">{{ 'blog.list.all_articles' | t }}</span>
                  {%- if counts_visible -%}
                    <span class="blog-index__cat-count">{{ blog.articles_count }}</span>
                  {%- endif -%}
                </a>
              </li>
              {%- for tag in blog.all_tags limit: cat_limit -%}
                {%- assign tag_count = 0 -%}
                {%- if counts_visible -%}

                  {%- for post in blog.articles -%}
                    {%- if post.tags contains tag -%}
                      {%- assign tag_count = tag_count | plus: 1 -%}
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
                <li>
                  <a
                    class="blog-index__cat{% if current_tags contains tag %} is-active{% endif %}"
                    href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                    {% if current_tags contains tag %}aria-current="page"{% endif %}
                  >
                    <span class="blog-index__cat-label">{{ tag }}</span>
                    {%- if counts_visible -%}
                      <span class="blog-index__cat-count">{{ tag_count }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}

        {%- if show_newsletter -%}

          <div class="blog-index__panel blog-index__newsletter">
            <h2 class="blog-index__panel-title">{{ 'blog.list.newsletter.title' | t }}</h2>
            <p class="blog-index__newsletter-text">{{ 'blog.list.newsletter.body' | t }}</p>

            {%- form 'customer', id: 'BlogNewsletterForm', class: 'blog-index__newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">

              <label class="visually-hidden" for="BlogNewsletterEmail">
                {{- 'blog.list.newsletter.label' | t -}}
              </label>
              <div class="blog-index__newsletter-field">
                <input
                  class="blog-index__newsletter-input"
                  id="BlogNewsletterEmail"
                  type="email"
                  name="contact[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  placeholder="{{ 'blog.list.newsletter.label' | t }}"
                  required
                  {% if form.errors %}
                    aria-invalid="true" aria-describedby="BlogNewsletterError"
                  {% endif %}
                >
                <button class="blog-index__newsletter-submit" type="submit">
                  <span class="visually-hidden">{{ 'blog.list.newsletter.submit' | t }}</span>
                  <svg aria-hidden="true" focusable="false" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
                </button>
              </div>

              {%- if form.errors -%}

                <p class="blog-index__newsletter-message blog-index__newsletter-message--error" id="BlogNewsletterError" role="alert">
                  {{- 'blog.list.newsletter.error' | t -}}
                </p>
              {%- elsif form.posted_successfully? -%}
                <p class="blog-index__newsletter-message" role="status">
                  {{- 'blog.list.newsletter.success' | t -}}
                </p>
              {%- endif -%}
            {%- endform -%}

            <span class="blog-index__newsletter-leaf" aria-hidden="true">
              {{- 'icon-leaf.svg' | inline_asset_content -}}
            </span>
          </div>
        {%- endif -%}
      </aside>
    {%- endif -%}

    <div class="blog-index__main">
      {%- paginate blog.articles by per_page -%}
        <div class="blog-index__toolbar">

          <p class="blog-index__result">
            {%- if current_tags != blank -%}
              <span class="blog-index__result-tag">{{ current_tags | join: ', ' }}</span>
            {%- endif -%}
            {{ 'blog.list.result_count' | t: count: paginate.items }}
          </p>
        </div>

        {%- if paginate.items > 0 -%}
          <ul class="blog-index__grid" role="list">
            {%- for article in blog.articles -%}
              {%- liquid
                assign chars = article.content | strip_html | size
                assign minutes = chars | divided_by: 1000.0 | ceil | at_least: 1
                # 入场延迟封顶 360ms：9 张卡按 60ms 递增会排到 480ms，越往下越像卡住
                assign reveal_delay = forloop.index0 | times: 60 | at_most: 360
              -%}
              <li class="blog-index__item" data-reveal style="--reveal-delay: {{ reveal_delay }}ms">
                <a class="blog-index__card" href="{{ article.url }}">
                  <span class="blog-index__media">
                    {%- if article.image != blank -%}

                      {%- capture card_image -%}
                        {{
                          article.image
                          | image_url: width: 800
                          | image_tag:
                            widths: '320, 480, 640, 800',
                            sizes: card_sizes,
                            width: article.image.width,
                            height: article.image.height,
                            loading: 'lazy',
                            alt: ''
                        }}
                      {%- endcapture -%}
                      {%- unless card_image contains ' alt=' -%}
                        {%- assign card_image = card_image | replace: '<img ', '<img alt="" ' -%}
                      {%- endunless -%}
                      {{ card_image }}
                    {%- else -%}
                      <span class="blog-index__placeholder" aria-hidden="true">
                        {{- 'icon-leaf.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}

                    {%- if show_card_tags and article.tags.size > 0 -%}
                      <span class="blog-index__badge">{{ article.tags.first }}</span>
                    {%- endif -%}
                  </span>

                  <div class="blog-index__body">
                    <h2 class="blog-index__card-title">{{ article.title | escape }}</h2>

                    {%- if show_excerpt -%}
                      {%- if article.excerpt != blank -%}
                        <p class="blog-index__excerpt">
                          {{- article.excerpt | strip_html | truncatewords: 22 -}}
                        </p>
                      {%- elsif article.content != blank -%}
                        <p class="blog-index__excerpt">
                          {{- article.content | strip_html | truncatewords: 22 -}}
                        </p>
                      {%- endif -%}
                    {%- endif -%}

                    <div class="blog-index__card-footer">
                      <p class="blog-index__meta">
                        {% if show_reading_time and chars > 200 %}
                          <span class="blog-index__meta-read">
                            <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 1.8" /></svg>
                            {{ 'blog.reading_time' | t: count: minutes }}
                          </span>
                        {% endif %}
                        {{ article.published_at | time_tag: format: 'date' }}
                      </p>

                      <span class="blog-index__card-arrow" aria-hidden="true">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13M13 6l6 6-6 6" /></svg>
                      </span>
                    </div>
                  </div>
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- else -%}

          <div class="blog-index__empty">
            <p class="blog-index__empty-title">
              {%- if current_tags != blank -%}
                {{ 'blog.list.empty.tagged_title' | t }}
              {%- else -%}
                {{ 'blog.list.empty.title' | t }}
              {%- endif -%}
            </p>
            <p class="blog-index__empty-body">{{ 'blog.list.empty.body' | t }}</p>
            {%- if current_tags != blank -%}
              <a class="blog-index__empty-link" href="{{ blog.url }}">
                {{- 'blog.list.all_articles' | t -}}
              </a>
            {%- else -%}
              <a class="blog-index__empty-link" href="{{ routes.all_products_collection_url }}">
                {{- 'blog.list.empty.link' | t -}}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}

          <nav class="blog-index__pagination" aria-label="{{ 'blog.list.pagination_label' | t }}">
            {%- if paginate.previous -%}
              <a
                class="blog-index__pagination-nav"
                href="{{ paginate.previous.url }}"
                aria-label="{{ 'blog.list.pagination_previous' | t }}"
              >
                <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </a>
            {%- else -%}
              <span class="blog-index__pagination-nav" aria-disabled="true">
                <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
              </span>
            {%- endif -%}

            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a
                  class="blog-index__pagination-page"
                  href="{{ part.url }}"
                  aria-label="{{ 'blog.list.page_number' | t: number: part.title }}"
                >{{ part.title }}</a>
              {%- elsif part.title == paginate.current_page -%}
                <span class="blog-index__pagination-page" aria-current="page">{{ part.title }}</span>
              {%- else -%}
                <span class="blog-index__pagination-gap" aria-hidden="true">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}

            {%- if paginate.next -%}
              <a
                class="blog-index__pagination-nav"
                href="{{ paginate.next.url }}"
                aria-label="{{ 'blog.list.pagination_next' | t }}"
              >
                <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
              </a>
            {%- else -%}
              <span class="blog-index__pagination-nav" aria-disabled="true">
                <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
              </span>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% stylesheet %}

  .blog-index__hero {
    position: relative;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-background) 94%, var(--color-brand) 6%);
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);

    border-end-start-radius: 28px;
    border-end-end-radius: 28px;
  }

  .blog-index__hero--image {
    background-color: color-mix(in srgb, var(--color-foreground) 88%, var(--color-background));
  }
  .blog-index__hero-media {
    position: absolute;
    inset: 0;
    display: block;
  }
  .blog-index__hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;

    object-position: var(--focal, 50% 50%);
  }

  .blog-index__hero-scrim {
    position: absolute;
    inset: 0;
    display: block;
    background-image: linear-gradient(
      90deg,
      var(--color-background) 0%,
      var(--color-background) 28%,
      color-mix(in srgb, var(--color-background) 88%, transparent) 46%,
      color-mix(in srgb, var(--color-background) 44%, transparent) 66%,
      transparent 88%
    );
  }

  .blog-index__hero-inner {
    position: relative;
    z-index: 1;
    max-inline-size: var(--content-width);
    margin-inline: auto;
    padding-block: clamp(1.75rem, 4vw, 3.25rem);
    padding-block-end: clamp(1.75rem, 4vw, 3rem);
  }
  .blog-index__hero--image .blog-index__hero-inner {
    min-block-size: clamp(15rem, 30vw, 21rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .blog-index__eyebrow {
    margin: 0 0 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
  }
  .blog-index__title {
    margin: 0;
    max-inline-size: 22ch;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .blog-index__subheading {
    margin: 0.85rem 0 0;
    max-inline-size: 46ch;
    font-size: clamp(0.9rem, 1.1vw, 1rem);
    line-height: 1.55;
    color: var(--color-foreground-muted);
  }

  .blog-index__hero--image .blog-index__subheading {
    color: color-mix(in srgb, var(--color-foreground) 88%, transparent);
  }

  .blog-index__page {
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(3rem, 6vw, 5rem);
  }
  .blog-index__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
  }
  @media (min-width: 990px) {

    .blog-index__layout:has(> .blog-index__sidebar) {
      grid-template-columns: 16.5rem minmax(0, 1fr);
      gap: 2rem;

      align-items: start;
    }
  }

  .blog-index__sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-inline-size: 0;
  }
  @media (min-width: 990px) {
    .blog-index__sidebar {

      position: sticky;
      top: 4.75rem;
    }
  }

  .blog-index__panel {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 14px;
    background-color: var(--color-background);
  }
  .blog-index__panel-title {
    margin: 0 0 0.7rem;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .blog-index__cats {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .blog-index__cat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 40px;
    padding: 0.3rem 0.55rem;
    border-radius: 10px;

    border-inline-start: 3px solid transparent;
    color: color-mix(in srgb, var(--color-foreground) 88%, transparent);
    font-size: 0.9rem;
    line-height: 1.35;
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }
  .blog-index__cat-label {
    flex: 1;
    min-inline-size: 0;

    overflow-wrap: break-word;
  }
  .blog-index__cat-count {
    flex: 0 0 auto;
    font-size: 0.78rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .blog-index__cat:hover {
      background-color: color-mix(in srgb, var(--color-foreground) 5%, transparent);
    }
  }
  .blog-index__cat:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .blog-index__cat.is-active {
    background-color: color-mix(in srgb, var(--color-brand) 9%, transparent);
    border-inline-start-color: var(--color-brand);
    color: var(--color-brand-accent);
    font-weight: 600;
  }
  .blog-index__cat.is-active .blog-index__cat-count {
    color: var(--color-brand-accent);
  }

  .blog-index__newsletter {
    position: relative;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-background) 93%, var(--color-brand) 7%);
    border-color: color-mix(in srgb, var(--color-brand) 16%, transparent);
  }
  .blog-index__newsletter-text {
    margin: 0 0 0.8rem;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }
  .blog-index__newsletter-field {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.22rem 0.22rem 0.22rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: 999px;
    background-color: var(--color-background);
  }

  .blog-index__newsletter-field:focus-within {
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 18%, transparent);
  }
  .blog-index__newsletter-input {
    flex: 1;
    min-inline-size: 0;
    padding-block: 0.45rem;
    border: 0;
    background-color: transparent;
    color: inherit;
    font: inherit;
    font-size: 0.85rem;
  }
  .blog-index__newsletter-input:focus {
    outline: none;
  }
  .blog-index__newsletter-input::placeholder {
    color: var(--color-foreground-muted);
  }
  .blog-index__newsletter-submit {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: 34px;
    block-size: 34px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background-color: var(--color-brand);
    color: var(--color-background);
    cursor: pointer;
  }
  .blog-index__newsletter-submit:hover {
    background-color: var(--color-brand-accent);
  }
  .blog-index__newsletter-submit:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 2px;
  }
  .blog-index__newsletter-message {
    margin: 0.55rem 0 0;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-brand-accent);
  }
  .blog-index__newsletter-message--error {
    color: var(--color-sale);
  }

  .blog-index__newsletter-leaf {
    position: absolute;
    inset-block-end: -1.4rem;
    inset-inline-end: -1.2rem;
    display: block;
    inline-size: 6.5rem;
    block-size: 6.5rem;
    color: color-mix(in srgb, var(--color-brand) 12%, transparent);
    pointer-events: none;
  }
  .blog-index__newsletter-leaf svg {
    width: 100%;
    height: 100%;
  }

  .blog-index__toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-end: 0.9rem;
  }
  .blog-index__result {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground-muted);
  }
  .blog-index__result-tag {
    font-weight: 600;
    color: var(--color-brand-accent);
  }
  .blog-index__result-tag::after {
    content: '·';
    margin-inline: 0.4rem;
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  .blog-index__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 560px) {
    .blog-index__grid {

      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1080px) {
    .blog-index__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .blog-index__item {
    display: flex;
    min-inline-size: 0;
  }

  .blog-index__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background-color: var(--color-background);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 14px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;

    transition: border-color 0.2s ease, box-shadow 0.2s ease, translate 0.2s ease;
  }
  .blog-index__card:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .blog-index__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
  }
  .blog-index__media img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.23, 1, 0.32, 1);
  }
  .blog-index__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--color-brand) 55%, transparent);
  }
  .blog-index__placeholder svg {
    width: 34px;
    height: 34px;
  }

  .blog-index__badge {
    position: absolute;
    inset-block-start: 0.6rem;
    inset-inline-start: 0.6rem;
    max-inline-size: calc(100% - 1.2rem);
    padding: 0.16rem 0.6rem;
    border-radius: 999px;
    background-color: var(--color-background);
    color: var(--color-brand-accent);
    font-size: 0.7rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    box-shadow: 0 1px 3px rgb(0 0 0 / 18%);
  }

  .blog-index__body {
    display: flex;

    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
    min-inline-size: 0;
    padding: 0.85rem 0.95rem 1rem;
  }
  .blog-index__card-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.005em;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .blog-index__excerpt {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0;
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  .blog-index__card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-block-start: auto;
    padding-block-start: 0.55rem;
  }
  .blog-index__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
    font-size: 0.74rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground-muted);
  }
  .blog-index__meta-read {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding-inline-end: 0.6rem;
    margin-inline-end: 0.6rem;

    border-inline-end: 1px solid color-mix(in srgb, var(--color-foreground) 18%, transparent);
  }

  .blog-index__card-arrow {
    display: inline-grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: 32px;
    block-size: 32px;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: 999px;
    color: var(--color-brand-accent);
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .blog-index__card-arrow svg {
    transition: translate 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .blog-index__card:hover {
      border-color: color-mix(in srgb, var(--color-brand) 40%, transparent);
      box-shadow: var(--card-hover-shadow);
      translate: 0 var(--card-hover-lift);
    }
    .blog-index__card:hover .blog-index__media img {
      transform: scale(1.04);
    }
    .blog-index__card:hover .blog-index__card-title {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      text-decoration-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
    }
    .blog-index__card:hover .blog-index__card-arrow {
      background-color: var(--color-brand);
      border-color: transparent;
      color: var(--color-background);
    }
    .blog-index__card:hover .blog-index__card-arrow svg {
      translate: 2px 0;
    }
  }

  .blog-index__empty {
    display: grid;
    justify-items: center;
    gap: 0.4rem;
    padding: 3rem 1rem;
    text-align: center;
    border: 1px dashed color-mix(in srgb, var(--color-foreground) 20%, transparent);
    border-radius: 14px;
  }
  .blog-index__empty-title {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 500;
  }
  .blog-index__empty-body {
    margin: 0;
    max-inline-size: 42ch;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }
  .blog-index__empty-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block-start: 0.25rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-brand-accent);
    text-underline-offset: 4px;
  }

  .blog-index__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 2rem;
  }
  .blog-index__pagination-nav,
  .blog-index__pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: 999px;
    background-color: var(--color-background);
    color: inherit;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .blog-index__pagination a:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }
  .blog-index__pagination [aria-disabled='true'] {
    opacity: 0.35;
  }
  .blog-index__pagination [aria-current='page'] {
    border-color: transparent;
    background-color: var(--color-brand);
    color: var(--color-background);
  }
  .blog-index__pagination-gap {
    min-width: 24px;
    text-align: center;

    color: var(--color-foreground-muted);
  }

  @media (max-width: 749px) {

    .blog-index__hero--image .blog-index__hero-inner {
      justify-content: flex-end;

      min-block-size: 20rem;
    }
    .blog-index__hero--image .blog-index__hero-scrim {
      background-image: linear-gradient(
        0deg,
        var(--color-background) 0%,
        color-mix(in srgb, var(--color-background) 92%, transparent) 42%,
        color-mix(in srgb, var(--color-background) 52%, transparent) 70%,
        transparent 96%
      );
    }
    .blog-index__title {
      font-size: clamp(1.85rem, 8vw, 2.4rem);
    }
  }

  @media (max-width: 989px) {

    .blog-index__sidebar {
      display: contents;
    }
    .blog-index__panel--cats {
      order: 1;
      padding: 0;
      border: 0;
      border-radius: 0;
      background-color: transparent;
    }
    .blog-index__main {
      order: 2;
    }
    .blog-index__newsletter {
      order: 3;
    }
    .blog-index__panel--cats .blog-index__panel-title {
      margin-block-end: 0.5rem;
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--color-foreground-muted);
    }
    .blog-index__cats {
      flex-direction: row;

      overflow-x: auto;
      overscroll-behavior-x: contain;
      gap: 0.4rem;
      padding-block-end: 0.15rem;
      scrollbar-width: none;
    }
    .blog-index__cats::-webkit-scrollbar {
      display: none;
    }
    .blog-index__cats > li {
      flex: 0 0 auto;
    }
    .blog-index__cat {
      min-block-size: 38px;
      padding-inline: 0.8rem;
      border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
      border-radius: 999px;
      font-size: 0.84rem;
      background-color: var(--color-background);
      white-space: nowrap;
    }
    .blog-index__cat.is-active {
      border-color: transparent;
      background-color: var(--color-brand);
      color: var(--color-background);
    }
    .blog-index__cat.is-active .blog-index__cat-count {
      color: var(--color-background);
    }

    .blog-index__cat-count {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-index__card,
    .blog-index__media img,
    .blog-index__card-arrow,
    .blog-index__card-arrow svg,
    .blog-index__cat {
      transition: none;
    }
    .blog-index__card:hover {
      translate: none;
    }
    .blog-index__card:hover .blog-index__media img {
      transform: none;
    }
    .blog-index__card:hover .blog-index__card-arrow svg {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.blog",
  "tag": "section",
  "class": "blog-index-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.blog.labels.image",
      "info": "t:sections.blog.labels.image_info"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:labels.eyebrow",
      "default": "Our blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "info": "t:sections.blog.labels.heading_info"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "Field notes on choosing, running and maintaining outdoor power equipment."
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "label": "t:sections.blog.labels.articles_per_page",
      "info": "t:sections.blog.labels.articles_per_page_info",
      "default": 9
    },
    {
      "type": "range",
      "id": "categories_limit",
      "min": 3,
      "max": 10,
      "step": 1,
      "label": "t:sections.blog.labels.categories_limit",
      "info": "t:sections.blog.labels.categories_limit_info",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:sections.blog.labels.show_newsletter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "t:sections.blog.labels.show_excerpt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_reading_time",
      "label": "t:sections.blog.labels.show_reading_time",
      "info": "t:sections.blog.labels.show_reading_time_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_card_tags",
      "label": "t:sections.blog.labels.show_card_tags",
      "default": true
    }
  ]
}
{% endschema %}
