

<script src="{{ 'cart-drawer.js' | asset_url }}" defer></script>

<script src="{{ 'cart-items.js' | asset_url }}" defer></script>
{{ 'cart-line.css' | asset_url | stylesheet_tag }}

<cart-drawer
  class="cart-drawer"
  data-section-id="{{ section.id }}"
  data-cart-url="{{ routes.cart_url }}"
  data-root="{{ routes.root_url }}"
>

  <bottom-sheet>
  <dialog class="cart-drawer__dialog" scroll-lock aria-labelledby="CartDrawerTitle-{{ section.id }}">

    <div class="cart-drawer__grabber" aria-hidden="true"></div>
    <div class="cart-drawer__panel">
      <div class="cart-drawer__header">
        <h2 class="cart-drawer__title" id="CartDrawerTitle-{{ section.id }}" tabindex="-1">
          {{ 'cart.title' | t }}
          <span class="cart-drawer__count" data-cart-drawer-count>({{ cart.item_count }})</span>
        </h2>
        <button type="button" class="cart-drawer__close" data-cart-drawer-close>
          {{ 'icon-close.svg' | inline_asset_content }}
          <span class="visually-hidden">{{ 'cart.close' | t }}</span>
        </button>
      </div>

      <cart-items
        data-cart-change-url="{{ routes.cart_change_url }}.js"
        data-cart-update-url="{{ routes.cart_update_url }}.js"
        data-cart-live-template="{{ 'cart.total_updated' | t: total: '[total]' }}"
        data-error-message="{{ 'products.product_card.add_error' | t }}"
      >
        <div class="cart-drawer__content" data-cart-section="{{ section.id }}">
          <div class="cart-drawer__body">
            {%- if cart.item_count == 0 -%}
              <div class="cart-drawer__empty">
                <p class="cart-drawer__empty-heading">{{ 'cart.empty_heading' | t }}</p>
                <p class="cart-drawer__empty-text">{{ 'cart.empty_text' | t }}</p>

                <a class="btn-solid cart-drawer__empty-cta" href="{{ routes.all_products_collection_url }}">
                  {{- 'cart.continue_shopping' | t -}}
                </a>
              </div>
            {%- else -%}
              <ul class="cart-drawer__list" role="list">
                {%- for item in cart.items -%}
                  <li class="cart-drawer__item">{%- render 'cart-line', item: item -%}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          <div class="cart-drawer__skeleton" data-cart-skeleton aria-hidden="true">
            <div class="cart-drawer__skeleton-row">
              <span class="cart-drawer__skeleton-thumb"></span>
              <span class="cart-drawer__skeleton-lines">
                <span class="cart-drawer__skeleton-line"></span>
                <span class="cart-drawer__skeleton-line cart-drawer__skeleton-line--short"></span>
                <span class="cart-drawer__skeleton-line cart-drawer__skeleton-line--price"></span>
              </span>
            </div>
            <div class="cart-drawer__skeleton-row">
              <span class="cart-drawer__skeleton-thumb"></span>
              <span class="cart-drawer__skeleton-lines">
                <span class="cart-drawer__skeleton-line"></span>
                <span class="cart-drawer__skeleton-line cart-drawer__skeleton-line--short"></span>
              </span>
            </div>
          </div>

          {%- if cart.item_count > 0 -%}
            <div class="cart-drawer__footer">
              <div class="cart-drawer__subtotal">
                <span>{{ 'cart.subtotal' | t }}</span>
                <span data-cart-drawer-subtotal>{{ cart.items_subtotal_price | money }}</span>
              </div>
              <p class="cart-drawer__note">{{ 'cart.shipping_note' | t }}</p>
              <p class="visually-hidden" role="status" data-cart-live></p>

              <form action="{{ routes.cart_url }}" method="post" class="cart-drawer__actions">
                <button type="submit" name="checkout" class="btn-solid cart-drawer__checkout">
                  {{- 'cart.checkout' | t -}}
                </button>
              </form>
              <a class="btn-solid btn-solid--quiet cart-drawer__view" href="{{ routes.cart_url }}">
                {{- 'cart.view_cart' | t -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      </cart-items>
    </div>
  </dialog>
  </bottom-sheet>
</cart-drawer>

{% stylesheet %}
  cart-drawer {
    display: contents;
  }

  .cart-drawer cart-items {
    display: contents;
  }

  .cart-drawer__dialog {

    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    inset-inline-start: auto;
    inline-size: min(26rem, 100%);
    max-inline-size: 100%;

    block-size: 100dvh;
    max-block-size: 100dvh;

    overflow: hidden;
    margin: 0;
    padding: 0;
    border: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);

  }
  .cart-drawer__dialog::backdrop {
    background-color: rgb(0 0 0 / 40%);
  }

  @media (min-width: 990px) {
    .cart-drawer__dialog.is-entering {
      animation: cart-drawer-slide-in-end 0.28s ease-out;
    }
    .cart-drawer__dialog.is-close-anim {
      animation: cart-drawer-slide-out-end 0.22s ease-in forwards;
    }
    @keyframes cart-drawer-slide-in-end {
      from {
        transform: translateX(100%);
      }
      to {
        transform: translateX(0);
      }
    }
    @keyframes cart-drawer-slide-out-end {
      from {
        transform: translateX(0);
      }
      to {
        transform: translateX(100%);
      }
    }
  }

  .cart-drawer__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    block-size: 100%;
    min-block-size: 0;
  }

  .cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }
  .cart-drawer__title {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 0;
  }
  .cart-drawer__count {
    font-weight: 400;
    color: var(--color-foreground-muted);
  }
  .cart-drawer__close {
    inline-size: 44px;
    block-size: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    background: none;
    color: inherit;
    cursor: pointer;
    border-radius: 999px;
  }
  .cart-drawer__close:hover {
    background-color: color-mix(in srgb, var(--color-foreground) 6%, transparent);
  }
  .cart-drawer__close svg {
    inline-size: 24px;
    block-size: 24px;
  }

  .cart-drawer__content {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-block-size: 0;
    overflow: hidden;
  }
  .cart-drawer__body {
    min-block-size: 0;
    overflow-y: auto;

    overscroll-behavior: contain;
    padding-inline: 1.25rem;
  }
  .cart-drawer__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cart-drawer__item + .cart-drawer__item {
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .cart-drawer__footer {
    padding: 1rem 1.25rem calc(1rem + env(safe-area-inset-bottom, 0px));
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    display: grid;
    gap: 0.6rem;
  }
  .cart-drawer__subtotal {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .cart-drawer__note {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--color-foreground-muted);
  }
  .cart-drawer__actions {
    display: grid;
  }
  .cart-drawer__checkout,
  .cart-drawer__view {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 100%;
    text-decoration: none;
    font-weight: 500;
  }

  .cart-drawer__empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding-block: 2.5rem;
  }
  .cart-drawer__empty-heading {
    font-size: 1.125rem;
    font-weight: 500;
  }
  .cart-drawer__empty-text {
    color: var(--color-foreground-muted);
  }

  .cart-drawer__empty-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.625rem 1.5rem;
  }

  .cart-drawer__skeleton {
    display: none;
    align-self: start;

    padding: 1rem 1.25rem;
  }
  cart-drawer[data-cart-loading] .cart-drawer__skeleton {
    display: grid;
    gap: 1rem;
  }
  cart-drawer[data-cart-loading] .cart-drawer__body,
  cart-drawer[data-cart-loading] .cart-drawer__footer {
    display: none;
  }
  .cart-drawer__skeleton-row {
    display: grid;

    grid-template-columns: 80px minmax(0, 1fr);
    gap: 0.45rem 0.75rem;
    align-items: start;
  }
  .cart-drawer__skeleton-thumb {
    inline-size: 80px;
    block-size: 80px;
    border-radius: 8px;
    background-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  .cart-drawer__skeleton-lines {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding-block-start: 0.25rem;
  }
  .cart-drawer__skeleton-line {
    block-size: 0.75rem;
    border-radius: 999px;
    background-color: color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  .cart-drawer__skeleton-line--short {
    inline-size: 45%;
  }
  .cart-drawer__skeleton-line--price {
    inline-size: 30%;
  }

  cart-drawer[data-cart-loading] .cart-drawer__skeleton-thumb,
  cart-drawer[data-cart-loading] .cart-drawer__skeleton-line {
    animation: cart-drawer-skeleton-pulse 1.4s ease-in-out infinite;
  }
  @keyframes cart-drawer-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    cart-drawer[data-cart-loading] .cart-drawer__skeleton-thumb,
    cart-drawer[data-cart-loading] .cart-drawer__skeleton-line {
      animation: none;
    }
  }

  .cart-drawer__grabber {
    display: none;
  }

  @media (max-width: 989.98px) {
    .cart-drawer__dialog {
      inset-block: auto 0;
      inset-inline: 0;
      inline-size: 100vw;

      max-inline-size: 100vw;
      block-size: auto;
      max-block-size: 85vh;
      margin: 0;
      border-radius: 16px 16px 0 0;
    }
    .cart-drawer__dialog[open] {
      display: flex;
      flex-direction: column;

    }

    .cart-drawer__panel {
      flex: 1 1 auto;
      min-block-size: 0;
      block-size: auto;
    }

    .cart-drawer__grabber {
      display: block;
      flex-shrink: 0;
      position: relative;
      inline-size: 56px;
      block-size: 6px;

      margin: 1rem auto 0.5rem;
      border-radius: 999px;
      background-color: color-mix(in srgb, var(--color-foreground) 18%, transparent);

      touch-action: none;
      user-select: none;
    }

    .cart-drawer__grabber::after {
      content: '';
      position: absolute;
      inset: -16px -32px -32px;
    }

    .cart-drawer__header {
      touch-action: none;
      user-select: none;
    }
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:general.cart_drawer",
  "class": "cart-drawer-section",
  "settings": []
}
{% endschema %}
