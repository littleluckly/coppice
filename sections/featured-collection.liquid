{% comment %}
  Featured collection — 首页精选集合网格（task-index T-2.4，pages-ui §2）。
  视觉基准：效果图-首页 Featured Products——桌面 6 列横排白卡（规格横排行 + 划线价
  + 星级 + 收藏心 + Compare）。消费 snippets/product-card.liquid。空集合 → 不渲染。
  首行卡片图片 eager（LCP 候选），其余 lazy。
{% endcomment %}

{%- liquid
  assign card_collection = section.settings.collection
  assign limit = section.settings.products_to_show | default: 6
-%}

{%- if card_collection != blank and card_collection.products_count > 0 -%}
  {%- comment -%}
    桌面一行按「实际会渲染几张卡」均分，而不是写死 6 列：
    商家配的数量可能被集合商品数截断（配 8、集合只有 5 款 → 实际 5 张），
    早先 repeat(6, 1fr) 在配 4 时右边空两列、配 8 时第二行只占 1/3 宽。
    --featured-columns 由下面的 grid 消费；sizes 也跟着列数走，否则 image_tag
    仍按 6 列的 15vw 选图，卡片变宽后会拿到偏小的派生图。
    90/N 是从原 6 列 = 15vw 反推的（余量留给页边距与 gap）；
    平板 3 列 / 手机 2 列是响应式折行，值与原先一致。
    products_to_show 上限锁 6（2026-11-12 刘工拍板）：桌面是单行展示，
    N 越大单卡越窄 —— 实测 12 张时单卡 91.2px、卡内内容仅约 65px，
    价格三件套/规格胶囊/Compare/加购会挤爆。别再把 max 调回去。
  {%- endcomment -%}
  {%- liquid
    assign card_count = card_collection.products_count
    if card_count > limit
      assign card_count = limit
    endif
    assign card_vw = 90 | divided_by: card_count
  -%}
  {%- capture card_sizes -%}(min-width: 1100px) {{ card_vw }}vw, (min-width: 750px) 30vw, 45vw{%- endcapture -%}
  <script src="{{ 'wishlist-toggle.js' | asset_url }}" defer></script>
  <script src="{{ 'quick-add.js' | asset_url }}" defer></script>
  <script src="{{ 'tilt-element.js' | asset_url }}" defer></script>
  {{ 'product-card.css' | asset_url | stylesheet_tag }}
  <div class="featured-collection">
    <div class="featured-collection__header">
      <div class="featured-collection__heading-group">
        {%- if section.settings.heading != blank -%}
          <h2 class="featured-collection__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="featured-collection__subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.view_all_label != blank -%}
        <a class="featured-collection__view-all" href="{{ card_collection.url }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="featured-collection__grid"
      role="list"
      style="--featured-columns: {{ card_count }}"
    >
      {%- for product in card_collection.products limit: limit -%}
        <li class="featured-collection__item">
          {%- liquid
            assign card_lazy = true
            assign card_width = false
            assign card_cc = false
            assign card_power = false
            assign card_weight = false
            if forloop.index <= 6
              assign card_lazy = false
            endif
            if section.settings.show_spec_width
              assign card_width = true
            endif
            if section.settings.show_spec_cc
              assign card_cc = true
            endif
            if section.settings.show_spec_power
              assign card_power = true
            endif
            if section.settings.show_spec_weight
              assign card_weight = true
            endif
          -%}
          {% render 'product-card',
            product: product,
            lazy: card_lazy,
            quick_add: true,
            show_width: card_width,
            show_cc: card_cc,
            show_power: card_power,
            show_weight: card_weight,
            sizes: card_sizes
          %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .featured-collection__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }
  /* 同 platform-cards：标题与副标题同列，View All 不参与这一列的高度 */
  .featured-collection__heading-group {
    min-inline-size: 0;
  }
  .featured-collection__heading {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 500;
  }
  .featured-collection__view-all {
    color: var(--color-brand-accent);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    padding-block: 10px;
  }
  .featured-collection__view-all::after {
    content: '→';
    margin-inline-start: 0.3rem;
  }
  /* minmax(0, 1fr) 而非裸 1fr：列数随配置变化时，长标题/规格胶囊的 min-content
     会把轨道撑出视口（grid item 的 automatic minimum size 是横向溢出头号原因）。
     item 本身同样补 min-inline-size: 0，两处一起才截断 min-content 传导。 */
  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .featured-collection__item {
    min-inline-size: 0;
  }
  @media (min-width: 750px) {
    .featured-collection__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1100px) {
    .featured-collection__grid {
      /* 变量由 Liquid 按实际卡片数下发；fallback 6 覆盖编辑器刚拖入、尚未渲染 style 的瞬间 */
      grid-template-columns: repeat(var(--featured-columns, 6), minmax(0, 1fr));
      gap: 0.6rem;
    }
  }

  /* 商品卡与对比勾选样式已迁出至 assets/product-card.css（首页/集合页/搜索页共用，T-1.1） */
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.featured_collection.name",
  "tag": "section",
  "class": "featured-collection-section",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "t:labels.collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.featured_collection.defaults.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "t:sections.featured_collection.defaults.subheading"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "t:labels.products_to_show",
      "info": "t:sections.featured_collection.labels.products_to_show_info",
      "default": 6
    },
    {
      "type": "header",
      "content": "t:sections.featured_collection.headers.card_specs"
    },
    {
      "type": "checkbox",
      "id": "show_spec_width",
      "label": "t:sections.featured_collection.labels.show_spec_width",
      "info": "t:sections.featured_collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_cc",
      "label": "t:sections.featured_collection.labels.show_spec_cc",
      "info": "t:sections.featured_collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_power",
      "label": "t:sections.featured_collection.labels.show_spec_power",
      "info": "t:sections.featured_collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_weight",
      "label": "t:sections.featured_collection.labels.show_spec_weight",
      "info": "t:sections.featured_collection.labels.spec_info",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "t:sections.featured_collection.defaults.view_all_label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_collection.name"
    }
  ]
}
{% endschema %}
