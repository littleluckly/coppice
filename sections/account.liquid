{% comment %}
  Account entry — <shopify-account> platform component (#22) + Follow on Shop (#21).

  #22 is a hard Theme Store requirement: the component must be reachable on BOTH
  desktop and mobile. The `shop.customer_accounts_enabled` guard below is what makes
  it render at all — do not drop it when refactoring, or the component disappears.

  Customisation is deliberately limited to CSS variables and ::part(). Shopify controls
  this component's internals and may update it independently of the theme, so we never
  reach inside it (AGENTS.md §4: no Dawn/Horizon-derived code).
{% endcomment %}

{%- if shop.customer_accounts_enabled -%}
  <div class="account">
    <shopify-account
      class="account__component"
      menu="{{ section.settings.customer_account_menu }}"
    >
      {%- comment -%}
        Signed-out avatar slot: replace the default glyph with our own icon so it
        inherits currentColor and matches the rest of the header.
      {%- endcomment -%}
      <div slot="signed-out-avatar" class="account__avatar">
        {{ 'icon-account.svg' | inline_asset_content }}
      </div>
    </shopify-account>

    {%- comment -%}
      #21 Follow on Shop. `action: 'follow'` performs a follow side-effect after
      authentication but needs extra configuration, so v1.0 uses the default action
      (authentication only). Colours are the component's own — do not restyle it
      (AGENTS.md §5: "不改其品牌色").
    {%- endcomment -%}
    {%- if section.settings.show_follow_on_shop -%}
      <div class="account__follow">
        {{ shop | login_button }}
      </div>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  .account {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  /* Only CSS variables and ::part() — never restructure the component (see header note). */
  .account__component {
    --shopify-account-avatar-size: 1.75rem;
    --shopify-account-radius-base: var(--style-border-radius-inputs);
    --shopify-account-color-accent: var(--color-brand);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-font-body: var(--font-primary--family);
    --shopify-account-font-heading: var(--font-primary--family);
    /* Sheet opens below the header, not at the very top of the viewport */
    --shopify-account-dialog-position-top: 3.5rem;
  }

  /* 触摸目标 ≥ 44×44（AGENTS §8）：组件默认头像小于此，用伪元素扩到 44px 命中区 */
  .account__component::part(signed-out-avatar) {
    position: relative;
  }

  .account__component::part(signed-out-avatar)::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    width: 44px;
    height: 44px;
    /* 用逻辑轴的 translate，RTL 下同样居中（AGENTS §9 不写死 left/right） */
    transform: translate(-50%, -50%);
  }

  .account__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    /* 图标随前景色走，不硬编码色值（AGENTS §6） */
    color: var(--color-foreground);
  }

  .account__avatar svg {
    width: 100%;
    height: 100%;
  }

  /* Follow on Shop 按钮保持组件自带配色，只调间距 */
  .account__follow {
    display: flex;
    align-items: center;
  }

  /* 移动端抽屉内的账户入口由 main-nav 渲染（#22 要求移动端可见），
     此处仅保证桌面端排版；不重复输出组件。 */
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.account",
  "settings": [
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.follow_on_shop",
      "default": false
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
