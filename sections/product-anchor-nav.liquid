

<product-anchor-nav class="product-anchor-nav">
  <nav class="product-anchor-nav__nav" aria-label="{{ 'sections.product_anchor_nav.label' | t }}">
    <ul class="product-anchor-nav__list" role="list">
      <li>
        <a class="product-anchor-nav__link" href="#product-overview" data-anchor-link="product-overview">
          <span class="product-anchor-nav__label">{{ 'sections.product_anchor_nav.overview' | t }}</span>
          <span class="product-anchor-nav__mark" aria-hidden="true"></span>
        </a>
      </li>
      <li>
        <a class="product-anchor-nav__link" href="#product-specs" data-anchor-link="product-specs">
          <span class="product-anchor-nav__label">{{ 'sections.product_anchor_nav.specs' | t }}</span>
          <span class="product-anchor-nav__mark" aria-hidden="true"></span>
        </a>
      </li>
      <li>
        <a class="product-anchor-nav__link" href="#product-supplies" data-anchor-link="product-supplies">
          <span class="product-anchor-nav__label">{{ 'sections.product_anchor_nav.supplies' | t }}</span>
          <span class="product-anchor-nav__mark" aria-hidden="true"></span>
        </a>
      </li>
    </ul>
  </nav>
</product-anchor-nav>

<script src="{{ 'product-anchor-nav.js' | asset_url }}" defer></script>

{% stylesheet %}
  product-anchor-nav {
    position: fixed;
    inset-block-start: 50%;

    inset-inline-end: max(0.5rem, env(safe-area-inset-right, 0px));
    translate: 0 -50%;

    z-index: 15;

    display: none;
  }

  @media screen and (min-width: 990px) {
    product-anchor-nav[data-scrollable] {
      display: block;
    }
  }

  .product-anchor-nav__list {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .product-anchor-nav__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;

    inline-size: 24px;
    block-size: 44px;
  }

  .product-anchor-nav__mark {
    display: block;
    inline-size: 10px;
    block-size: 2px;
    border-radius: 1px;

    background-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    transition: inline-size 0.2s ease, background-color 0.2s ease;
  }

  .product-anchor-nav__link:hover .product-anchor-nav__mark,
  .product-anchor-nav__link:focus-visible .product-anchor-nav__mark {
    inline-size: 20px;
    background-color: var(--color-brand);
  }

  .product-anchor-nav__link[aria-current] .product-anchor-nav__mark {
    inline-size: 20px;
    background-color: var(--color-brand);
  }

  .product-anchor-nav__label {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: calc(100% + 0.5rem);
    translate: 0 -50%;
    white-space: nowrap;
    padding: 0.25rem 0.5rem;
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    color: var(--color-foreground);
    box-shadow: 0 2px 10px rgb(0 0 0 / 18%);
    font-size: 0.8rem;
    line-height: 1.3;

    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .product-anchor-nav__link:hover .product-anchor-nav__label,
  .product-anchor-nav__link:focus-visible .product-anchor-nav__label {
    opacity: 1;
  }

  html:has(product-anchor-nav) {
    scroll-padding-top: calc(var(--anchor-nav-offset, 5rem) + 0.5rem);
  }

  @media screen and (min-width: 990px) and (prefers-reduced-motion: no-preference) {
    html:has(product-anchor-nav[data-scrollable]) {
      scroll-behavior: smooth;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-anchor-nav__mark,
    .product-anchor-nav__label {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_anchor_nav.name",
  "tag": "div",
  "class": "product-anchor-nav-section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [],
  "presets": [
    {
      "name": "t:sections.product_anchor_nav.name"
    }
  ]
}
{% endschema %}
