{% comment %}
  product-anchor-nav — 二级锚点条（task-product T-1.2，拍板 4）。

  取代效果图的四个 tab：规格不被折叠（SEO 与可索引正文都受益）、无 JS 也是原生
  `<a href="#…">`、不会出现"两个空 tab"（What's Included / Reviews 都没数据源）。

  **落点是语义 id**（`#product-overview` / `#product-specs` / `#product-supplies`），
  不用 section.id —— 商家换模板顺序、删某个 section，锚点不该跟着失效。
  对应 section 缺失时由 product-anchor-nav.js 把该项隐藏，不留死链。

  页头在基线里不是 sticky（main-nav 无 position:sticky），所以这条可以老实 `top: 0`；
  若将来页头改 sticky，改 `--product-anchor-offset` 一处即可。
{% endcomment %}

<product-anchor-nav class="product-anchor-nav" data-offset="0">
  <nav class="product-anchor-nav__nav" aria-label="{{ 'sections.product_anchor_nav.label' | t }}">
    <ul class="product-anchor-nav__list" role="list">
      <li class="product-anchor-nav__item">
        <a class="product-anchor-nav__link" href="#product-overview" data-anchor="product-overview">
          {{- 'sections.product_anchor_nav.overview' | t -}}
        </a>
      </li>
      <li class="product-anchor-nav__item">
        <a class="product-anchor-nav__link" href="#product-specs" data-anchor="product-specs">
          {{- 'sections.product_anchor_nav.specs' | t -}}
        </a>
      </li>
      <li class="product-anchor-nav__item">
        <a class="product-anchor-nav__link" href="#product-supplies" data-anchor="product-supplies">
          {{- 'sections.product_anchor_nav.supplies' | t -}}
        </a>
      </li>
    </ul>
  </nav>
</product-anchor-nav>

<script src="{{ 'product-anchor-nav.js' | asset_url }}" defer></script>

{% stylesheet %}
  .product-anchor-nav {
    position: sticky;
    top: var(--product-anchor-offset, 0);
    z-index: 2;
    display: block;
    background-color: var(--color-background);
    border-block: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  .product-anchor-nav__nav {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
  }
  .product-anchor-nav__list {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .product-anchor-nav__list::-webkit-scrollbar {
    display: none;
  }
  .product-anchor-nav__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-block: 0.5rem;
    color: var(--color-foreground-muted);
    font-size: 0.88rem;
    text-decoration: none;
    white-space: nowrap;
    border-block-end: 2px solid transparent;
  }
  .product-anchor-nav__link:hover {
    color: var(--color-foreground);
  }
  .product-anchor-nav__link[aria-current='true'] {
    color: var(--color-brand);
    border-block-end-color: var(--color-brand);
    font-weight: 500;
  }

  /* 锚点落点让开吸顶条的高度，否则标题被盖住 */
  #product-overview,
  #product-specs,
  #product-supplies,
  #product-similar {
    scroll-margin-block-start: 4rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_anchor_nav.name",
  "tag": "div",
  "class": "product-anchor-nav-section",
  "settings": [],
  "presets": [
    {
      "name": "t:sections.product_anchor_nav.name"
    }
  ]
}
{% endschema %}
