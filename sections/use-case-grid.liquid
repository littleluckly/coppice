

{%- if section.blocks.size > 0 -%}
  <div class="use-case-grid">
    {%- if section.settings.heading != blank -%}
      <h2 class="use-case-grid__heading" data-reveal>{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="use-case-grid__subheading" data-reveal>{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    <ul class="use-case-grid__grid" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign block_link = ''
          if block.settings.collection != blank
            assign block_link = block.settings.collection.url
          endif
        -%}
        <li
          class="use-case-grid__item{% if block.settings.image == blank %} use-case-grid__item--no-image{% endif %}"
          data-reveal
          style="--reveal-delay: {{ forloop.index0 | times: 80 }}ms"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <div class="use-case-grid__media">
              {{
                block.settings.image
                | image_url: width: 1200
                | image_tag:
                  widths: '600, 900, 1200',
                  sizes: '(min-width: 750px) 42vw, 90vw',
                  width: block.settings.image.width,
                  height: block.settings.image.height,
                  loading: 'lazy',
                  alt: block.settings.heading
              }}
            </div>
          {%- endif -%}

          <div class="use-case-grid__panel">
            <div class="use-case-grid__body">
              {%- if block.settings.heading != blank -%}
                <h3 class="use-case-grid__item-heading">{{ block.settings.heading | escape }}</h3>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="use-case-grid__reveal">
                  <div class="use-case-grid__reveal-inner">
                    <p class="use-case-grid__text">{{ block.settings.text | escape }}</p>
                  </div>
                </div>
              {%- endif -%}

              {%- if block_link != blank and block.settings.button_label != blank -%}
                <a class="btn-solid use-case-grid__link" href="{{ block_link }}">
                  {{ block.settings.button_label | escape }}
                </a>
              {%- endif -%}
            </div>
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}

  .use-case-grid__heading {
    font-size: 1.25rem;
    font-weight: 500;
    margin: 0;
  }

  .use-case-grid__grid {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(min(26rem, 100%), 1fr));
    gap: 0.75rem;
    list-style: none;
    padding: 0;

    margin: 0.75rem 0 0;
  }
  .use-case-grid__item {
    display: grid;
    grid-template-columns: 70% 30%;
    min-inline-size: 0;

    min-block-size: 13.5rem;
    border-radius: 12px;
    overflow: hidden;

    transition:
      grid-template-columns 0.5s cubic-bezier(0.22, 1, 0.36, 1),

      translate 0.2s ease,
      box-shadow 0.2s ease;
  }

  .use-case-grid__media,
  .use-case-grid__panel {
    min-inline-size: 0;
  }
  .use-case-grid__media {
    position: relative;
    min-block-size: 0;
    overflow: hidden;
  }

  .use-case-grid__media img {
    position: absolute;
    inset: 0;
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;
  }
  .use-case-grid__panel {
    display: flex;
    align-items: center;
    padding: 1rem 1.25rem;

    background-color: color-mix(in srgb, var(--color-background) 92%, var(--color-brand) 8%);
  }
  .use-case-grid__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    inline-size: 100%;
    min-inline-size: 0;
  }

  .use-case-grid__item-heading {
    margin: 0;
    font-size: clamp(0.95rem, 1.15vw, 1.125rem);
    font-weight: 500;
    line-height: 1.3;
    text-wrap: balance;
  }

  .use-case-grid__reveal {
    display: grid;
    grid-template-rows: 0fr;
    inline-size: 100%;
    opacity: 0;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.3s ease;
  }
  .use-case-grid__reveal-inner {
    min-block-size: 0;
    overflow: hidden;
  }
  .use-case-grid__text {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  .use-case-grid__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    max-inline-size: 100%;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
  }

  .use-case-grid .use-case-grid__link {
    border-radius: 1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .use-case-grid__item:hover {
      grid-template-columns: 50% 50%;
      translate: 0 var(--card-hover-lift);
      box-shadow: var(--card-hover-shadow);
    }
    .use-case-grid__item:hover .use-case-grid__reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
  .use-case-grid__item:focus-within {
    grid-template-columns: 50% 50%;
    translate: 0 var(--card-hover-lift);
    box-shadow: var(--card-hover-shadow);
  }
  .use-case-grid__item:focus-within .use-case-grid__reveal {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  @media (hover: none), (max-width: 749px) {
    .use-case-grid__item {
      grid-template-columns: 55% 45%;
    }
    .use-case-grid__reveal {
      grid-template-rows: 1fr;
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .use-case-grid__item,
    .use-case-grid__reveal {
      transition: none;
    }

    .use-case-grid__item:hover,
    .use-case-grid__item:focus-within {
      translate: none;
    }
  }

  .use-case-grid__item--no-image,
  .use-case-grid__item--no-image:hover,
  .use-case-grid__item--no-image:focus-within {
    grid-template-columns: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.use_case_grid.name",
  "tag": "section",
  "class": "use-case-grid-section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.use_case_grid.defaults.heading"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:labels.subheading",
      "default": "t:sections.use_case_grid.defaults.subheading"
    }
  ],
  "blocks": [
    {
      "type": "use_case",
      "name": "t:sections.use_case_grid.blocks.use_case.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading",
          "default": "t:sections.use_case_grid.blocks.use_case.defaults.heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.description",
          "default": "t:sections.use_case_grid.blocks.use_case.defaults.text"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection",
          "info": "t:sections.use_case_grid.blocks.use_case.labels.collection_info"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:labels.button_label",
          "info": "t:sections.use_case_grid.blocks.use_case.labels.button_info",
          "default": "t:sections.use_case_grid.blocks.use_case.defaults.button_label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.use_case_grid.name",
      "blocks": [
        {
          "type": "use_case",
          "settings": {
            "heading": "t:sections.use_case_grid.presets.case_1.heading",
            "text": "t:sections.use_case_grid.presets.case_1.text",
            "button_label": "t:sections.use_case_grid.presets.case_1.button_label"
          }
        },
        {
          "type": "use_case",
          "settings": {
            "heading": "t:sections.use_case_grid.presets.case_2.heading",
            "text": "t:sections.use_case_grid.presets.case_2.text",
            "button_label": "t:sections.use_case_grid.presets.case_2.button_label"
          }
        }
      ]
    }
  ]
}
{% endschema %}
