

{%- liquid
  # ── 预扫描：哪些区域真的有内容（决定外层容器是否出现）──
  assign has_brand_block = false
  assign has_newsletter = false
  assign column_count = 0
  assign social_count = 0

  for block in section.blocks
    case block.type
      when 'brand'
        assign has_brand_block = true
      when 'menu'
        if block.settings.menu.links.size > 0
          assign column_count = column_count | plus: 1
        endif
      when 'text'
        if block.settings.heading != blank or block.settings.richtext != blank
          assign column_count = column_count | plus: 1
        endif
      when 'contact'
        if block.settings.heading != blank or block.settings.phone != blank or block.settings.email != blank
          assign column_count = column_count | plus: 1
        elsif block.settings.page.title != blank
          assign column_count = column_count | plus: 1
        endif
      when 'custom_liquid'
        if block.settings.custom_liquid != blank
          assign column_count = column_count | plus: 1
        endif
      when 'social'
        if block.settings.url != blank
          assign social_count = social_count | plus: 1
        endif
      when 'newsletter'
        assign has_newsletter = true
    endcase
  endfor

  assign has_brand_zone = false
  if has_brand_block or has_newsletter
    assign has_brand_zone = true
  endif

  assign has_columns = false
  if column_count > 0
    assign has_columns = true
  endif

  # ── 支付图标（F-3）：来源只能是 enabled_payment_types，且必须全彩 ──
  assign show_payment = false
  if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0
    assign show_payment = true
  endif

  assign has_aside = false
  if social_count > 0 or show_payment
    assign has_aside = true
  endif

  # ── 选择器条件（F-6：多于一个才输出，是官方规则不是优化）──
  assign show_country = false
  if localization.available_countries.size > 1
    assign show_country = true
  endif
  assign show_language = false
  if localization.available_languages.size > 1
    assign show_language = true
  endif

  assign has_localization = false
  for block in section.blocks
    if block.type == 'localization'
      if show_country or show_language
        assign has_localization = true
      endif
    endif
  endfor

  # ── 左侧景观图（主题包不带照片，演示店在编辑器里上传）──
  assign has_media = false
  if section.settings.background_image != blank
    assign has_media = true
  endif
-%}

<footer class="site-footer full-width{% if has_media %} site-footer--with-media{% endif %}">
  {%- if has_media -%}

    <div class="footer__media" aria-hidden="true">
      {{
        section.settings.background_image
        | image_url: width: 2400
        | image_tag:
          widths: '600, 900, 1200, 1600, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          alt: '',
          class: 'footer__media-image'
      }}
    </div>
  {%- endif -%}

  <div class="footer__inner">
    <div class="footer__main">

      {%- if has_brand_zone -%}
        <div class="footer__brand-col">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'brand' -%}
                <div class="footer__brand" {{ block.shopify_attributes }}>
                  <a class="footer__wordmark" href="{{ routes.root_url }}">

                    {%- if block.settings.logo != blank -%}
                      {{
                        block.settings.logo
                        | image_url: width: 600
                        | image_tag:
                          widths: '120, 180, 240, 360, 480, 600',
                          sizes: '(min-width: 750px) 220px, 160px',
                          alt: shop.name,
                          loading: 'lazy',
                          class: 'footer__logo'
                      }}
                    {%- else -%}
                      {{ shop.name | escape }}
                    {%- endif -%}
                  </a>
                  {%- if block.settings.tagline != blank -%}
                    <p class="footer__tagline">{{ block.settings.tagline | escape }}</p>
                  {%- endif -%}
                  {%- if block.settings.description != blank -%}
                    <div class="rte footer__brand-text">{{ block.settings.description }}</div>
                  {%- endif -%}
                </div>

              {%- when 'newsletter' -%}
                {%- assign email_id = 'FooterEmail-' | append: block.id -%}
                {%- assign error_id = 'FooterEmailError-' | append: block.id -%}
                <div class="footer__newsletter" {{ block.shopify_attributes }}>
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer__newsletter-heading">{{ block.settings.heading | escape }}</h2>
                  {%- endif -%}

                  {%- form 'customer', class: 'footer__newsletter-form' -%}

                    <input type="hidden" name="contact[tags]" value="newsletter">

                    <label class="visually-hidden" for="{{ email_id }}">
                      {{- 'sections.footer.newsletter.label' | t -}}
                    </label>
                    <div class="footer__newsletter-field">
                      <div class="footer__newsletter-wrap">
                        <span class="footer__newsletter-icon" aria-hidden="true">
                          {{- 'icon-mail.svg' | inline_asset_content -}}
                        </span>
                        <input
                          class="footer__newsletter-input"
                          id="{{ email_id }}"
                          type="email"
                          name="contact[email]"
                          value="{{ form.email }}"
                          autocomplete="email"
                          placeholder="{{ 'sections.footer.newsletter.label' | t }}"
                          required
                          {% if form.errors %}
                            aria-invalid="true" aria-describedby="{{ error_id }}"
                          {% endif %}
                        >
                      </div>
                      <button class="btn-solid footer__newsletter-submit" type="submit">
                        {{- 'sections.footer.newsletter.submit' | t -}}
                      </button>
                    </div>

                    {%- if form.errors -%}

                      <p class="footer__newsletter-message footer__newsletter-message--error" id="{{ error_id }}" role="alert">
                        {{- 'sections.footer.newsletter.error' | t -}}
                      </p>
                    {%- elsif form.posted_successfully? -%}
                      <p class="footer__newsletter-message footer__newsletter-message--success" role="status">
                        {{- 'sections.footer.newsletter.success' | t -}}
                      </p>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <p class="footer__newsletter-text">
                        <span class="footer__newsletter-leaf" aria-hidden="true">
                          {{- 'icon-leaf.svg' | inline_asset_content -}}
                        </span>
                        <span>{{ block.settings.text | escape }}</span>
                      </p>
                    {%- endif -%}

                    <p class="footer__newsletter-consent">
                      {{- 'sections.footer.newsletter.consent' | t -}}
                    </p>
                  {%- endform -%}
                </div>

            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_columns -%}
        <div class="footer__columns{% if has_brand_zone %} footer__columns--divided{% endif %}">
          {%- for block in section.blocks -%}
            {%- case block.type -%}

              {%- when 'menu' -%}
                {%- assign menu = block.settings.menu -%}
                {%- if menu.links.size > 0 -%}

                  <div class="footer__menu" {{ block.shopify_attributes }}>
                    {%- for link in menu.links -%}
                      {%- if link.links.size > 0 -%}
                        {%- assign column_id = 'FooterColumn-' | append: block.id | append: '-' | append: forloop.index -%}
                        <nav class="footer__column" aria-labelledby="{{ column_id }}">
                          <h2 class="footer__column-title" id="{{ column_id }}">{{ link.title | escape }}</h2>
                          <ul class="footer__links" role="list">

                            {%- for child in link.links limit: 8 -%}
                              <li class="footer__link-item">
                                <a
                                  class="footer__link"
                                  href="{{ child.url }}"
                                  {% if child.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- child.title | escape -}}
                                </a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        </nav>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- liquid
                      assign plain_count = 0
                      for link in menu.links
                        if link.links.size == 0
                          assign plain_count = plain_count | plus: 1
                        endif
                      endfor
                    -%}
                    {%- if plain_count > 0 -%}
                      {%- assign flat_id = 'FooterFlat-' | append: block.id -%}

                      {%- assign flat_has_heading = false -%}
                      {%- if block.settings.heading != blank -%}
                        {%- assign flat_has_heading = true -%}
                      {%- endif -%}
                      <nav
                        class="footer__column"
                        {% if flat_has_heading %}
                          aria-labelledby="{{ flat_id }}"
                        {% else %}
                          aria-label="{{ 'sections.footer.menu_label' | t }}"
                        {% endif %}
                      >
                        {%- if flat_has_heading -%}
                          <h2 class="footer__column-title" id="{{ flat_id }}">
                            {{- block.settings.heading | escape -}}
                          </h2>
                        {%- endif -%}
                        <ul class="footer__links" role="list">
                          {%- assign flat_rendered = 0 -%}
                          {%- for link in menu.links -%}
                            {%- if link.links.size == 0 -%}
                              {%- if flat_rendered >= 8 -%}
                                {%- break -%}
                              {%- endif -%}
                              <li class="footer__link-item">
                                <a
                                  class="footer__link"
                                  href="{{ link.url }}"
                                  {% if link.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{- link.title | escape -}}
                                </a>
                              </li>
                              {%- assign flat_rendered = flat_rendered | plus: 1 -%}
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </nav>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank or block.settings.richtext != blank -%}
                  <div class="footer__text" {{ block.shopify_attributes }}>
                    {%- if block.settings.heading != blank -%}
                      <h2 class="footer__column-title">{{ block.settings.heading | escape }}</h2>
                    {%- endif -%}
                    {%- if block.settings.richtext != blank -%}

                      <div class="rte footer__rte">{{ block.settings.richtext }}</div>
                    {%- endif -%}
                  </div>
                {%- endif -%}

              {%- when 'contact' -%}
                {%- assign contact_phone = block.settings.phone -%}
                {%- assign contact_email = block.settings.email -%}
                {%- assign contact_page = block.settings.page -%}
                {%- assign contact_heading = block.settings.heading -%}
                {%- if contact_heading != blank or contact_phone != blank or contact_email != blank or contact_page.title != blank -%}
                  <div class="footer__contact" {{ block.shopify_attributes }}>
                    {%- if contact_heading != blank -%}
                      <h2 class="footer__column-title">{{ contact_heading | escape }}</h2>
                    {%- endif -%}
                    <ul class="footer__links" role="list">
                      {%- if contact_phone != blank -%}

                        {%- assign tel_href = contact_phone
                          | remove: ' '
                          | remove: '('
                          | remove: ')'
                          | remove: '-'
                          | remove: '.'
                        -%}
                        <li class="footer__link-item">
                          <a class="footer__link" href="tel:{{ tel_href | escape }}">{{ contact_phone | escape }}</a>
                        </li>
                      {%- endif -%}
                      {%- if contact_email != blank -%}
                        <li class="footer__link-item">
                          <a class="footer__link" href="mailto:{{ contact_email | escape }}">
                            {{- contact_email | escape -}}
                          </a>
                        </li>
                      {%- endif -%}
                      {%- if contact_page.title != blank -%}

                        <li class="footer__link-item">
                          <a class="footer__link" href="{{ contact_page.url }}">{{ contact_page.title | escape }}</a>
                        </li>
                      {%- endif -%}
                    </ul>
                  </div>
                {%- endif -%}

              {%- when 'custom_liquid' -%}
                {%- if block.settings.custom_liquid != blank -%}

                  <div class="footer__custom" {{ block.shopify_attributes }}>{{ block.settings.custom_liquid }}</div>
                {%- endif -%}

            {%- endcase -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if has_aside -%}
        <div class="footer__aside{% if has_brand_zone or has_columns %} footer__aside--divided{% endif %}">
          {%- if social_count > 0 -%}

            <div class="footer__social">
              <h2 class="footer__column-title">{{ 'sections.footer.follow_us' | t }}</h2>
              <ul class="footer__social-list" role="list">
                {%- for block in section.blocks -%}
                  {%- if block.type == 'social' and block.settings.url != blank -%}
                    {%- liquid
                      assign social_icon = blank
                      assign social_label = blank
                      case block.settings.platform
                        when 'facebook'
                          assign social_icon = 'icon-facebook.svg'
                          assign social_label = 'sections.footer.social.facebook' | t
                        when 'instagram'
                          assign social_icon = 'icon-instagram.svg'
                          assign social_label = 'sections.footer.social.instagram' | t
                        when 'youtube'
                          assign social_icon = 'icon-youtube.svg'
                          assign social_label = 'sections.footer.social.youtube' | t
                        when 'tiktok'
                          assign social_icon = 'icon-tiktok.svg'
                          assign social_label = 'sections.footer.social.tiktok' | t
                        when 'pinterest'
                          assign social_icon = 'icon-pinterest.svg'
                          assign social_label = 'sections.footer.social.pinterest' | t
                      endcase
                    -%}
                    {%- if social_icon != blank -%}
                      <li class="footer__social-item" {{ block.shopify_attributes }}>
                        <a
                          class="footer__social-link"
                          href="{{ block.settings.url }}"
                          target="_blank"
                          rel="noopener"
                          aria-label="{{ social_label }}"
                        >
                          {{- social_icon | inline_asset_content -}}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}

          {%- if show_payment -%}

            <ul class="footer__payment" role="list" aria-label="{{ 'sections.footer.payment' | t }}">
              {%- for type in shop.enabled_payment_types -%}
                <li class="footer__payment-item">
                  {{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">

        <span>
          &copy; {{ 'now' | date: '%Y' }}
          <a class="footer__copyright-link" href="{{ routes.root_url }}">{{ shop.name }}</a>. {{ 'sections.footer.rights' | t }}
        </span>
        <span class="footer__copyright-sep" aria-hidden="true">&middot;</span>

        {{ powered_by_link }}
      </p>

      {%- if has_localization -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'localization' -%}

              <locale-selector class="footer__localization" {{ block.shopify_attributes }}>
                {%- form 'localization', class: 'footer__localization-form' -%}
                  <div class="footer__localization-fields">
                    {%- if show_country -%}
                      <div class="footer__select">
                        <span class="footer__select-icon" aria-hidden="true">
                          {{- 'icon-globe.svg' | inline_asset_content -}}
                        </span>
                        <label class="visually-hidden" for="FooterCountry-{{ block.id }}">
                          {{- 'sections.footer.localization.country' | t -}}
                        </label>

                        <select
                          class="footer__select-input"
                          id="FooterCountry-{{ block.id }}"
                          name="country_code"
                        >
                          {%- for country in localization.available_countries -%}
                            <option
                              value="{{ country.iso_code }}"
                              {% if country.iso_code == localization.country.iso_code %}
                                selected
                              {% endif %}
                            >
                              {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="footer__select-chevron" aria-hidden="true">
                          {{- 'icon-chevron-down.svg' | inline_asset_content -}}
                        </span>
                      </div>
                    {%- endif -%}

                    {%- if show_language -%}
                      <div class="footer__select">
                        <span class="footer__select-icon" aria-hidden="true">
                          {{- 'icon-language.svg' | inline_asset_content -}}
                        </span>
                        <label class="visually-hidden" for="FooterLanguage-{{ block.id }}">
                          {{- 'sections.footer.localization.language' | t -}}
                        </label>
                        <select
                          class="footer__select-input"
                          id="FooterLanguage-{{ block.id }}"
                          name="language_code"
                        >
                          {%- for language in localization.available_languages -%}
                            <option
                              value="{{ language.iso_code }}"
                              lang="{{ language.iso_code }}"
                              hreflang="{{ language.iso_code }}"
                              {% if language.iso_code == localization.language.iso_code %}
                                selected
                              {% endif %}
                            >
                              {{ language.endonym_name | capitalize }}
                            </option>
                          {%- endfor -%}
                        </select>
                        <span class="footer__select-chevron" aria-hidden="true">
                          {{- 'icon-chevron-down.svg' | inline_asset_content -}}
                        </span>
                      </div>
                    {%- endif -%}

                    <button class="footer__localization-submit" type="submit">
                      {{- 'sections.footer.localization.update' | t -}}
                    </button>
                  </div>
                {%- endform -%}
              </locale-selector>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}

    </div>
  </div>
</footer>

<script src="{{ 'footer.js' | asset_url }}" defer></script>

{% stylesheet %}

  .site-footer {
    --footer-surface: color-mix(in srgb, var(--color-brand) 5%, var(--color-background));

    --footer-hairline: color-mix(in srgb, var(--color-foreground) 14%, transparent);

    position: relative;
    isolation: isolate;

    overflow: hidden;
    padding-block: clamp(2rem, 3.6vw, 3.25rem) 1.5rem;
    background-color: var(--footer-surface);
    color: var(--color-foreground);
  }

  .site-footer--with-media {
    padding-block-start: 0;
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
  }

  .footer__inner {
    position: relative;

    z-index: 1;
    padding-inline: calc((100% - var(--content-width)) / 2);
  }

  .footer__media {
    position: relative;

    inline-size: 100%;

    block-size: clamp(8rem, 16vw, 12rem);

    margin-block-end: clamp(1.5rem, 2.6vw, 2.25rem);
    pointer-events: none;
    overflow: hidden;
  }

  .footer__media-image {
    display: block;
    inline-size: 100%;
    block-size: 100%;
    object-fit: cover;

    object-position: center 45%;
  }

  .footer__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 42%,
      color-mix(in srgb, var(--footer-surface) 55%, transparent) 74%,
      var(--footer-surface) 100%
    );
  }

  .footer__main {
    display: flex;
    flex-wrap: wrap;

    align-items: stretch;
    gap: clamp(1.25rem, 1.8vw, 2rem);
  }

  .footer__brand-col {
    flex: 1 1 14rem;

    max-inline-size: 25rem;
    min-inline-size: 0;
  }

  .footer__columns {
    display: grid;

    grid-template-columns: repeat(auto-fit, minmax(8rem, max-content));
    justify-content: start;
    align-content: start;
    gap: clamp(1.5rem, 2.4vw, 2.25rem) clamp(1rem, 1.6vw, 1.75rem);
    flex: 1 1 auto;

    max-inline-size: 32rem;
    min-inline-size: 0;
  }

  .footer__aside {

    margin-inline-start: auto;
    flex: 0 0 auto;
    min-inline-size: 8.5rem;
  }

  .footer__columns--divided,
  .footer__aside--divided {
    border-inline-start: 1px solid var(--footer-hairline);
    padding-inline-start: clamp(1.25rem, 2vw, 2rem);
  }

  .footer__wordmark {
    display: inline-flex;
    align-items: center;
    font-size: clamp(1.375rem, 1.1rem + 0.9vw, 1.75rem);
    font-weight: 700;
    line-height: 1.1;

    letter-spacing: -0.02em;
    color: var(--color-brand);
  }

  .footer__logo {
    display: block;
    inline-size: auto;
    block-size: auto;

    max-inline-size: min(220px, 100%);
    max-block-size: 2.25rem;
    object-fit: contain;
    object-position: left center;
  }

  .footer__tagline {
    margin-block-start: 0.625rem;
    font-size: 1.0625rem;
    line-height: 1.35;

    color: color-mix(in srgb, var(--color-foreground) 92%, transparent);
  }

  .footer__brand-text {
    margin-block-start: 0.875rem;
    max-inline-size: 34ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .footer__brand-text > :first-child {
    margin-block-start: 0;
  }

  .footer__brand-text > :last-child {
    margin-block-end: 0;
  }

  .footer__newsletter {
    margin-block-start: 1.5rem;
  }

  .footer__newsletter-form {
    max-inline-size: 23rem;
  }

  .footer__newsletter-heading {
    margin-block-end: 0.5rem;
    font-size: 0.8125rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .footer__newsletter-field {
    display: flex;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
  }

  .footer__newsletter-wrap {
    position: relative;
    display: flex;

    flex: 1 1 auto;
    min-inline-size: 0;
  }

  .footer__newsletter-icon {
    position: absolute;
    inset-inline-start: 0.9375rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    display: flex;

    pointer-events: none;
    color: var(--color-foreground-muted);
  }

  .footer__newsletter-icon svg {
    inline-size: 0.9375rem;
    block-size: 0.9375rem;
  }

  .footer__newsletter-input {
    flex: 1 1 auto;
    min-inline-size: 0;
    min-block-size: 2.75rem;
    padding-block: 0.5rem;
    padding-inline: 2.5rem 0.875rem;
    background-color: var(--color-background);
    color: var(--color-foreground);
    border: 1px solid var(--footer-hairline);
    border-radius: 999px;
    font-size: 0.8125rem;
  }

  .footer__newsletter-input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .footer__newsletter-input::placeholder {
    color: var(--color-foreground-muted);
    opacity: 1;
  }

  .footer__newsletter-submit {
    flex: 0 0 auto;
    min-block-size: 2.75rem;
    padding-inline: 1.25rem;
    font-size: 0.8125rem;
    font-weight: 700;
    box-shadow: none;
  }

  .footer__newsletter-message--error {
    color: color-mix(in srgb, var(--color-sale) 70%, var(--color-foreground));
  }

  .footer__newsletter-input[aria-invalid='true'] {
    border-color: color-mix(in srgb, var(--color-sale) 70%, var(--color-foreground));
  }

  .footer__newsletter-message {
    margin-block-start: 0.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .footer__newsletter-message--success {
    color: var(--color-brand);
  }

  .footer__newsletter-text {
    display: flex;
    align-items: flex-start;
    gap: 0.375rem;
    margin-block-start: 0.75rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  .footer__newsletter-leaf {
    display: flex;
    flex: 0 0 auto;

    margin-block-start: 0.1875rem;
    color: var(--color-brand);
  }

  .footer__newsletter-leaf svg {
    inline-size: 0.75rem;
    block-size: 0.75rem;
  }

  .footer__newsletter-consent {
    margin-block-start: 0.375rem;
    font-size: 0.6875rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);
  }

  .footer__menu {
    display: contents;
  }

  .footer__column-title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;

    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .footer__links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__link {
    display: inline-flex;
    align-items: center;

    min-block-size: 1.5rem;
    padding-inline-end: 0.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-foreground-muted);

    overflow-wrap: anywhere;
    transition: color 0.15s ease;
  }

  @media (hover: hover) {
    .footer__link:hover,
    .footer__wordmark:hover,
    .footer__copyright-link:hover {
      color: var(--color-brand);
    }
  }

  @media (pointer: coarse) {
    .footer__link {
      min-block-size: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__link {
      transition: none;
    }
  }

  .footer__rte {
    font-size: 0.8125rem;
    line-height: 1.6;
    color: var(--color-foreground-muted);
  }

  .footer__text,
  .footer__contact,
  .footer__custom {
    max-inline-size: 22rem;
  }

  .footer__custom {
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .footer__social-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__social-link {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border: 1px solid var(--footer-hairline);

    border-radius: 0.625rem;
    color: var(--color-foreground);
    transition:
      color 0.15s ease,
      border-color 0.15s ease,
      background-color 0.15s ease;
  }

  .footer__social-link svg {
    inline-size: 1.0625rem;
    block-size: 1.0625rem;
  }

  @media (hover: hover) {
    .footer__social-link:hover {
      color: var(--color-brand);
      border-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
      background-color: color-mix(in srgb, var(--color-brand) 6%, transparent);
    }
  }

  @media (pointer: coarse) {
    .footer__social-link {
      inline-size: 2.75rem;
      block-size: 2.75rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__social-link {
      transition: none;
    }
  }

  .footer__payment {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .footer__payment-icon {
    display: block;

    block-size: 22px;
    inline-size: auto;
  }

  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    margin-block-start: clamp(1.75rem, 3.2vw, 2.75rem);
    padding-block-start: 1.25rem;
    border-block-start: 1px solid var(--footer-hairline);
  }

  .footer__copyright {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    font-size: 0.75rem;
    line-height: 1.6;

    color: var(--color-foreground-muted);
  }

  .footer__copyright-sep {

    margin-inline: 0;
  }

  .footer__localization {
    display: block;
  }

  .footer__localization-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 1rem;
  }

  .footer__select {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-foreground-muted);
  }

  .footer__select + .footer__select {
    margin-inline-start: 0.25rem;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid var(--footer-hairline);
  }

  .footer__select-icon {
    display: flex;
    flex: 0 0 auto;
  }

  .footer__select-icon svg {
    inline-size: 1rem;
    block-size: 1rem;
  }

  .footer__select-input {
    appearance: none;
    min-block-size: 2.75rem;
    padding: 0;
    padding-inline-end: 1.125rem;
    border: 0;
    background-color: transparent;
    color: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }

  .footer__select-input:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .footer__select-chevron {
    position: absolute;
    inset-inline-end: 0;
    display: flex;

    pointer-events: none;
    opacity: 0.7;
  }

  .footer__select-chevron svg {
    inline-size: 0.75rem;
    block-size: 0.75rem;
  }

  .footer__localization-submit {
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    background-color: transparent;
    color: var(--color-brand);
    font-size: 0.8125rem;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  locale-selector[data-enhanced] .footer__localization-submit {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .footer__brand-col {
      flex-basis: 100%;
      max-inline-size: 34rem;
    }

    .footer__columns,
    .footer__aside {
      flex-basis: 100%;
    }

    .footer__columns {
      max-inline-size: none;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }

    .footer__aside {
      min-inline-size: 0;
    }

    .footer__columns--divided,
    .footer__aside--divided {
      border-inline-start: 0;
      padding-inline-start: 0;
      border-block-start: 1px solid var(--footer-hairline);
      padding-block-start: clamp(1.25rem, 3vw, 1.75rem);
    }
  }

  @media screen and (max-width: 749px) {

    .footer__media {
      block-size: 9rem;
      margin-block-end: 1.5rem;
    }

    .footer__columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .footer__text,
    .footer__contact,
    .footer__custom {
      grid-column: 1 / -1;
    }

    .footer__newsletter-form,
    .footer__brand-text {
      max-inline-size: none;
    }

    .footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media screen and (max-width: 359px) {
    .footer__newsletter-field {
      flex-direction: column;
      align-items: stretch;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.footer.name",
  "class": "footer-section",
  "max_blocks": 20,
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.footer.labels.image",
      "info": "t:sections.footer.labels.image_info"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "t:sections.footer.blocks.brand.name",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "t:sections.footer.labels.logo",
          "info": "t:sections.footer.labels.logo_info"
        },
        {
          "type": "text",
          "id": "tagline",
          "label": "t:sections.footer.labels.tagline"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "t:labels.description"
        }
      ]
    },
    {
      "type": "menu",
      "name": "t:sections.footer.blocks.menu.name",
      "limit": 1,
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "t:sections.footer.labels.menu",
          "info": "t:sections.footer.labels.menu_info",
          "default": "footer"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:sections.footer.labels.menu_heading",
          "info": "t:sections.footer.labels.menu_heading_info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "limit": 2,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "richtext",
          "id": "richtext",
          "label": "t:sections.footer.labels.text"
        }
      ]
    },
    {
      "type": "contact",
      "name": "t:sections.footer.blocks.contact.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "t:sections.footer.labels.phone"
        },
        {
          "type": "text",
          "id": "email",
          "label": "t:sections.footer.labels.email"
        },
        {
          "type": "page",
          "id": "page",
          "label": "t:sections.footer.labels.contact_page"
        }
      ]
    },
    {
      "type": "social",
      "name": "t:sections.footer.blocks.social.name",
      "limit": 5,
      "settings": [
        {
          "type": "select",
          "id": "platform",
          "label": "t:sections.footer.labels.platform",
          "options": [
            { "value": "facebook", "label": "t:sections.footer.options.platform.facebook" },
            { "value": "instagram", "label": "t:sections.footer.options.platform.instagram" },
            { "value": "youtube", "label": "t:sections.footer.options.platform.youtube" },
            { "value": "tiktok", "label": "t:sections.footer.options.platform.tiktok" },
            { "value": "pinterest", "label": "t:sections.footer.options.platform.pinterest" }
          ],
          "default": "facebook"
        },
        {
          "type": "url",
          "id": "url",
          "label": "t:sections.footer.labels.social_url",
          "info": "t:sections.footer.labels.social_url_info"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "t:sections.footer.blocks.newsletter.name",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "t:labels.heading"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    },
    {
      "type": "localization",
      "name": "t:sections.footer.blocks.localization.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.footer.blocks.custom_liquid.name",
      "limit": 1,
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.footer.labels.custom_liquid",
          "info": "t:sections.footer.labels.custom_liquid_info"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:general.footer",
      "blocks": [
        { "type": "brand" },
        { "type": "menu" },
        { "type": "newsletter" },
        { "type": "localization" }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["footer"]
  }
}
{% endschema %}
