        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        }
      ]
    },
    {
      "type": "localization",
      "name": "t:sections.footer.blocks.localization.name",
      "limit": 1,
      "settings": []
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.footer.blocks.custom_liquid.name",
      "limit": 1,
      "settings": [
        {
          "type": "liquid",
