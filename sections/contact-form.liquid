      "info": "t:sections.contact_form.labels.banner_image_info"
    },
    {
      "type": "range",
      "id": "banner_overlay",
      "label": "t:sections.contact_form.labels.banner_overlay",
      "info": "t:sections.contact_form.labels.banner_overlay_info",
      "min": 40,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 78
    },
    {
      "type": "header",
      "content": "t:sections.contact_form.labels.intro_header"
    },
    {
      "type": "text",
      "id": "eyebrow",
