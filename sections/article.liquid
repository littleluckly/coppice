

{%- liquid
  assign chars = article.content | strip_html | size
  assign minutes = chars | divided_by: 1000.0 | ceil | at_least: 1

  assign show_cover = section.settings.show_cover
  assign show_tags = section.settings.show_tags
  assign show_more = section.settings.show_more_guides

  # 只有博客里还有别的文章时才可能出现侧栏；否则正文列居中
  assign has_aside = false
  if show_more and blog.articles_count > 1
    assign has_aside = true
  endif

  assign has_prev = false
  assign has_next = false
  if blog.previous_article != blank
    assign has_prev = true
  endif
  if blog.next_article != blank
    assign has_next = true
  endif
-%}

<article class="article{% unless has_aside %} article--narrow{% endunless %}">
  <div class="article__hero full-width">
    <div class="article__hero-inner">
      <a class="article__eyebrow" href="{{ blog.url }}">{{ blog.title | escape }}</a>

      <h1 class="article__title">{{ article.title | escape }}</h1>

      <p class="article__meta">
        {% if chars > 200 %}
          <span class="article__meta-read">
            <svg aria-hidden="true" focusable="false" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5V12l3 1.8" /></svg>
            {{ 'blog.reading_time' | t: count: minutes }}
          </span>
        {% endif %}
        {{ article.published_at | time_tag: format: 'date' }}
        {% if article.author != blank %}
          <span class="article__meta-author">{{ article.author | escape }}</span>
        {% endif %}
      </p>
    </div>
  </div>

  <div class="article__page">
    <div class="article__layout{% if has_aside %} article__layout--aside{% endif %}">
      <div class="article__body">
        {%- if show_cover and article.image != blank -%}

          {%- capture cover -%}
            {{
              article.image
              | image_url: width: 1600
              | image_tag:
                widths: '600, 900, 1200, 1600',
                sizes: '(min-width: 990px) 44.5rem, 92vw',
                width: article.image.width,
                height: article.image.height,
                loading: 'eager',
                fetchpriority: 'high',
                alt: ''
            }}
          {%- endcapture -%}
          {%- unless cover contains ' alt=' -%}
            {%- assign cover = cover | replace: '<img ', '<img alt="" ' -%}
          {%- endunless -%}
          <div class="article__cover">{{ cover }}</div>
        {%- endif -%}

        <div class="rte article__content">{{ article.content }}</div>

        {%- if show_tags and article.tags.size > 0 -%}
          <div class="article__tags">
            <h2 class="visually-hidden">{{ 'blog.article.tags_label' | t }}</h2>
            <ul class="article__tag-list" role="list">
              {%- for tag in article.tags -%}
                <li>
                  <a class="article__tag" href="{{ blog.url }}/tagged/{{ tag | handleize }}">
                    {{- tag -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if has_prev or has_next -%}

          <nav class="article__pager" aria-label="{{ 'blog.article.pager_label' | t }}">
            {%- if has_prev -%}
              <a class="article__pager-link article__pager-link--prev" href="{{ blog.previous_article.url }}">
                <span class="article__pager-label">
                  <span aria-hidden="true">←</span>
                  {{ 'blog.article.newer' | t }}
                </span>
                <span class="article__pager-title">{{ blog.previous_article.title | escape }}</span>
              </a>
            {%- endif -%}
            {%- if has_next -%}
              <a class="article__pager-link article__pager-link--next" href="{{ blog.next_article.url }}">
                <span class="article__pager-label">
                  {{ 'blog.article.older' | t }}
                  <span aria-hidden="true">→</span>
                </span>
                <span class="article__pager-title">{{ blog.next_article.title | escape }}</span>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}

        {%- if blog.comments_enabled? -%}
          <section class="article__comments" id="comments">
            <h2 class="article__comments-title">
              {{ 'blog.article_comments' | t }}
              {%- if article.comments_count > 0 -%}
                <span class="article__comments-count">
                  {{- 'blog.article.comments_count' | t: count: article.comments_count -}}
                </span>
              {%- endif -%}
            </h2>

            {%- paginate article.comments by 10 -%}
              {%- if article.comments_count > 0 -%}
                <ol class="article__comment-list" role="list">
                  {%- for comment in article.comments -%}
                    <li class="article__comment" id="comment-{{ comment.id }}">
                      <p class="article__comment-meta">
                        <span class="article__comment-author">{{ comment.author }}</span>
                        {{ comment.created_at | time_tag: format: 'date' }}
                      </p>
                      <div class="rte article__comment-body">{{ comment.content }}</div>
                    </li>
                  {%- endfor -%}
                </ol>

                {%- if paginate.pages > 1 -%}
                  <nav class="article__comments-pagination" aria-label="{{ 'blog.article.comments_pagination' | t }}">
                    {%- if paginate.previous -%}
                      <a class="article__comments-page" href="{{ paginate.previous.url }}#comments">
                        {{- 'blog.article.comments_previous' | t -}}
                      </a>
                    {%- endif -%}
                    {%- if paginate.next -%}
                      <a class="article__comments-page" href="{{ paginate.next.url }}#comments">
                        {{- 'blog.article.comments_next' | t -}}
                      </a>
                    {%- endif -%}
                  </nav>
                {%- endif -%}
              {%- endif -%}
            {%- endpaginate -%}

            {%- form 'new_comment', article, class: 'article__comment-form' -%}
              <h3 class="article__form-title">{{ 'blog.comment_form_title' | t }}</h3>

              {%- if form.errors -%}
                <div class="article__form-errors" role="alert">
                  {{ form.errors | default_errors }}
                </div>
              {%- endif -%}

              <div class="article__field">
                <label for="CommentAuthor">{{ 'blog.comment_form_name' | t }}</label>
                <input
                  id="CommentAuthor"
                  type="text"
                  name="comment[author]"
                  value="{{ form.author }}"
                  autocomplete="name"
                  required
                  {% if form.errors contains 'author' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>

              <div class="article__field">
                <label for="CommentEmail">{{ 'blog.comment_form_email' | t }}</label>
                <input
                  id="CommentEmail"
                  type="email"
                  name="comment[email]"
                  value="{{ form.email }}"
                  autocomplete="email"
                  required
                  {% if form.errors contains 'email' %}
                    aria-invalid="true"
                  {% endif %}
                >
              </div>

              <div class="article__field">
                <label for="CommentBody">{{ 'blog.comment_form_body' | t }}</label>
                <textarea id="CommentBody" name="comment[body]" rows="6" required>{{ form.body }}</textarea>
              </div>

              <button class="btn-solid article__form-submit" type="submit">
                {{- 'blog.comment_form_submit' | t -}}
              </button>
            {%- endform -%}
          </section>
        {%- endif -%}
      </div>

      {%- if has_aside -%}

        {%- capture more_items -%}
          {%- assign shown = 0 -%}
          {%- for post in blog.articles -%}
            {%- if post.id == article.id -%}{%- continue -%}{%- endif -%}
            {%- if shown >= 3 -%}{%- continue -%}{%- endif -%}
            <li class="article__more-item">
              <a class="article__more-link" href="{{ post.url }}">
                <span class="article__more-media">
                  {%- if post.image != blank -%}
                    {%- capture more_image -%}
                      {{ post.image | image_url: width: 240 | image_tag: widths: '160, 240', sizes: '5rem', loading: 'lazy', alt: '' }}
                    {%- endcapture -%}
                    {%- unless more_image contains ' alt=' -%}
                      {%- assign more_image = more_image | replace: '<img ', '<img alt="" ' -%}
                    {%- endunless -%}
                    {{ more_image }}
                  {%- else -%}
                    <span class="article__more-placeholder" aria-hidden="true">
                      {{- 'icon-leaf.svg' | inline_asset_content -}}
                    </span>
                  {%- endif -%}
                </span>
                <span class="article__more-body">
                  <span class="article__more-title">{{ post.title | escape }}</span>
                  <span class="article__more-date">{{ post.published_at | time_tag: format: 'date' }}</span>
                </span>
              </a>
            </li>
            {%- assign shown = shown | plus: 1 -%}
          {%- endfor -%}
        {%- endcapture -%}

        {%- assign more_trimmed = more_items | strip -%}
        {%- if more_trimmed != blank -%}

          <aside class="article__aside">
            <div class="article__panel">
              <h2 class="article__panel-title">{{ 'blog.article.more' | t }}</h2>
              <ul class="article__more-list" role="list">
                {{ more_items }}
              </ul>
            </div>
          </aside>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>
</article>

{% stylesheet %}

  .article__hero {
    background-color: color-mix(in srgb, var(--color-background) 94%, var(--color-brand) 6%);
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);
    border-end-start-radius: 28px;
    border-end-end-radius: 28px;
  }
  .article__hero-inner {
    max-inline-size: 61.5rem;
    margin-inline: auto;
    padding-block: clamp(1.75rem, 3.6vw, 2.75rem) clamp(1.5rem, 3vw, 2.25rem);
  }

  .article--narrow .article__hero-inner {
    max-inline-size: 42rem;
  }
  .article__eyebrow {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    margin-block-end: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
    text-decoration: none;
  }
  .article__eyebrow:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .article__eyebrow:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .article__title {
    margin: 0;
    max-inline-size: 30ch;
    font-size: clamp(1.9rem, 3.8vw, 3rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .article__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0.85rem 0 0;
    font-size: 0.82rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground-muted);
  }

  .article__meta > * + *::before {
    content: '';
    display: inline-block;
    inline-size: 1px;
    block-size: 0.95em;
    margin-inline: 0.65rem;
    background-color: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    vertical-align: -0.1em;
  }
  .article__meta-read {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  .article__page {
    padding-block: clamp(1.5rem, 3vw, 2.25rem) clamp(3rem, 6vw, 5rem);
  }
  .article__layout {
    max-inline-size: 61.5rem;
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }
  @media (min-width: 990px) {
    .article__layout--aside {
      grid-template-columns: minmax(0, 1fr) 16.5rem;
      gap: 3rem;

      align-items: start;
    }
  }
  .article__body {
    min-inline-size: 0;

    max-inline-size: 42rem;
    inline-size: 100%;
  }

  .article__layout:not(.article__layout--aside) .article__body {
    margin-inline: auto;
  }

  .article__cover {
    margin-block-end: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: 14px;
    overflow: hidden;
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
  }
  .article__cover img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .article__content {

    font-size: 1.1rem;
    line-height: 1.7;
  }

  .article__tags {
    margin-block-start: 2.25rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }
  .article__tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article__tag {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding-inline: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 14%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--color-foreground) 82%, transparent);
    font-size: 0.82rem;
    line-height: 1.2;
    text-decoration: none;
    transition: border-color 0.2s ease, color 0.2s ease;
  }
  @media (hover: hover) and (pointer: fine) {
    .article__tag:hover {
      border-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
      color: var(--color-brand-accent);
    }
  }
  .article__tag:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .article__pager {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    margin-block-start: 1.75rem;
  }
  @media (min-width: 560px) {
    .article__pager {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .article__pager-link {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-inline-size: 0;
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 14px;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease, translate 0.2s ease;
  }

  .article__pager-link:only-child {
    grid-column: 1 / -1;
  }
  @media (hover: hover) and (pointer: fine) {
    .article__pager-link:hover {
      border-color: color-mix(in srgb, var(--color-brand) 40%, transparent);
      box-shadow: var(--card-hover-shadow);
      translate: 0 var(--card-hover-lift);
    }
  }
  .article__pager-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .article__pager-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-accent);
  }
  .article__pager-title {
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .article__comments {
    margin-block-start: 3rem;
    padding-block-start: 2rem;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }
  .article__comments-title {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 1.25rem;
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .article__comments-count {
    font-size: 0.82rem;
    font-weight: 400;
    color: var(--color-foreground-muted);
  }

  .article__comment-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
  }
  .article__comment {
    padding: 0.9rem 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 14px;
    background-color: color-mix(in srgb, var(--color-background) 96%, var(--color-brand) 4%);
  }
  .article__comment-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    margin: 0 0 0.4rem;
    font-size: 0.76rem;
    line-height: 1.4;
    color: var(--color-foreground-muted);
  }
  .article__comment-author {
    font-weight: 600;
    color: var(--color-foreground);
  }
  .article__comment-author::after {
    content: '';
    display: inline-block;
    inline-size: 1px;
    block-size: 0.9em;
    margin-inline: 0.55rem;
    background-color: color-mix(in srgb, var(--color-foreground) 20%, transparent);
    vertical-align: -0.1em;
  }
  .article__comment-body {
    font-size: 0.95rem;
    line-height: 1.65;
  }
  .article__comments-pagination {
    display: flex;
    gap: 0.75rem;
    margin-block-end: 2rem;
  }
  .article__comments-page {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.85rem;
    color: var(--color-brand-accent);
    text-underline-offset: 4px;
  }

  .article__comment-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .article__form-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .article__field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .article__field label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-foreground-muted);
  }
  .article__field :is(input, textarea) {
    inline-size: 100%;
    padding: 0.6rem 0.8rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-background);
    color: inherit;
    font: inherit;
    font-size: 0.9rem;
    line-height: 1.5;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .article__field textarea {
    resize: vertical;
    min-block-size: 7rem;
  }

  .article__field :is(input, textarea):focus-visible {
    outline: none;
    border-color: var(--color-brand);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-brand) 18%, transparent);
  }
  .article__field :is(input, textarea)[aria-invalid='true'] {
    border-color: var(--color-sale);
  }
  .article__form-errors {
    padding: 0.7rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-sale) 45%, transparent);
    border-radius: var(--style-border-radius-inputs);
    background-color: var(--color-sale-surface);
    color: var(--color-sale);
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .article__form-errors ul {
    margin: 0;
    padding-inline-start: 1.1rem;
  }

  .article__form-submit {
    align-self: flex-start;
    padding-inline: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
  }

  @media (min-width: 990px) {
    .article__aside {
      position: sticky;

      top: 4.75rem;
    }
  }
  .article__panel {
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
    border-radius: 14px;
    background-color: var(--color-background);
  }
  .article__panel-title {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-foreground-muted);
  }
  .article__more-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .article__more-link {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.6rem;
    align-items: start;
    color: inherit;
    text-decoration: none;
  }
  .article__more-media {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 8px;
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
  }

  .article__more-media img,
  .article__more-placeholder {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
  }
  .article__more-media img {
    object-fit: cover;
  }
  .article__more-placeholder {
    display: grid;
    place-items: center;
    color: color-mix(in srgb, var(--color-brand) 55%, transparent);
  }
  .article__more-placeholder svg {
    width: 22px;
    height: 22px;
  }
  .article__more-body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-inline-size: 0;
  }
  .article__more-title {
    font-size: 0.86rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: break-word;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }
  .article__more-date {
    font-size: 0.72rem;
    line-height: 1.4;
    font-variant-numeric: tabular-nums;
    color: var(--color-foreground-muted);
  }
  @media (hover: hover) and (pointer: fine) {
    .article__more-link:hover .article__more-title {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 3px;
      text-decoration-color: color-mix(in srgb, var(--color-brand) 45%, transparent);
    }
  }
  .article__more-link:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
    border-radius: 8px;
  }

  @media (prefers-reduced-motion: reduce) {
    .article__pager-link,
    .article__tag,
    .article__field :is(input, textarea) {
      transition: none;
    }
    .article__pager-link:hover {
      translate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.article",
  "tag": "section",
  "class": "article-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_cover",
      "label": "t:sections.article.labels.show_cover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:sections.article.labels.show_tags",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_more_guides",
      "label": "t:sections.article.labels.show_more_guides",
      "info": "t:sections.article.labels.show_more_guides_info",
      "default": true
    }
  ]
}
{% endschema %}
