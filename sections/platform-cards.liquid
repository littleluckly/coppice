{% comment %}
  Platform cards — 首页动力平台入口（task-index T-2.2，SDD §6.5）。
  视觉基准：效果图 Shop by Platform——浅灰横条卡（图左 + 标题/工具数 + 右箭头），
  标题行右侧 View All 入口。

  状态要点（pages-ui §2）：
    - 每卡绑定一个自动化集合；显示兼容工具数（collection.all_products_count，循环外取值）
    - 空集合隐藏该卡（不是灰卡）；全部为空 → 整个 section 不渲染
{% endcomment %}

{%- liquid
  assign visible_blocks = ''
  for block in section.blocks
    assign card_collection = block.settings.collection
    if card_collection != blank and card_collection.all_products_count > 0
      if visible_blocks == ''
        assign visible_blocks = block.id
      else
        assign visible_blocks = visible_blocks | append: ',' | append: block.id
      endif
    endif
  endfor
  assign visible_ids = visible_blocks | split: ','
-%}

{%- if visible_ids.size > 0 -%}
  <div class="platform-cards">
    <div class="platform-cards__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="platform-cards__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.view_all_label != blank and section.settings.view_all_link != blank -%}
        <a class="platform-cards__view-all" href="{{ section.settings.view_all_link }}">
          {{ section.settings.view_all_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <ul class="platform-cards__grid" role="list">
      {%- for block in section.blocks -%}
        {%- unless visible_ids contains block.id -%}
          {%- continue -%}
        {%- endunless -%}

        {%- liquid
          assign card_collection = block.settings.collection
          assign card_title = block.settings.title | default: card_collection.title
          assign card_image = block.settings.image
          if card_image == blank
            assign card_image = card_collection.featured_image
          endif
          if card_image == blank and card_collection.products_count > 0
            assign card_image = card_collection.products.first.featured_image
          endif
        -%}

        <li class="platform-cards__item" {{ block.shopify_attributes }}>
          <a class="platform-cards__card" href="{{ card_collection.url }}">
            {%- if card_image != blank -%}
              <span class="platform-cards__media">
                {{
                  card_image
                  | image_url: width: 240
                  | image_tag:
                    widths: '120, 240',
                    sizes: '(min-width: 750px) 96px, 88px',
                    width: card_image.width,
                    height: card_image.height,
                    loading: 'lazy',
                    alt: card_title
                }}
              </span>
            {%- endif -%}
            <span class="platform-cards__body">
              <span class="platform-cards__title">{{ card_title | escape }}</span>
              <span class="platform-cards__count">
                {{ 'sections.platform_cards.products_count' | t: count: card_collection.all_products_count }}
              </span>
              {%- if block.settings.description != blank -%}
                <span class="platform-cards__description">{{ block.settings.description | escape }}</span>
              {%- endif -%}
            </span>
            <span class="platform-cards__arrow" aria-hidden="true">&rarr;</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .platform-cards__header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 0.75rem;
  }
  .platform-cards__heading {
    font-size: 1.25rem;
    font-weight: 500;
  }
  .platform-cards__view-all {
    color: var(--color-brand-accent);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    min-height: 44px;
    padding-block: 10px;
  }
  .platform-cards__view-all::after {
    content: '\2192';
    margin-inline-start: 0.3rem;
  }
  .platform-cards__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 750px) {
    .platform-cards__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .platform-cards__card {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    height: 100%;
    padding: 0.9rem 1rem;
    min-height: 44px;
    text-decoration: none;
    color: inherit;
    background-color: rgb(0 0 0 / 4%);
    border-radius: 12px;
  }
  .platform-cards__media {
    display: block;
    flex-shrink: 0;
  }
  .platform-cards__media img {
    width: 88px;
    height: 88px;
    object-fit: cover;
    border-radius: 8px;
  }
  .platform-cards__body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }
  .platform-cards__title {
    font-weight: 500;
    font-size: 1rem;
  }
  .platform-cards__count {
    color: rgb(0 0 0 / 60%);
    font-size: 0.85rem;
  }
  .platform-cards__description {
    font-size: 0.85rem;
    color: rgb(0 0 0 / 60%);
  }
  .platform-cards__arrow {
    margin-inline-start: auto;
    font-size: 1.2rem;
    color: rgb(0 0 0 / 45%);
    /* transform 动画需要块级/内联块盒，span 默认 inline 不响应位移 */
    display: inline-block;
  }

  /* ===== hover 绿色渐变光晕（对齐 product-card 的 hover 反馈）=====
     光晕垫在图片下面、只从图片透明区域透出（koutu alpha 图可见，
     不透明图自动隐没），产品像素零接触。仅 hover:hover + pointer:fine 生效。 */
  @media (hover: hover) and (pointer: fine) {
    .platform-cards__card {
      transition: background-color 0.15s ease, box-shadow 0.8s ease;
    }
    .platform-cards__card:hover {
      box-shadow:
        0 24px 40px -18px color-mix(in srgb, var(--color-brand) 32%, transparent),
        0 10px 18px -10px rgb(0 0 0 / 12%);
    }
    .platform-cards__media {
      position: relative;
      overflow: hidden;
      border-radius: 8px;
    }
    .platform-cards__media::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(
        135deg,
        color-mix(in srgb, var(--color-brand-light) 65%, transparent) 0%,
        color-mix(in srgb, var(--color-brand-light) 32%, transparent) 55%,
        color-mix(in srgb, var(--color-brand-light) 5%, transparent) 100%
      );
      opacity: 0;
      transition: opacity 0.8s ease;
      pointer-events: none;
    }
    .platform-cards__media img {
      position: relative; /* 压到 ::before 之上，光晕只在其透明区域可见 */
    }
    .platform-cards__card:hover .platform-cards__media::before {
      opacity: 1;
    }

    /* 箭头 hover 动画：向右滑出淡出、跳回左侧再滑入，循环（hover 期间持续，
       移开即停——WCAG 2.2.2 自动移动内容有 hover 暂停手段）。 */
    @keyframes platform-arrow-slide {
      0% {
        transform: translateX(0);
        opacity: 1;
      }
      45% {
        transform: translateX(0.5rem);
        opacity: 0;
      }
      55% {
        transform: translateX(-0.25rem);
        opacity: 0;
      }
      100% {
        transform: translateX(0);
        opacity: 1;
      }
    }
    .platform-cards__card:hover .platform-cards__arrow {
      animation: platform-arrow-slide 1.2s ease-in-out infinite;
      color: var(--color-brand);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.platform_cards.name",
  "tag": "section",
  "class": "platform-cards-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.platform_cards.defaults.heading"
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "t:labels.view_all_label",
      "default": "t:sections.platform_cards.defaults.view_all_label"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "t:labels.view_all_link"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "t:sections.platform_cards.blocks.card.name",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:labels.collection",
          "info": "t:sections.platform_cards.blocks.card.labels.collection_info"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:labels.image",
          "info": "t:sections.platform_cards.blocks.card.labels.image_info"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:labels.title_override"
        },
        {
          "type": "text",
          "id": "description",
          "label": "t:labels.description"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.platform_cards.name",
      "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }, { "type": "card" }]
    }
  ]
}
{% endschema %}
