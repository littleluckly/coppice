{% comment %}
  Collection — 集合页主体（task-collection T-2.1/T-2.2/T-2.3/T-2.4/T-3.1，pages-ui §4）。

  结构更新（2026-10-20）：实现“左侧文字卡片宽度x2并向右侵入Banner，下方Filters流式长列表”
  + “右侧Banner固定高度，下方产品网格自然流式衔接”。使用 CSS Grid 与 绝对定位结合实现。
{% endcomment %}

{%- liquid
  assign per_page = section.settings.products_per_page | default: 12
  assign has_active_filters = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active_filters = true
        break
      endif
    else
      for value in filter.values
        if value.active
          assign has_active_filters = true
          break
        endif
      endfor
    endif
    if has_active_filters
      break
    endif
  endfor
  assign has_banner = false
  if collection.image and section.settings.show_banner
    assign has_banner = true
  endif
-%}

<script src="{{ 'compare-toggle.js' | asset_url }}" defer></script>
<script src="{{ 'wishlist-toggle.js' | asset_url }}" defer></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
<script src="{{ 'product-card-3d.js' | asset_url }}" defer></script>
{%- if collection.filters.size > 0 -%}
  <script src="{{ 'faceted-filters.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if section.settings.show_sort -%}
  <script src="{{ 'sort-select.js' | asset_url }}" defer></script>
{%- endif -%}
{{ 'product-card.css' | asset_url | stylesheet_tag }}

<div class="collection{% unless has_banner %} collection--no-banner{% endunless %} full-width" data-collection-root>
  
  <!-- 1. 提取介绍内容（面包屑 + 标题 + 描述） -->
  {%- capture intro_content -%}
    <nav class="collection__breadcrumb" aria-label="{{ 'collections.breadcrumb_label' | t }}">
      <ol class="collection__breadcrumb-list" role="list">
        <li class="collection__breadcrumb-item">
          <a href="{{ routes.root_url }}">{{ 'collections.breadcrumb_home' | t }}</a>
        </li>
        <li class="collection__breadcrumb-item" aria-current="page">{{ collection.title | escape }}</li>
      </ol>
    </nav>

    <header class="collection__head">
      <h1 class="collection__title">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- endcapture -%}

  <!-- 2. 主体布局容器 (Grid) -->
  <div class="collection__main-layout">
    
    <!-- 🌟 左侧列：包含侵入的文字卡片 + 筛选器 -->
    <div class="collection__left-column">
      
      <!-- 文字卡片 (设置宽度向右侧侵入) -->
      <div class="collection__text-card">
        {{ intro_content }}
      </div>

      <!-- 筛选器表单容器 -->
      <collection-facets class="collection__facets" data-section-id="{{ section.id }}">
        <div class="collection__layout{% if collection.filters.size == 0 %} collection__layout--no-facets{% endif %}" data-facets-layout>
          
          {%- if collection.filters.size > 0 -%}
            <form class="facets__form" id="FacetsForm-{{ section.id }}" action="{{ collection.url }}" method="get" data-facets-form>
              
              {%- if section.settings.show_sort -%}
                <div class="facets__sort-card">
                  <label class="facets__sort-card-label" for="SortBy-{{ section.id }}">
                    {{ 'collections.sort.label' | t }}
                  </label>
                  <facet-sort class="facets__sort-select">
                    <select id="SortBy-{{ section.id }}" name="sort_by" data-facets-sort form="FacetsForm-{{ section.id }}">
                      {%- for option in collection.sort_options -%}
                        <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>
                          {{ option.name | escape }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </facet-sort>
                </div>
              {%- endif -%}

              {% render 'faceted-filters', filters: collection.filters %}
            </form>
          {%- endif -%}
        </div>
      </collection-facets>
    </div>

    <!-- 🌟 右侧列：Banner + 内容区 -->
    <div class="collection__right-column">
      
      <!-- Banner 区域 (固定高度，绝对定位) -->
      {%- if has_banner -%}
        <div class="collection__banner">
          {{ collection.image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', width: collection.image.width, height: collection.image.height, loading: 'eager', fetchpriority: 'high', alt: collection.image.alt, class: 'collection__banner-img' }}
          <div class="collection__ui-mask"></div>
          <div class="collection__banner-badge">
             <p>Popular Choice</p>
             <h4>Self-Propelled<br>Mowers</h4>
          </div>
        </div>
      {%- endif -%}

      <!-- 产品内容区 (需要下推避开 Banner 绝对定位的高度) -->
      <div class="collection__content">
        <div class="collection__toolbar">
          {%- if collection.filters.size > 0 -%}
            <button type="button" class="facets__open" data-facets-open aria-controls="FacetsDialog-{{ section.id }}">
              {{ 'collections.filters.open' | t }}
            </button>
          {%- endif -%}

          {%- if collection.filters.size == 0 and section.settings.show_sort -%}
            <div class="facets__sort-card">
              <label class="facets__sort-card-label" for="SortBy-{{ section.id }}">{{ 'collections.sort.label' | t }}</label>
              <facet-sort class="facets__sort-select">
                <select id="SortBy-{{ section.id }}" name="sort_by" data-facets-sort>
                  {%- for option in collection.sort_options -%}
                    <option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
                  {%- endfor -%}
                </select>
              </facet-sort>
            </div>
          {%- endif -%}

          <p class="collection__count" aria-live="polite" data-facets-count>
            {{ 'navigation.products_count' | t: count: collection.products_count }}
          </p>

          {%- render 'active-facets', filters: collection.filters, clear_url: collection.url -%}
        </div>

        <div class="collection__results" data-facets-results tabindex="-1">
          {%- paginate collection.products by per_page -%}
            {%- if collection.products_count > 0 -%}
              <ul class="collection__grid" role="list">
                {%- for product in collection.products -%}
                  <li class="collection__item">
                    {%- liquid
                      assign card_lazy = true
                      assign card_width = false
                      assign card_cc = false
                      assign card_power = false
                      assign card_weight = false
                      if forloop.index <= 4
                        assign card_lazy = false
                      endif
                      if section.settings.show_spec_width
                        assign card_width = true
                      endif
                      if section.settings.show_spec_cc
                        assign card_cc = true
                      endif
                      if section.settings.show_spec_power
                        assign card_power = true
                      endif
                      if section.settings.show_spec_weight
                        assign card_weight = true
                      endif
                    -%}
                    {% render 'product-card',
                      product: product,
                      lazy: card_lazy,
                      quick_add: section.settings.show_quick_add,
                      show_width: card_width,
                      show_cc: card_cc,
                      show_power: card_power,
                      show_weight: card_weight,
                      sizes: '(min-width: 1280px) 19vw, (min-width: 1100px) 25vw, (min-width: 750px) 32vw, 45vw'
                    %}
                  </li>
                {%- endfor -%}
              </ul>
              <!-- 分页部分保持原样... -->
            {%- elsif has_active_filters -%}
              <div class="collection__empty">
                <p class="collection__empty-title">{{ 'collections.no_matches' | t }}</p>
                <a class="collection__empty-link" href="{{ collection.url }}">{{ 'collections.clear_filters' | t }}</a>
              </div>
            {%- else -%}
              <div class="collection__empty">
                <p class="collection__empty-title">{{ 'collections.empty.title' | t }}</p>
                <p class="collection__empty-body">{{ 'collections.empty.body' | t }}</p>
                <a class="collection__empty-link" href="{{ routes.all_products_collection_url }}">{{ 'collections.empty.link' | t }}</a>
              </div>
            {%- endif -%}
          {%- endpaginate -%}
        </div>
      </div>
    </div>
  </div>

  {%- if collection.filters.size > 0 -%}
    <dialog id="FacetsDialog-{{ section.id }}" class="facets__dialog" scroll-lock aria-label="{{ 'collections.filters.label' | t }}"></dialog>
  {%- endif -%}
</div>

{% stylesheet %}
  /* ================= 1. 全局骨架与变量 ================= */
  .shopify-section.collection-section {
    display: block;
  }
  .collection {
    width: 100%;
    max-width: var(--page-width, 1440px);
    margin: 0 auto;
    padding-bottom: 4rem;
  }

  /* 核心网格布局：左 320px，右自适应 */
  .collection__main-layout {
    display: grid;
    grid-template-columns: 320px 1fr;
    align-items: start;
    position: relative;
  }

  /* ================= 2. 左侧列 (文字 + 筛选) ================= */
  .collection__left-column {
    position: relative;
    z-index: 10; /* 保证文字和筛选卡片压在 Banner 上方 */
    padding: 40px 20px 40px 40px;
    display: flex;
    flex-direction: column;
    background-color: transparent;
  }

  /* 左上角文字卡片 (宽度 x2 向右侵入) */
  .collection__text-card {
    width: 560px; 
    margin-bottom: 50px;
    color: var(--color-foreground);
  }

  .collection__title {
    font-size: clamp(2.5rem, 4vw, 4rem);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -1px;
    margin-bottom: 1rem;
  }
  
  .collection__description {
    font-size: 1.1rem;
    color: color-mix(in srgb, var(--color-foreground) 70%, transparent);
    line-height: 1.5;
  }

  /* 面包屑 */
  .collection__breadcrumb-list {
    display: flex; flex-wrap: wrap; gap: 0.35rem; list-style: none; padding: 0; margin: 0 0 1.5rem;
    font-size: 0.85rem; color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
  .collection__breadcrumb-item + .collection__breadcrumb-item::before { content: '>'; margin-inline-end: 0.35rem; font-size: 0.75rem;}
  .collection__breadcrumb-item a { color: inherit; text-decoration: none; }
  .collection__breadcrumb-item a:hover { text-decoration: underline; }

  /* 筛选卡片 (合并成一张长卡) */
  .collection__facets {
    width: 100%;
    max-width: 280px; /* 限制筛选器宽度，不随文字卡片变宽 */
  }
  .facets__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    background-color: var(--color-background);
    border-radius: 20px;
    padding: 24px;
    box-shadow: 0 10px 30px rgb(0 0 0 / 3%);
    border: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }
  
  /* 排序卡与筛选列表的间距分割线 */
  .facets__sort-card {
    padding-bottom: 1.5rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-foreground) 10%, transparent);
  }

  /* ================= 3. 右侧列 (固定 Banner + 流式产品) ================= */
  .collection__right-column {
    display: flex;
    flex-direction: column;
    width: 100%;
    position: relative;
  }

  /* Banner：绝对定位，固定高度，脱离文档流，不撑开下方 */
  .collection__banner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 650px; /* 固定高度 */
    overflow: hidden;
    z-index: 1;
    background-color: #f7f7f5;
    border-radius: 0 0 0 40px; /* 左下角圆角过渡 */
  }

  .collection__banner-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    /* 左侧虚化渐变 */
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.3) 15%, black 40%, black 100%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0,0,0,0.3) 15%, black 40%, black 100%);
  }

  /* 空气感 UI 遮罩 */
  .collection__ui-mask {
    position: absolute; 
    top: -10%; left: -5%; 
    width: 55%; height: 120%;
    background: linear-gradient(to right, rgba(247, 247, 245, 1) 0%, rgba(247, 247, 245, 0.7) 40%, rgba(255, 255, 255, 0) 80%);
    border-radius: 0 60% 50% 0 / 0 70% 50% 0; 
    z-index: 2; pointer-events: none;
  }

  /* 右侧浮动卡片模拟 */
  .collection__banner-badge {
    position: absolute; right: 5%; top: 45%;
    background: rgba(255,255,255,0.85); backdrop-filter: blur(10px);
    padding: 20px 30px; border-radius: 20px; z-index: 4; box-shadow: 0 10px 30px rgba(0,0,0,0.08);
  }
  .collection__banner-badge p { font-size:12px; color:#666; margin-bottom:5px; }
  .collection__banner-badge h4 { font-size:18px; margin:0; line-height: 1.3; }

  /* 内容区 (产品列表)，通过 margin-top 把 Banner 的 650px 空间让出来 */
  .collection__content {
    margin-top: 650px; /* 强制下推，与 Banner 齐平接轨 */
    padding: 40px;
    background-color: var(--color-background, #f7f7f5); /* 与底色融合 */
    z-index: 2; /* 压在 Banner 之下 */
    position: relative;
    border-top-left-radius: 40px;
  }

  /* 工具条与网格稍作调整适配 */
  .collection__toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
    list-style: none; padding: 0; margin: 0;
  }

  /* ================= 4. 响应式 (移动端恢复普通流) ================= */
  @media (max-width: 989.98px) {
    .collection__main-layout { display: flex; flex-direction: column; }
    
    .collection__left-column { padding: 20px; width: 100%; }
    .collection__text-card { width: 100%; margin-bottom: 30px; }
    .collection__title { font-size: 2.2rem; }
    .collection__facets { max-width: 100%; }

    /* 移动端 Banner 取消绝对定位，恢复常规流 */
    .collection__banner {
      position: relative;
      height: 500px;
      border-radius: 0;
      margin-bottom: 0;
    }
    .collection__ui-mask { width: 100%; border-radius: 0; background: linear-gradient(to bottom, #f7f7f5 0%, transparent 80%); }
    .collection__banner-badge { display: none; } /* 移动端隐藏小卡片 */

    /* 移动端产品列表归位 */
    .collection__content {
      margin-top: 0;
      padding: 20px;
      border-radius: 0;
    }
  }
  
  /* 原有筛选等组件的内部样式保持不变... (此处省略，保留你原文件里的其他组件样式) */
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection.name",
  "tag": "section",
  "class": "collection-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "t:sections.collection.labels.show_banner",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.collection.labels.show_sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.collection.labels.show_quick_add",
      "info": "t:sections.collection.labels.quick_add_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection.headers.card_specs"
    },
    {
      "type": "checkbox",
      "id": "show_spec_width",
      "label": "t:sections.collection.labels.show_spec_width",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_cc",
      "label": "t:sections.collection.labels.show_spec_cc",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_power",
      "label": "t:sections.collection.labels.show_spec_power",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_weight",
      "label": "t:sections.collection.labels.show_spec_weight",
      "info": "t:sections.collection.labels.spec_info",
      "default": false
    }
  ]
}
{% endschema %}
