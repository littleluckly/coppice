

{%- liquid
  assign per_page = section.settings.products_per_page | default: 12
  assign has_active_filters = false
  for filter in collection.filters
    if filter.type == 'price_range'
      if filter.min_value.value != blank or filter.max_value.value != blank
        assign has_active_filters = true
        break
      endif
    else
      for value in filter.values
        if value.active
          assign has_active_filters = true
          break
        endif
      endfor
    endif
    if has_active_filters
      break
    endif
  endfor
  # 横幅底图取值链（2026-10-20）：取第一个非空
  #   ① 集合 metafield custom.banner_background（File > Image）——每个集合各填一张；
  #   ② section 设置 banner_background_image——全店共用的模板值（演示数据在这里）；
  #   ③ collection.image——集合后台的封面图，最后兜底。
  # 产品悬浮岛同链条（见右列）：岛图为空则不渲染——退化为纯风景横幅。
  # ⚠️ metafield 的 .value 是 media 对象，属性与 image 对象不同：用 preview_image
  #    归一化成 image，后面的 .width / .height / .alt 才有值（image_tag 尺寸靠它们）。
  #    键名改了这里会静默取到空值、页面照旧 —— 改键必须同步改这一行。
  assign banner_image = collection.metafields.custom.banner_background.value
  assign banner_image = banner_image.preview_image | default: banner_image
  assign banner_image = banner_image | default: section.settings.banner_background_image | default: collection.image
  assign has_banner = false
  if banner_image and section.settings.show_banner
    assign has_banner = true
  endif
  # 亮点行取值链（2026-10-29 刘工拍板：3 个独立集合 metafield 字段）：
  #   custom.banner_highlight_1..3（单行文本，格式「图标|文案」；不带竖线 → 整条当文案、无图标）。
  #   三条全空 = 亮点区整个不输出（**没有任何兜底**，2026-10-29 刘工：不要默认值）。
  #   ⚠️ 必须逐条判 != blank：Liquid 里空数组是 truthy，写 `if arr` 会漏判。
  #   ⚠️ 拼成数组再 split，只是为了让渲染侧只留一份 <li> 模版（Liquid 没有
  #      compact，空条目只能在遍历时跳过）。
  assign mf_h1 = collection.metafields.custom.banner_highlight_1.value | default: '' | strip
  assign mf_h2 = collection.metafields.custom.banner_highlight_2.value | default: '' | strip
  assign mf_h3 = collection.metafields.custom.banner_highlight_3.value | default: '' | strip
  assign mf_highlights = mf_h1 | append: ';;;' | append: mf_h2 | append: ';;;' | append: mf_h3 | split: ';;;'
  assign has_mf_highlights = false
  for item in mf_highlights
    if item != blank
      assign has_mf_highlights = true
      break
    endif
  endfor
-%}

<script src="{{ 'wishlist-toggle.js' | asset_url }}" defer></script>
<script src="{{ 'quick-add.js' | asset_url }}" defer></script>
<script src="{{ 'tilt-element.js' | asset_url }}" defer></script>

{%- if collection.filters.size > 0 or section.settings.show_sort -%}
  {{ 'facets.css' | asset_url | stylesheet_tag }}
{%- endif -%}
{%- if collection.filters.size > 0 -%}
  <script src="{{ 'faceted-filters.js' | asset_url }}" defer></script>
{%- endif -%}
{%- if section.settings.show_sort -%}
  <script src="{{ 'sort-select.js' | asset_url }}" defer></script>
{%- endif -%}
<script src="{{ 'view-toggle.js' | asset_url }}" defer></script>
{{ 'product-card.css' | asset_url | stylesheet_tag }}

<div class="collection{% unless has_banner %} collection--no-banner{% endunless %} full-width" data-collection-root>
  {%- capture intro_content -%}
    <nav class="collection__breadcrumb" aria-label="{{ 'collections.breadcrumb_label' | t }}">
      <ol class="collection__breadcrumb-list" role="list">
        <li class="collection__breadcrumb-item">
          <a href="{{ routes.root_url }}">{{ 'collections.breadcrumb_home' | t }}</a>
        </li>
        <li class="collection__breadcrumb-item" aria-current="page">{{ collection.title | escape }}</li>
      </ol>
    </nav>

    <header class="collection__head">
      <h1 class="collection__title">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}
        <div class="collection__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </header>
  {%- endcapture -%}

  <collection-facets class="collection__facets" data-section-id="{{ section.id }}">
    <div class="collection__layout" data-facets-layout>

      <div class="collection__left">
        <div class="collection__intro">
          {{ intro_content }}
          {%- if has_mf_highlights -%}

            <ul class="collection__features" role="list">
              {%- for fh in mf_highlights -%}
                {%- if fh == blank -%}
                  {%- continue -%}
                {%- endif -%}

                {%- assign fh_pair = fh | split: '|' -%}
                {%- if fh_pair.size > 1 -%}
                  {%- assign fh_icon = fh_pair[0] | strip -%}
                  {%- assign fh_text = fh_pair | slice: 1, fh_pair.size | join: '|' | strip -%}
                {%- else -%}
                  {%- assign fh_icon = '' -%}
                  {%- assign fh_text = fh | strip -%}
                {%- endif -%}
                {%- if fh_text != blank -%}
                  <li class="collection__feature">
                    {%- if fh_icon != blank -%}
                      <span class="collection__feature-badge" aria-hidden="true">
                        <span class="collection__feature-emoji">{{ fh_icon | escape }}</span>
                      </span>
                    {%- endif -%}
                    <span class="collection__feature-text">{{ fh_text | escape }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        {%- if collection.filters.size > 0 -%}

          <div class="facets__form-slot" data-facets-form-slot>
            <form
              class="facets__form"
              id="FacetsForm-{{ section.id }}"
              action="{{ collection.url }}"
              method="get"
              data-facets-form
            >
              {%- capture sort_card -%}
                {%- if section.settings.show_sort -%}
                  <div class="facets__sort-card">
                    <label class="facets__sort-card-label" for="SortBy-{{ section.id }}">
                      {{ 'collections.sort.label' | t }}
                    </label>
                    <facet-sort
                      class="facets__sort-select"
                      data-label-close="{{ 'navigation.close' | t }}"
                    >
                      <select
                        id="SortBy-{{ section.id }}"
                        name="sort_by"
                        data-facets-sort
                        form="FacetsForm-{{ section.id }}"
                      >
                        {%- for option in collection.sort_options -%}
                          <option
                            value="{{ option.value }}"
                            {% if option.value == collection.sort_by %}
                              selected
                            {% endif %}
                          >
                            {{ option.name | escape }}
                          </option>
                        {%- endfor -%}
                      </select>
                    </facet-sort>
                  </div>
                {%- endif -%}
              {%- endcapture -%}

              {% render 'faceted-filters', filters: collection.filters, sort_card: sort_card %}
            </form>
          </div>
        {%- endif -%}
      </div>

      <div class="collection__right">
        {%- if has_banner -%}
          {%- liquid
            assign banner_alt = banner_image.alt | default: ''
            # 岛图同取值链：集合 metafield（custom.banner_product）→ section 设置。
            # preview_image 归一化理由同上（media → image）。
            assign island = collection.metafields.custom.banner_product.value
            assign island = island.preview_image | default: island
            assign island = island | default: section.settings.banner_product_image
            assign island_alt = island.alt | default: collection.title
          -%}

          <tilt-element
            class="collection__banner"
            data-tilt-target=".collection__banner-island"
            data-tilt-rotate="6"
            data-tilt-shift="10"
            data-tilt-scale="1.02"
            data-tilt-perspective="1200"
          >

            {%- capture banner_bg_img -%}
              {{
                banner_image
                | image_url: width: 2400
                | image_tag:
                  class: 'collection__banner-bg',
                  widths: '750, 1100, 1500, 2000, 2400',
                  sizes: '(min-width: 990px) 70vw, 100vw',
                  width: banner_image.width,
                  height: banner_image.height,
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: banner_alt
              }}
            {%- endcapture -%}
            {%- unless banner_bg_img contains ' alt=' -%}
              {%- assign banner_bg_img = banner_bg_img | replace: '<img ', '<img alt="" ' -%}
            {%- endunless -%}
            {{ banner_bg_img }}
            <div class="collection__banner-mask" aria-hidden="true"></div>
            {%- if island -%}
              {{
                island
                | image_url: width: 1600
                | image_tag:
                  class: 'collection__banner-island',
                  widths: '600, 900, 1200, 1600',
                  sizes: '(min-width: 990px) 45vw, 90vw',
                  width: island.width,
                  height: island.height,
                  loading: 'eager',
                  alt: island_alt
              }}
            {%- endif -%}

            <svg
              class="collection__banner-wave"
              viewBox="0 0 1200 62"
              preserveAspectRatio="none"
              aria-hidden="true"
              focusable="false"
            >

              <path
                class="collection__banner-wave-ghost"
                d="M0 16 C 120 30 260 33 380 30 C 500 25 620 17 760 14 C 900 17 1060 27 1200 23 L1200 62 L0 62 Z"
                fill="currentColor"
              />
              <path
                d="M0 30 C 120 46 260 46 380 38 C 500 30 620 28 760 36 C 900 44 1060 42 1200 30 L1200 62 L0 62 Z"
                fill="currentColor"
              />
            </svg>
          </tilt-element>
        {%- endif -%}

        <div class="collection__content">
          <div class="collection__toolbar" data-facets-toolbar>
            {%- if collection.filters.size > 0 -%}
              <button
                type="button"
                class="facets__open"
                data-facets-open
                aria-controls="FacetsDialog-{{ section.id }}"
              >
                {{ 'collections.filters.open' | t }}

                {{ 'icon-chevron-down.svg' | inline_asset_content }}
              </button>
            {%- endif -%}

            {%- if collection.filters.size == 0 and section.settings.show_sort -%}
              <div class="facets__sort-card">
                <label class="facets__sort-card-label" for="SortBy-{{ section.id }}">
                  {{ 'collections.sort.label' | t }}
                </label>
                <facet-sort
                  class="facets__sort-select"
                  data-label-close="{{ 'navigation.close' | t }}"
                >
                  <select id="SortBy-{{ section.id }}" name="sort_by" data-facets-sort>
                    {%- for option in collection.sort_options -%}
                      <option
                        value="{{ option.value }}"
                        {% if option.value == collection.sort_by %}
                          selected
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                </facet-sort>
              </div>
            {%- endif -%}

            <p class="collection__count" aria-live="polite" data-facets-count>
              {{ 'navigation.products_count' | t: count: collection.products_count }}
            </p>

            {%- if collection.products_count > 0 -%}
            <view-toggle class="view-toggle" data-view-toggle>
              <button
                type="button"
                class="view-toggle__button"
                aria-pressed="false"
                aria-label="{{ 'collections.view.list_label' | t }}"
              >
                <span class="view-toggle__icon view-toggle__icon--grid" aria-hidden="true">
                  {{- 'icon-view-grid.svg' | inline_asset_content -}}
                </span>
                <span class="view-toggle__icon view-toggle__icon--list" aria-hidden="true">
                  {{- 'icon-view-list.svg' | inline_asset_content -}}
                </span>
              </button>
            </view-toggle>
            {%- endif -%}

            {%- render 'active-facets', filters: collection.filters, clear_url: collection.url -%}
          </div>

          <div class="collection__results" data-facets-results tabindex="-1">
            {%- paginate collection.products by per_page -%}
              {%- if collection.products_count > 0 -%}
                <ul class="collection__grid" role="list">
                  {%- for product in collection.products -%}
                    <li class="collection__item">
                      {%- liquid
                        assign card_lazy = true
                        assign card_width = false
                        assign card_cc = false
                        assign card_power = false
                        assign card_weight = false
                        if forloop.index <= 4
                          assign card_lazy = false
                        endif
                        if section.settings.show_spec_width
                          assign card_width = true
                        endif
                        if section.settings.show_spec_cc
                          assign card_cc = true
                        endif
                        if section.settings.show_spec_power
                          assign card_power = true
                        endif
                        if section.settings.show_spec_weight
                          assign card_weight = true
                        endif
                      -%}
                      {% render 'product-card',
                        product: product,
                        lazy: card_lazy,
                        quick_add: section.settings.show_quick_add,
                        show_width: card_width,
                        show_cc: card_cc,
                        show_power: card_power,
                        show_weight: card_weight,
                        sizes: '(min-width: 1280px) 19vw, (min-width: 1100px) 25vw, (min-width: 750px) 32vw, 45vw'
                      %}
                    </li>
                  {%- endfor -%}
                </ul>

                {%- if paginate.pages > 1 -%}

                  <nav class="collection__pagination" aria-label="{{ 'collections.pagination_label' | t }}">
                    {%- if paginate.previous -%}
                      <a class="collection__pagination-nav" href="{{ paginate.previous.url }}" aria-label="{{ 'collections.pagination_previous' | t }}">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                      </a>
                    {%- else -%}
                      <span class="collection__pagination-nav" aria-disabled="true">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6" /></svg>
                      </span>
                    {%- endif -%}

                    {%- for part in paginate.parts -%}
                      {%- if part.is_link -%}
                        <a class="collection__pagination-page" href="{{ part.url }}" aria-label="{{ 'collections.page_number' | t: number: part.title }}">{{ part.title }}</a>
                      {%- elsif part.title == paginate.current_page -%}
                        <span class="collection__pagination-page" aria-current="page">{{ part.title }}</span>
                      {%- else -%}
                        <span class="collection__pagination-gap" aria-hidden="true">{{ part.title }}</span>
                      {%- endif -%}
                    {%- endfor -%}

                    {%- if paginate.next -%}
                      <a class="collection__pagination-nav" href="{{ paginate.next.url }}" aria-label="{{ 'collections.pagination_next' | t }}">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                      </a>
                    {%- else -%}
                      <span class="collection__pagination-nav" aria-disabled="true">
                        <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
                      </span>
                    {%- endif -%}
                  </nav>
                {%- endif -%}
              {%- elsif has_active_filters -%}

                <div class="collection__empty">
                  <p class="collection__empty-title">{{ 'collections.no_matches' | t }}</p>
                  <a class="collection__empty-link" href="{{ collection.url }}">
                    {{ 'collections.clear_filters' | t }}
                  </a>
                </div>
              {%- else -%}

                <div class="collection__empty">
                  <p class="collection__empty-title">{{ 'collections.empty.title' | t }}</p>
                  <p class="collection__empty-body">{{ 'collections.empty.body' | t }}</p>
                  <a class="collection__empty-link" href="{{ routes.all_products_collection_url }}">
                    {{ 'collections.empty.link' | t }}
                  </a>
                </div>
              {%- endif -%}
            {%- endpaginate -%}
          </div>
        </div>
      </div>
    </div>
  </collection-facets>

  {%- if collection.filters.size > 0 -%}

    <bottom-sheet media="(max-width: 989.98px)">
      <dialog
        id="FacetsDialog-{{ section.id }}"
        class="facets__dialog"
        scroll-lock
        aria-label="{{ 'collections.filters.label' | t }}"
      ></dialog>
    </bottom-sheet>
  {%- endif -%}
</div>

{% stylesheet %}

  .shopify-section.collection-section {
    display: block;
  }

  .collection {

    --collection-surface: color-mix(in srgb, var(--color-foreground) 3%, var(--color-background));
    --collection-left: 320px;
    --banner-h: 650px;

    --facets-sticky-top: 4.75rem;

    display: grid;
    grid-template-columns: var(--page-margin) minmax(0, 1fr);
    width: 100%;
    max-width: 1920px;
    margin-inline: auto;
    align-items: start;
    background-color: var(--collection-surface);
  }

  .collection__facets {
    grid-column: 2;
    display: block;
    min-width: 0;
  }
  .collection__layout {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    min-width: 0;
  }

  .collection__left {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-left: 20px;
  }

  .collection__intro {
    width: 570px;
    padding-block-start: 10px;
    margin-block-end: 50px;
  }

  .collection__features {
    display: flex;
    flex-wrap: wrap;
    gap: 28px 40px;
    list-style: none;
    padding: 0;
    margin: 24px 0 0 0;
  }
  .collection__feature {
    display: flex;
    align-items: center;
    gap: 14px;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-brand);
  }
  .collection__feature-badge {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    inline-size: 3.5rem;
    block-size: 3.5rem;
    border-radius: 50%;
    background-color: var(--color-background);
    box-shadow: 0 2px 10px color-mix(in srgb, var(--color-brand) 8%, transparent);
    color: var(--color-brand);
  }

  .collection__feature-emoji {
    font-size: 1.75rem;
    line-height: 1;
  }
  .collection__feature-text {
    display: block;
    max-inline-size: 9ch;
  }

  .collection--no-banner .collection__intro {
    width: 100%;
    margin-block-end: 2rem;
  }

  .collection__right {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .collection__banner {

    display: block;
    position: relative;
    width: 100%;
    height: var(--banner-h);
    overflow: hidden;
    flex-shrink: 0;
    background-color: var(--collection-surface);
  }
  .collection__banner-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center right;
    z-index: 1;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 30%) 15%, #000 40%, #000 100%);
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 30%) 15%, #000 40%, #000 100%);
  }
  .collection__banner-mask {
    position: absolute;
    top: -10%;
    left: -5%;

    width: clamp(30%, calc(100% - 520px), 55%);
    height: 120%;
    background: linear-gradient(
      to right,
      var(--collection-surface) 0%,
      color-mix(in srgb, var(--collection-surface) 70%, transparent) 40%,
      transparent 80%
    );
    border-radius: 0 60% 50% 0 / 0 70% 50% 0;
    z-index: 2;
    pointer-events: none;
  }
  .collection__banner-island {
    position: absolute;
    top: 50%;
    left: 60%;

    translate: -50% -45%;
    width: 75%;
    max-width: 900px;
    z-index: 3;
    filter: drop-shadow(0 30px 40px rgb(0 0 0 / 25%));
  }

  .collection__banner-wave {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {

    .collection__banner-island {
      transition: transform 0.8s cubic-bezier(0.23, 1, 0.32, 1);
    }
  }
  @media (prefers-reduced-motion: reduce) {

    .collection__banner-island {
      transition: none;
    }
  }

  .collection__content {
    padding: 40px;
    min-width: 0;
  }

  .collection__breadcrumb-list {
    display: flex;
    flex-wrap: wrap;

    align-items: center;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0 0 0.5rem;
    font-size: 0.82rem;
    color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
  }
  .collection__breadcrumb-item + .collection__breadcrumb-item::before {
    content: '/';
    margin-inline-end: 0.35rem;
  }
  .collection__breadcrumb-item a {
    color: inherit;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }
  .collection__breadcrumb-item a:hover {
    text-decoration: underline;
  }

  .collection__title {
    font-size: clamp(2rem, 4.4vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-block-end: 0.75rem;
  }
  .collection__description {
    margin-block-start: 0.5rem;
    max-width: 60ch;
    font-size: 1.05rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-foreground) 62%, transparent);
  }

  .facets__form-slot {
    min-width: 0;
  }

  .collection__toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    min-height: 44px;
  }

  .view-toggle {
    display: flex;
    flex: none;
  }

  view-toggle:not(:defined) {
    display: none;
  }
  .view-toggle__button {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    border: var(--facet-control-border);
    border-radius: var(--facet-control-radius);
    background: none;
    color: inherit;
    cursor: pointer;
  }
  .view-toggle__button:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }
  .view-toggle__button svg {
    inline-size: 18px;
    block-size: 18px;
    stroke-width: 1.6;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
  }

  .view-toggle__icon {
    display: none;
  }
  .view-toggle__button[aria-pressed='false'] .view-toggle__icon--grid {
    display: block;
  }
  .view-toggle__button[aria-pressed='true'] .view-toggle__icon--list {
    display: block;
  }

  .collection__count {
    font-size: 0.85rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
    white-space: nowrap;
  }

  .collection__results {
    position: relative;
    margin-block-start: 0.5rem;
  }
  .collection__results:focus {
    outline: none;
  }
  collection-facets[aria-busy='true'] [data-facets-results] {
    pointer-events: none;
  }
  .collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  @media (min-width: 750px) {

    .collection__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1280px) {

    .collection__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  html[data-collection-view='list'] .collection__grid {
    grid-template-columns: 1fr;
  }
  html[data-collection-view='list'] .collection__grid .product-card {
    display: grid;

    grid-template-columns: clamp(104px, 30%, 168px) minmax(0, 1fr);
    align-content: start;
    column-gap: 1rem;
    row-gap: 0.35rem;
  }
  html[data-collection-view='list'] .collection__grid .product-card > * {
    grid-column: 2;
  }

  html[data-collection-view='list'] .collection__grid .product-card__media-wrap {
    grid-column: 1;
    grid-row: 1 / span 6;
    align-self: stretch;
    min-block-size: 0;
  }
  html[data-collection-view='list'] .collection__grid .product-card__media {
    block-size: 100%;
  }
  html[data-collection-view='list'] .collection__grid .product-card__media img {
    block-size: 100%;
    aspect-ratio: auto;
    object-fit: contain;
  }

  html[data-collection-view='list'] .collection__grid .product-card__compare,
  html[data-collection-view='list'] .collection__grid .product-card__quick-add {
    margin-block-start: 0;
  }

  html[data-collection-view='list'] .collection__grid .product-card__add {
    max-inline-size: min(100%, 240px);
  }

  .collection__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-block-start: 1.5rem;
  }
  .collection__pagination-nav,
  .collection__pagination-page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: 999px;
    background-color: var(--color-background);
    color: inherit;
    font-size: 0.9rem;
    text-decoration: none;
  }
  .collection__pagination a:hover {
    border-color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }
  .collection__pagination [aria-disabled='true'] {
    opacity: 0.35;
  }
  .collection__pagination [aria-current='page'] {
    border-color: transparent;
    background-color: var(--color-brand);
    color: var(--color-background);
  }
  .collection__pagination-gap {
    min-width: 24px;
    text-align: center;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .collection__empty {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 3rem 1rem;
    text-align: center;
    border: 1px dashed color-mix(in srgb, var(--color-foreground) 20%, transparent);
    border-radius: 12px;
  }
  .collection__empty-title {
    font-size: 1.05rem;
    font-weight: 500;
  }
  .collection__empty-body {
    font-size: 0.9rem;
    color: color-mix(in srgb, var(--color-foreground) 60%, transparent);
  }
  .collection__empty-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 1.25rem;
    margin-block-start: 0.5rem;
    border: 1px solid var(--color-foreground);
    border-radius: var(--style-border-radius-inputs);
    color: inherit;
    text-decoration: none;
  }

  @media (min-width: 990px) {

    .collection__layout {

      grid-template-columns: var(--collection-left) minmax(0, 1fr);
      gap: 0;
    }

    .collection__left {
      align-self: stretch;
    }

    .facets__form-slot {
      position: sticky;
      top: var(--facets-sticky-top);
      max-height: calc(100vh - var(--facets-sticky-top) - 1.5rem);
      max-height: calc(100dvh - var(--facets-sticky-top) - 1.5rem);
      overflow-y: auto;
      overscroll-behavior: contain;

      scrollbar-width: thin;
      scrollbar-color: transparent transparent;
    }

    .facets__form-slot:hover,
    .facets__form-slot:focus-within {
      scrollbar-color: color-mix(in srgb, var(--color-foreground) 30%, transparent) transparent;
    }

    .facets__form-slot::-webkit-scrollbar-thumb {
      background-color: transparent;
    }

    .facets__form-slot:hover::-webkit-scrollbar-thumb,
    .facets__form-slot:focus-within::-webkit-scrollbar-thumb {
      background-color: color-mix(in srgb, var(--color-foreground) 30%, transparent);
    }

    .facets__form-slot::-webkit-scrollbar-thumb:hover {
      background-color: color-mix(in srgb, var(--color-foreground) 55%, transparent);
    }
  }

  @media (max-width: 989.98px) {

    .collection {
      display: block;
    }

    .collection__facets {
      grid-column: auto;
    }

    .collection__left,
    .collection__right {
      display: contents;
    }

    .collection__banner,
    .collection__intro {
      grid-row: 1;
      grid-column: 1;
    }

    .collection__intro {
      position: relative;
      z-index: 10;
      align-self: start;
      width: 100%;

      padding: 20px 20px 2.5rem;
      margin-block-end: 0;
    }

    .collection:not(.collection--no-banner) .collection__intro::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      pointer-events: none;
      background: linear-gradient(
        to right,
        color-mix(in srgb, var(--collection-surface) 88%, transparent) 0%,
        color-mix(in srgb, var(--collection-surface) 78%, transparent) 55%,
        transparent 82%
      );
    }

    .collection:not(.collection--no-banner) .collection__description {

      max-inline-size: 50%;
    }

    .collection:not(.collection--no-banner) .collection__feature {
      flex: 1 1 0;
      min-inline-size: 0;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      text-align: center;
      font-size: 0.75rem;
      line-height: 1.25;
    }

    .collection:not(.collection--no-banner) .collection__feature-text {
      max-inline-size: 100%;
    }

    .collection:not(.collection--no-banner) .collection__feature-badge {
      inline-size: 2.25rem;
      block-size: 2.25rem;
    }

    .collection:not(.collection--no-banner) .collection__feature-emoji {
      font-size: 1.125rem;
    }

    .collection:not(.collection--no-banner) .collection__features {
      position: relative;
      max-inline-size: 50%;
      padding-block-start: 20px;
      margin-block-start: 20px;
      gap: 14px 10px;
      justify-content: space-between;
    }

    .collection:not(.collection--no-banner) .collection__features::before {
      content: '';
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      inline-size: 72px;
      block-size: 1px;
      background-color: color-mix(in srgb, var(--color-foreground) 25%, transparent);
    }

    .collection--no-banner .collection__intro {
      padding-block-end: 0;
    }

    .facets__form-slot {
      padding: 0 20px 20px;
    }

    html.js .facets__form-slot {
      padding: 0;
    }

    .collection__title {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      letter-spacing: -0.01em;
    }

    .collection__features {
      gap: 20px 24px;
    }

    .collection__feature {
      gap: 12px;
      font-size: 0.875rem;
    }

    .collection__feature-badge {
      inline-size: 3rem;
      block-size: 3rem;
    }

    .collection__feature-emoji {
      font-size: 1.375rem;
    }

    .collection__banner {
      align-self: stretch;
      height: auto;
      min-height: clamp(300px, 82vw, 360px);
    }

    .collection__banner-bg {
      object-position: center;
      -webkit-mask-image: none;
      mask-image: none;
    }

    .collection__banner-wave {
      display: block;
      position: absolute;
      inset-inline: 0;
      inset-block-end: -1px;
      inline-size: 100%;
      block-size: 32px;
      z-index: 12;
      color: var(--collection-surface);
      pointer-events: none;
    }

    .collection__banner-wave-ghost {
      opacity: 0.6;
    }

    .collection__banner-mask {
      display: none;
    }

    .collection__banner-island {
      width: 50%;
      left: 88%;
      top: 100%;
      translate: -50% -100%;
    }

    .collection__content {
      padding: 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.collection.name",
  "tag": "section",
  "class": "collection-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_banner",
      "label": "t:sections.collection.labels.show_banner",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:sections.collection.paragraphs.banner_images"
    },
    {
      "type": "image_picker",
      "id": "banner_background_image",
      "label": "t:sections.collection.labels.banner_background_image",
      "info": "t:sections.collection.labels.banner_background_info"
    },
    {
      "type": "image_picker",
      "id": "banner_product_image",
      "label": "t:sections.collection.labels.banner_product_image",
      "info": "t:sections.collection.labels.banner_product_info"
    },
    {
      "type": "paragraph",
      "content": "t:sections.collection.paragraphs.banner_highlights"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "t:labels.products_to_show",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "t:sections.collection.labels.show_sort",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "t:sections.collection.labels.show_quick_add",
      "info": "t:sections.collection.labels.quick_add_info",
      "default": true
    },
    {
      "type": "header",
      "content": "t:sections.collection.headers.card_specs"
    },
    {
      "type": "checkbox",
      "id": "show_spec_width",
      "label": "t:sections.collection.labels.show_spec_width",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_cc",
      "label": "t:sections.collection.labels.show_spec_cc",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_power",
      "label": "t:sections.collection.labels.show_spec_power",
      "info": "t:sections.collection.labels.spec_info",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_spec_weight",
      "label": "t:sections.collection.labels.show_spec_weight",
      "info": "t:sections.collection.labels.spec_info",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection.presets.default"
    }
  ]
}
{% endschema %}
