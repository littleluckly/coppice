

{{ 'cart-line.css' | asset_url | stylesheet_tag }}

<cart-items
  class="cart-lines"
  data-cart-section="{{ section.id }}"
  data-cart-change-url="{{ routes.cart_change_url }}.js"
  data-cart-update-url="{{ routes.cart_update_url }}.js"
  data-cart-live-template="{{ 'cart.total_updated' | t: total: '[total]' }}"
  data-cart-product-ids="{{ cart.items | map: 'product_id' | join: ',' }}"
  data-error-message="{{ 'products.product_card.add_error' | t }}"
>
  <h1 class="cart-lines__title" tabindex="-1">
    {{ 'cart.title' | t }}
    {%- if cart.item_count > 0 -%}
      <span class="cart-lines__count" aria-hidden="true">({{ cart.item_count }})</span>
    {%- endif -%}
  </h1>

  {%- if cart.item_count == 0 -%}

    <div class="cart-lines__empty">
      <p class="cart-lines__empty-heading">{{ 'cart.empty_heading' | t }}</p>
      <p class="cart-lines__empty-text">{{ 'cart.empty_text' | t }}</p>
      <a class="btn-solid cart-lines__empty-cta" href="{{ routes.all_products_collection_url }}">
        {{- 'cart.continue_shopping' | t -}}
      </a>
    </div>
  {%- else -%}

    <div class="cart-lines__table">
      <div class="cart-lines__head" aria-hidden="true">
        <span class="cart-lines__head-product">{{ 'cart.product' | t }}</span>
        <span class="cart-lines__head-price">{{ 'cart.price' | t }}</span>
        <span class="cart-lines__head-qty">{{ 'cart.quantity' | t }}</span>
        <span class="cart-lines__head-total">{{ 'cart.total' | t }}</span>
      </div>

      <form id="cart-form" class="cart-lines__form" action="{{ routes.cart_url }}" method="post" novalidate>
        <ul class="cart-lines__list" role="list">
          {%- for item in cart.items -%}
            <li class="cart-lines__item" data-line-key="{{ item.key }}">
              {%- render 'cart-line', item: item, show_stock: section.settings.show_stock -%}
            </li>
          {%- endfor -%}
        </ul>

        <div class="cart-lines__note">
          <label class="cart-lines__note-label" for="CartNote">{{ 'cart.note_label' | t }}</label>
          <textarea
            id="CartNote"
            class="cart-lines__note-input"
            name="note"
            rows="3"
            placeholder="{{ 'cart.note_placeholder' | t }}"
            data-cart-note
          >{{ cart.note }}</textarea>
        </div>

        <div class="cart-lines__actions">
          <button type="submit" name="update" class="btn-solid btn-solid--quiet cart-lines__update">
            {{- 'cart.update_cart' | t -}}
          </button>
        </div>
      </form>
    </div>
  {%- endif -%}
</cart-items>

{% stylesheet %}
  cart-items {
    display: block;
  }

  .cart-lines__title {
    font-size: clamp(1.75rem, 3.2vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-block-end: 1rem;
  }
  .cart-lines__count {
    font-size: 0.5em;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--color-foreground-muted);
    margin-inline-start: 0.35em;
  }

  .cart-lines__table {
    border: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    border-radius: 12px;
    padding-inline: 1.25rem;
    padding-block-end: 0.25rem;
  }
  .cart-lines__head {

    display: none;
  }

  .cart-lines__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cart-lines__item + .cart-lines__item {
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  @media (min-width: 750px) {
    .cart-lines__head,
    .cart-lines .cart-line {
      grid-template-columns: 96px minmax(0, 1fr) 120px 132px 100px;
      gap: 1rem;
    }
    .cart-lines .cart-line {
      grid-template-areas: 'media info price qty total';
      align-items: center;

      padding-block: 1.25rem;
    }
    .cart-lines__head {
      display: grid;
      align-items: end;
      padding-block: 0.9rem 0.6rem;
      border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
      font-size: 0.8125rem;
      color: var(--color-foreground-muted);
    }

    .cart-lines__head-product {
      grid-column: 1 / span 2;
    }

    .cart-lines .cart-line__qty,
    .cart-lines .cart-line__total {
      justify-self: start;
    }
  }

  @media (max-width: 749px) {
    .cart-lines__table {
      border: 0;
      border-radius: 0;
      padding-inline: 0;
      padding-block-end: 0;
    }
  }

  .cart-lines__note {
    display: grid;
    gap: 0.35rem;

    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
    padding-block: 1.25rem 0.5rem;
  }
  .cart-lines__note-label {
    font-size: 0.875rem;
    font-weight: 500;
  }
  .cart-lines__note-input {

    inline-size: 100%;
    padding: 0.6rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-foreground) 16%, transparent);
    border-radius: 8px;
    background-color: var(--color-background);
    color: inherit;
    font: inherit;
    resize: vertical;
  }
  .cart-lines__note-input::placeholder {
    color: var(--color-foreground-muted);
  }

  .cart-lines__actions {
    display: flex;
    justify-content: flex-end;
    padding-block-start: 1rem;
  }
  .cart-lines__update {
    padding-inline: 1.25rem;
  }

  .cart-lines__empty {
    display: grid;
    justify-items: start;
    gap: 0.75rem;
    padding-block: 2.5rem 3rem;
  }
  .cart-lines__empty-heading {
    font-size: 1.25rem;
    font-weight: 500;
  }
  .cart-lines__empty-text {
    color: var(--color-foreground-muted);
    max-inline-size: 42ch;
  }
  .cart-lines__empty-cta {
    margin-block-start: 0.5rem;
    padding-inline: 1.5rem;
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.cart_lines.name",
  "tag": "section",
  "class": "cart-lines-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_stock",
      "label": "t:sections.cart_lines.labels.show_stock",
      "info": "t:sections.cart_lines.labels.show_stock_info",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.cart_lines.name"
    }
  ]
}
{% endschema %}
