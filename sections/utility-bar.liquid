{% comment %}
  Utility bar — secondary service info (sales line, pickup notice, and similar).

  Sits between the announcement bar and the main navigation row. Like the
  announcement bar it is NOT sticky: on PC the main navigation row is the sticky
  element (O-1), and this bar scrolls away with it. Hiding it on mobile follows the
  same reasoning — the same information repeats in the footer, and on a phone it
  would eat scarce first-screen height.

  Content is merchant-configured blocks, not hard-coded contact details: phone
  numbers and addresses are store-specific, and inventing them would be fake content
  (SDD §9.4 forbids placeholders).
{% endcomment %}

{%- if section.blocks.size > 0 -%}
  <div class="utility-bar" role="region" aria-label="{{ 'sections.utility_bar.label' | t }}">
    <ul class="utility-bar__list" role="list">
      {%- for block in section.blocks -%}
        <li class="utility-bar__item" role="listitem">
          {%- if block.settings.link != blank -%}
            <a class="utility-bar__link" href="{{ block.settings.link }}">
              {{- block.settings.text -}}
            </a>
          {%- else -%}
            <span class="utility-bar__text">{{ block.settings.text }}</span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
{%- endif -%}

{% stylesheet %}
  .utility-bar {
    /* Mobile hidden by default (pages-ui §1.1): the same content lives in the
       footer, and first-screen height is scarce on a phone. */
    display: none;
    background-color: var(--color-background);
    /* 主题未提供边框令牌（css-variables.liquid 无 --color-border），
       用前景色的低透明度表达分隔线，避免边框随文字色变化。 */
    border-block-end: 1px solid rgb(0 0 0 / 12%);
  }

  .utility-bar__list {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .utility-bar__item {
    min-width: 0;
  }

  .utility-bar__link,
  .utility-bar__text {
    display: flex;
    align-items: center;
    /* 触摸目标 ≥ 44×44（AGENTS §8） */
    min-block-size: 44px;
    font-size: 0.8125rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .utility-bar__link:hover,
  .utility-bar__link:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .utility-bar__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  /* 桌面才显示（O-2：本期启用，移动端隐藏） */
  @media screen and (min-width: 990px) {
    .utility-bar {
      display: block;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.utility_bar",
  "blocks": [
    {
      "type": "utility_item",
      "name": "t:labels.utility_item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:labels.text"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:labels.link"
        }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "t:general.utility_bar",
      "blocks": [
        {
          "type": "utility_item"
        }
      ]
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
