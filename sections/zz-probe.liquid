{%- comment -%}
  A4 探针（临时）—— 测 pages[handle] 单条访问成本。
  用完必须删除：本文件 + templates/page.json 中 probe-a/b/c 三段配置。
  说明见 dev-docs/spike-a4.md。
{%- endcomment -%}

{%- if section.settings.access_pages -%}
  {%- if section.settings.existing_handle == blank -%}
    {%- for i in (1..5000) -%}{%- assign probe = pages['zz-nonexistent-handle-a4'] -%}{%- endfor -%}
  {%- else -%}
    {%- for i in (1..5000) -%}{%- assign probe = pages[section.settings.existing_handle] -%}{%- endfor -%}
  {%- endif -%}
{%- else -%}
  {%- for i in (1..5000) -%}{%- assign probe = 1 -%}{%- endfor -%}
{%- endif -%}
<span hidden data-a4-probe="{{ probe | default: 'nil' }}"></span>

{% schema %}
{
  "name": "ZZ Probe A4",
  "settings": [
    {
      "type": "checkbox",
      "id": "access_pages",
      "default": false,
      "label": "访问 pages 对象"
    },
    {
      "type": "text",
      "id": "existing_handle",
      "label": "已知存在的页面 handle（留空则查不存在的）"
    }
  ]
}
{% endschema %}
