{% comment %}
  product-description — 产品页「Overview」富文本区（task-product T-2.5）。

  **独立分区**（2026-11-02 刘工）：与 `product-supplies` 同一套形态——section 标题 +
  内容，纯垂直平铺、无 tab、无锚点条、无 JS。2026-10-29 曾与 Specifications 合并成
  `product-tabs` 的两个 tab（含吸顶标题栏），现已拆回两个独立 section；
  整页顺序 Overview → Specifications → Supplies，顺序交给编辑器拖动。

  · 标题走 section setting，留空回退 `sections.product_description.default_heading`（Overview）
  · 左列 `product.description` 富文本，右列 image_picker 配图（尊重焦点）
  · 图片留空 → 单栏全宽；描述为空 → 整个 section 不输出（不留空壳）
  · `id="product-overview"` 保留作深链落点

  样式归属本 section（`{% stylesheet %}` 顶层）：标题字号 1.25rem / 500、
  段距 2rem，与 `product-spec-table` / `product-supplies` 对齐，页面读起来是
  「同级标题 + 内容」的垂直节奏。
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.product_description.default_heading' | t
  endif

  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

{%- if product.description != blank -%}
  <section
    class="product-description{% if has_image %} product-description--split{% endif %}"
    id="product-overview"
    data-reveal
  >
    <h2 class="product-description__heading">{{ heading }}</h2>

    <div class="product-description__inner">
      <div class="product-description__text">
        <div class="product-description__rte">
          {{ product.description }}
        </div>
      </div>

      {%- if has_image -%}
        <div class="product-description__media">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '400,600,900',
              sizes: '(min-width: 1100px) 40vw, 100vw',
              class: 'product-description__img',
              alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-description {
    padding-block: 2rem 0;
  }
  /* 分块标题：Overview / Specifications / Supplies 三块同字号，见文件头注释 */
  .product-description__heading {
    margin: 0 0 1rem;
    font-size: 1.25rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .product-description__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  /* 有配图才两栏（参考稿的「左文右图」编辑式排版）；无图单栏全宽 */
  @media (min-width: 990px) {
    .product-description--split .product-description__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .product-description__rte {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-foreground-muted);
  }
  .product-description__rte > :first-child {
    margin-block-start: 0;
  }
  .product-description__rte > :last-child {
    margin-block-end: 0;
  }
  .product-description__rte :is(h2, h3, h4) {
    margin-block: 1.25rem 0.5rem;
    color: var(--color-foreground);
    font-weight: 500;
    line-height: 1.35;
  }
  .product-description__rte img {
    max-width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs);
  }
  .product-description__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--style-border-radius-inputs) * 1.5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_description.name",
  "tag": "div",
  "class": "product-description-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.product_description.default_heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.product_description.image"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_description.name"
    }
  ]
}
{% endschema %}
