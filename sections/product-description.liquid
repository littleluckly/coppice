{% comment %}
  product-description — 富文本描述（task-product T-2.5）。

  效果图是「左文右图」的编辑式两栏：左侧 product.description 富文本，右侧一张场景图。
  图片走 section setting（image_picker），商家不传就单栏全宽——不占位、不留空格子。
  描述为空则整个 section 不渲染。

  `id="product-overview"` 是锚点条的落点之一（product-anchor-nav），改 id 前先搜引用。
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'sections.product_description.default_heading' | t
  endif
  assign has_image = false
  if section.settings.image != blank
    assign has_image = true
  endif
-%}

{%- if product.description != blank -%}
  <section
    class="product-description{% if has_image %} product-description--split{% endif %}"
    id="product-overview"
    data-reveal
  >
    <div class="product-description__inner">
      <div class="product-description__text">
        <h2 class="product-description__heading">{{ heading }}</h2>
        <div class="product-description__rte">
          {{ product.description }}
        </div>
      </div>
      {%- if has_image -%}
        <div class="product-description__media">
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              widths: '400,600,900',
              sizes: '(min-width: 1100px) 40vw, 100vw',
              class: 'product-description__img',
              alt: section.settings.image.alt
          }}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .product-description {
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: var(--page-margin);
    padding-block: 2rem 0;
  }
  .product-description__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  @media (min-width: 990px) {
    .product-description--split .product-description__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
    }
  }
  .product-description__heading {
    margin: 0 0 0.75rem;
    font-size: 1.35rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .product-description__rte {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-foreground-muted);
  }
  .product-description__rte > :first-child {
    margin-block-start: 0;
  }
  .product-description__rte > :last-child {
    margin-block-end: 0;
  }
  .product-description__rte :is(h2, h3, h4) {
    margin-block: 1.25rem 0.5rem;
    color: var(--color-foreground);
    font-weight: 500;
    line-height: 1.35;
  }
  .product-description__rte img {
    max-width: 100%;
    height: auto;
    border-radius: var(--style-border-radius-inputs);
  }
  .product-description__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--style-border-radius-inputs) * 1.5);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.product_description.name",
  "tag": "div",
  "class": "product-description-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.product_description.default_heading"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.product_description.image"
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_description.name"
    }
  ]
}
{% endschema %}
