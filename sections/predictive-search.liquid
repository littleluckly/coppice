{% comment %}
  Predictive search RESULTS markup — re-rendered by Shopify's Section Rendering API.

  Do not put the search input in this file. It exists for one reason: when the JS
  requests `search/suggest?section_id=…&predictive_search=true`, Shopify re-renders
  THIS section with `predictive_search.performed == true` and returns its HTML,
  which the script injects into the panel.

  Split from snippets/predictive-search-entry.liquid because a section cannot be
  rendered into another file. main-nav renders the snippet for the input; this file
  only ever produces the results fragment — so it carries its own styles, since the
  caller is not part of the response.

  Endpoint parameters (verified against the Predictive Search API reference):
    q                    — required
    section_id           — returns this section's HTML
    predictive_search    — required for predictive_search to populate
    resources[type]      — product, collection, page, article, query (comma separated)
    resources[limit]     — 1..10

  Fields are minimal on purpose (AGENTS §7): titles and prices only, never body
  HTML. `body` is explicitly discouraged for multi-language stores because it mixes
  translations.

  "No results → hide the panel" lives in the JS, not here: an empty fragment means
  "close", so no markup is shipped for that case.
{% endcomment %}

{%- if predictive_search.performed -%}
  {%- if predictive_search.resources.products.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.products' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for product in predictive_search.resources.products -%}
        {%- liquid
          # 折扣百分比：与产品详情页同一算法（main-product.liquid 顶部同款），
          # 只在 compare_at_price 真的高于 price 时才成立 —— 不能拿两个字段
          # 是否存在来判断，否则"原价已过期/填反了"会算出 0% 或负数徽标。
          assign has_discount = false
          assign save_percent = 0
          if product.compare_at_price > product.price
            assign has_discount = true
            assign price_diff = product.compare_at_price | minus: product.price
            assign save_percent = price_diff | times: 100.0 | divided_by: product.compare_at_price | round
          endif
        -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-p{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ product.url }}" tabindex="-1">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 112
                | image_tag: loading: 'lazy', widths: '112, 224', sizes: '112px', alt: product.featured_image.alt
              }}
            {%- endif -%}
            <span class="predictive-search__text">
              <span class="predictive-search__title">
                {{ product.title | highlight: predictive_search.terms }}
              </span>
              {%- comment -%}
                价格三件套（2026-10-29 刘工：对齐产品详情页）——现价 / 划线原价 / 折扣百分比。
                折扣缺数据时只出现现价，不留空位、不显示 0%（AGENTS §6）。
                `s` 的语义由 PDP 延续：视觉划线，读屏按普通文本读（与详情页一致）。
              {%- endcomment -%}
              <span class="predictive-search__price">
                <span class="predictive-search__price-current">
                  {%- if product.price_varies -%}
                    {{ 'products.product.from_price_html' | t }} {{ product.price_min | money }}
                  {%- else -%}
                    {{ product.price_min | money }}
                  {%- endif -%}
                </span>
                {%- if has_discount -%}
                  <s class="predictive-search__price-compare">{{ product.compare_at_price | money }}</s>
                  <span class="predictive-search__price-save">
                    {{- 'products.product.save_percent' | t: percent: save_percent -}}
                  </span>
                {%- endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.collections.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.collections' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for collection in predictive_search.resources.collections -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-c{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ collection.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.pages.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.pages' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for page in predictive_search.resources.pages -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-g{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ page.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ page.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.articles.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.articles' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for article in predictive_search.resources.articles -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-a{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ article.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ article.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- comment -%}
    官方 UX 要求：始终提供"查看全部结果"出口，
    这样即使联想没命中，顾客也不会被困在输入框里。
  {%- endcomment -%}
  <div class="predictive-search__footer">
    <a
      class="predictive-search__all"
      href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}"
    >
      {{ 'search.view_all' | t: terms: predictive_search.terms }}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  /* ---- 结果列表视觉（2026-10-10 刘工：极简 / 高端 / 沉浸式 / 工业力量感） ----
     无卡片无底色：靠字号层级 + 发丝线 + 大留白分区；
     分组标签 = 小号大写大字距（工业感），与抽屉标题同款；
     命中词加重而非黄底色块（去掉 mark 高亮块的"促销感"）；
     商品图微降饱和，hover 恢复（机械图先给人"冷"的重量感）；
     结果逐项淡入（沉浸式），respect prefers-reduced-motion。 */

  .predictive-search__heading {
    margin: 0;
    padding: 1.5rem 1.5rem 0.625rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    /* 2026-10-29：从 foreground 派生（原 rgb(0 0 0 / 45%) 在深色骨架下不可见，BUG-059） */
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .predictive-search__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__link {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1.5rem;
    color: inherit;
    text-decoration: none;
    /* 发丝线分区：组与组之间靠 heading 上的留白区分，行间用细线 */
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }

  .predictive-search__link img {
    flex: 0 0 auto;
    inline-size: 112px;
    block-size: 112px;
    object-fit: cover;
    filter: grayscale(25%);
    transition: filter 0.2s ease;
  }

  .predictive-search__link:hover img,
  .predictive-search__link:focus-visible img {
    filter: none;
  }

  /* 选中项必须有可见变化，不能只靠颜色（SDD §8.2）。
     hover 底色：品牌色 8% 透明淡染（2026-10-10 刘工）——用 color-mix
     从 --color-brand 现派生，商家换主题色时自动跟随，不硬编码色值 */
  .predictive-search__item[aria-selected='true'] .predictive-search__link,
  .predictive-search__link:hover {
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
  }

  .predictive-search__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .predictive-search__text {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    min-inline-size: 0;
  }

  .predictive-search__title {
    font-size: 1rem;
    letter-spacing: 0.01em;
  }

  .predictive-search__link:hover .predictive-search__title,
  .predictive-search__item[aria-selected='true'] .predictive-search__title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  /* 价格三件套（2026-10-29 刘工：对齐产品详情页的现价 / 划线原价 / 折扣徽标）。
     抽屉行窄（360px 抽屉里文字列只剩 ~180px），所以全部按行内小字缩放，
     不做 PDP 的 1.75rem 大价；换行由 flex-wrap 兜住，徽标绝不裁切。
     配色全走令牌：划线价用 muted（页头组已按骨架色重算，Noir 下不会消失），
     徽标用 --color-sale / --color-sale-surface（与 PDP 同一组值，4.91:1）。 */
  .predictive-search__price {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
    font-variant-numeric: tabular-nums;
  }

  .predictive-search__price-current {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-brand);
  }

  .predictive-search__price-compare {
    font-size: 0.75rem;
    color: var(--color-foreground-muted);
  }

  .predictive-search__price-save {
    padding: 2px 7px;
    border-radius: 999px;
    background-color: var(--color-sale-surface);
    color: var(--color-sale);
    font-size: 0.6875rem;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* 命中词：加重代替色块（极简、去促销感） */
  .predictive-search mark {
    background-color: transparent;
    color: inherit;
    font-weight: 700;
  }

  /* View all 钉底（2026-10-10 刘工）：sticky bottom——列表可滚时它
     常驻面板可视区底边（自带底色，滚过的内容不透出），列表不足一屏时
     呆在自然位置（列表底部），两种情况都不会超出 dialog 下边缘 */
  .predictive-search__footer {
    position: sticky;
    bottom: 0;
    background-color: var(--color-background);
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }

  /* View all：通栏行 + 行尾箭头（AGENTS §6 箭头准则允许的两类位置之一） */
  .predictive-search__all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    min-block-size: 48px;
    padding: 0.875rem 1.5rem;
    color: inherit;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }

  .predictive-search__all::after {
    content: '→';
    font-size: 1rem;
  }

  .predictive-search__all:hover,
  .predictive-search__all:focus-visible {
    background-color: color-mix(in srgb, var(--color-brand) 8%, transparent);
  }

  /* 结果逐项浮现：上限 8 项做阶梯延迟，余项统一第三档 */
  .predictive-search__item {
    animation: predictive-search-item-in 0.3s ease backwards;
  }

  .predictive-search__item:nth-child(1) {
    animation-delay: 0.03s;
  }
  .predictive-search__item:nth-child(2) {
    animation-delay: 0.06s;
  }
  .predictive-search__item:nth-child(3) {
    animation-delay: 0.09s;
  }
  .predictive-search__item:nth-child(4) {
    animation-delay: 0.12s;
  }
  .predictive-search__item:nth-child(5) {
    animation-delay: 0.15s;
  }
  .predictive-search__item:nth-child(6) {
    animation-delay: 0.18s;
  }
  .predictive-search__item:nth-child(n + 7) {
    animation-delay: 0.21s;
  }

  @keyframes predictive-search-item-in {
    from {
      opacity: 0;
      translate: 0 6px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .predictive-search__item {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.predictive_search",
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
