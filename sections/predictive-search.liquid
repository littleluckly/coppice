{% comment %}
  Predictive search RESULTS markup — re-rendered by Shopify's Section Rendering API.

  Do not put the search input in this file. It exists for one reason: when the JS
  requests `search/suggest?section_id=…&predictive_search=true`, Shopify re-renders
  THIS section with `predictive_search.performed == true` and returns its HTML,
  which the script injects into the panel.

  Split from snippets/predictive-search-entry.liquid because a section cannot be
  rendered into another file. main-nav renders the snippet for the input; this file
  only ever produces the results fragment — so it carries its own styles, since the
  caller is not part of the response.

  Endpoint parameters (verified against the Predictive Search API reference):
    q                    — required
    section_id           — returns this section's HTML
    predictive_search    — required for predictive_search to populate
    resources[type]      — product, collection, page, article, query (comma separated)
    resources[limit]     — 1..10

  Fields are minimal on purpose (AGENTS §7): titles and prices only, never body
  HTML. `body` is explicitly discouraged for multi-language stores because it mixes
  translations.

  "No results → hide the panel" lives in the JS, not here: an empty fragment means
  "close", so no markup is shipped for that case.
{% endcomment %}

{%- if predictive_search.performed -%}
  {%- if predictive_search.resources.products.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.products' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for product in predictive_search.resources.products -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-p{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ product.url }}" tabindex="-1">
            {%- if product.featured_image -%}
              {{
                product.featured_image
                | image_url: width: 80
                | image_tag:
                  loading: 'lazy',
                  widths: '40, 80',
                  sizes: '40px',
                  alt: product.featured_image.alt
              }}
            {%- endif -%}
            <span class="predictive-search__text">
              <span class="predictive-search__title">
                {{ product.title | highlight: predictive_search.terms }}
              </span>
              <span class="predictive-search__price">
                {%- if product.price_varies -%}
                  {{ 'products.product.from_price_html' | t }}
                  {{ product.price_min | money }}
                {%- else -%}
                  {{ product.price_min | money }}
                {%- endif -%}
              </span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.collections.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.collections' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for collection in predictive_search.resources.collections -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-c{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ collection.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ collection.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.pages.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.pages' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for page in predictive_search.resources.pages -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-g{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ page.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ page.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- if predictive_search.resources.articles.size > 0 -%}
    <h3 class="predictive-search__heading">
      {{ 'search.articles' | t }}
    </h3>
    <ul class="predictive-search__list" role="list">
      {%- for article in predictive_search.resources.articles -%}
        <li
          class="predictive-search__item"
          role="option"
          id="predictive-search-option-a{{ forloop.index }}"
          aria-selected="false"
        >
          <a class="predictive-search__link" href="{{ article.url }}" tabindex="-1">
            <span class="predictive-search__title">{{ article.title }}</span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}

  {%- comment -%}
    官方 UX 要求：始终提供"查看全部结果"出口，
    这样即使联想没命中，顾客也不会被困在输入框里。
  {%- endcomment -%}
  <div class="predictive-search__footer">
    <a
      class="predictive-search__all"
      href="{{ routes.search_url }}?q={{ predictive_search.terms | url_encode }}"
    >
      {{ 'search.view_all' | t: terms: predictive_search.terms }}
    </a>
  </div>
{%- endif -%}

{% stylesheet %}
  .predictive-search__heading {
    margin: 0;
    padding: 0.75rem 0.75rem 0.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgb(0 0 0 / 60%);
  }

  .predictive-search__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .predictive-search__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 44px;
    padding: 0.5rem 0.75rem;
    color: inherit;
    text-decoration: none;
  }

  .predictive-search__link img {
    flex: 0 0 auto;
    inline-size: 40px;
    block-size: 40px;
    object-fit: cover;
    border-radius: 2px;
  }

  /* 选中项必须有可见变化，不能只靠颜色（SDD §8.2） */
  .predictive-search__item[aria-selected='true'] .predictive-search__link,
  .predictive-search__link:hover {
    background-color: rgb(0 0 0 / 5%);
    outline: 1px solid currentColor;
    outline-offset: -1px;
  }

  .predictive-search__text {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  .predictive-search__title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .predictive-search__price {
    font-size: 0.8125rem;
    color: rgb(0 0 0 / 60%);
  }

  .predictive-search__footer {
    border-block-start: 1px solid rgb(0 0 0 / 8%);
  }

  .predictive-search__all {
    display: flex;
    align-items: center;
    min-block-size: 44px;
    padding: 0.5rem 0.75rem;
    color: inherit;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .predictive-search__all:hover,
  .predictive-search__all:focus-visible {
    background-color: rgb(0 0 0 / 5%);
  }

  .predictive-search mark {
    background-color: rgb(255 214 0 / 45%);
    color: inherit;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.predictive_search",
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
