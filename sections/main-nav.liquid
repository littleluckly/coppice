    border: 0;
    cursor: pointer;
  }

  .nav-drawer__close svg,
  .nav-drawer__search svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .nav-drawer__close:focus-visible,
  .nav-drawer__search:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
    border-radius: 2px;
  }

  .nav-drawer__list {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0.5rem 0;
    list-style: none;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .nav-drawer__item {
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .nav-drawer__item:last-child {
    border-block-end: 0;
  }

  .nav-drawer__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
    min-height: 48px;
    padding: 0.75rem 1rem;
    color: inherit;
    font: inherit;
    font-weight: 600;
    text-align: start;
    text-decoration: none;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav-drawer__link svg {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
  }

  .nav-drawer__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }

  .nav-drawer__link--sub {
    min-height: 44px;
    padding: 0.5rem 1rem 0.5rem 2rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .nav-drawer__sublist--deep .nav-drawer__link--sub {
    padding-inline-start: 2.75rem;
    font-size: 0.875rem;
  }

  .nav-drawer__link--current {
    color: var(--color-brand);
    font-weight: 700;
    background-color: color-mix(in srgb, var(--color-brand) 10%, transparent);
  }

  .nav-drawer__footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    margin-block-start: auto;
    padding: 0;
    border-block-start: 1px solid color-mix(in srgb, var(--color-foreground) 12%, transparent);
  }

  .account--in-drawer .account__component {
    --shopify-account-dialog-position-top: 0;
  }

  .account--in-drawer {
    padding: 0.5rem 1rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 8%, transparent);
  }

  .cart-entry--in-drawer .cart-entry__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 48px;
    padding: 0.75rem 1rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .cart-entry--in-drawer .cart-entry__label {
    flex: 1;
  }

  @media screen and (max-width: 989px) {
    .main-nav__desktop {
      display: none;
    }

    .main-nav__mobile {
      display: flex;
      align-items: center;

      padding-block: 1rem;

      padding-inline: var(--page-margin);
      background-color: var(--color-header-surface);
      box-shadow: var(--header-shadow);
    }

    .main-nav__search-toggle--mobile {
      margin-inline-start: auto;
    }

    .main-nav__mobile .cart-entry {
      margin-inline-start: 0.35rem;
    }

    .main-nav__burger {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 44px;
      height: 44px;
      padding: 0;
      color: inherit;
      background: none;
      border: 0;
      cursor: pointer;
    }

    .main-nav__burger svg {
      width: 1.5rem;
      height: 1.5rem;
    }
  }

  .main-nav-section {
    position: sticky;
    top: 0;
    z-index: 20;
  }

  @media screen and (min-width: 990px) {

    .main-nav-section.is-stuck .main-nav__desktop {
      box-shadow: var(--header-shadow);
    }

    .main-nav__desktop {
      display: block;
    }
  }

  .cart-entry__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    min-inline-size: 44px;
    min-block-size: 44px;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .cart-entry__link svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .cart-entry__count {
    position: absolute;
    inset-block-start: 2px;
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;

    min-inline-size: 1.125rem;
    block-size: 1.125rem;
    padding-inline: 0.25rem;
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-background);
    background-color: var(--color-brand);
    border-radius: 999px;
  }

  .cart-entry--in-drawer .cart-entry__count {
    position: static;
    inset: auto;
  }

  .cart-entry__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  compare-entry {
    display: inline-flex;
  }

  compare-entry[hidden] {
    display: none;
  }

  compare-entry[data-pending] {
    visibility: hidden;
  }

  .compare-entry__link {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;

    min-inline-size: 44px;
    min-block-size: 44px;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .compare-entry__link svg {
    inline-size: 1.5rem;
    block-size: 1.5rem;
  }

  .compare-entry__link[aria-disabled='true'] {
    opacity: 0.4;
    pointer-events: none;
  }

  .compare-entry__count {
    position: absolute;
    inset-block-start: 2px;
    inset-inline-end: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 1.125rem;
    block-size: 1.125rem;
    padding-inline: 0.25rem;
    font-size: 0.6875rem;
    line-height: 1;
    color: var(--color-background);
    background-color: var(--color-brand);
    border-radius: 999px;
  }

  .compare-entry__count[hidden] {
    display: none;
  }

  .compare-entry__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .compare-entry--in-drawer {
    display: block;
  }

  .compare-entry--in-drawer .compare-entry__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-block-size: 48px;
    padding: 0.75rem 1rem;
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .compare-entry--in-drawer .compare-entry__label {
    flex: 1;
  }

  .compare-entry--in-drawer .compare-entry__count {
    position: static;
    inset: auto;
  }

  compare-entry[data-empty]:not(.compare-entry--in-drawer) .compare-entry__link {
    color: var(--color-foreground-muted);
  }

  @media (hover: hover) {
    compare-entry[data-empty]:not(.compare-entry--in-drawer) .compare-entry__link:hover {
      color: var(--color-foreground);
    }
  }

  ui-tooltip:has(> .compare-entry[hidden]) {
    display: none;
  }

  .account {
    display: flex;
    align-items: center;
  }

  .account__component {
    --shopify-account-avatar-size: 1.75rem;
    --shopify-account-radius-base: var(--style-border-radius-inputs);
    --shopify-account-color-accent: var(--color-brand);
    --shopify-account-color-background: var(--color-background);
    --shopify-account-color-text: var(--color-foreground);
    --shopify-account-font-body: var(--font-primary--family);
    --shopify-account-font-heading: var(--font-primary--family);

    --shopify-account-dialog-position-top: 3.5rem;
  }

  .account__component::part(signed-out-avatar) {
    position: relative;
  }

  .account__component::part(signed-out-avatar)::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 50%;
    inline-size: 44px;
    block-size: 44px;
    translate: -50% -50%;
  }

  .account__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 1.75rem;
    block-size: 1.75rem;

    color: var(--color-foreground);
  }

  .account__avatar svg {
    inline-size: 100%;
    block-size: 100%;
  }

  .account__follow {
    display: flex;
    align-items: center;
  }

  .predictive-search {
    position: relative;
    display: flex;
    flex-direction: column;
    inline-size: 100%;
    flex: 1;

    min-height: 0;
  }

  .predictive-search__form {
    position: relative;
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .predictive-search__field {
    position: relative;
    flex: none;
  }

  .predictive-search__submit {
    position: absolute;
    inset-inline-start: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;

    inline-size: 44px;
    block-size: 44px;
    padding: 0;

    inset-block-start: 50%;
    translate: 0 -50%;

    color: color-mix(in srgb, var(--color-foreground) 45%, transparent);
    background: none;
    border: 0;
    cursor: pointer;
    pointer-events: none;
  }

  .predictive-search__submit svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .predictive-search__input {
    inline-size: 100%;

    min-block-size: 48px;
    padding: 0.625rem 2.75rem 0.625rem 2.75rem;
    color: var(--color-foreground);
    background-color: var(--color-background);

    border: 0;
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 25%, transparent);
    border-radius: 0;
    font: inherit;
    font-size: 1.0625rem;
    appearance: none;
  }

  .predictive-search__input::-webkit-search-cancel-button,
  .predictive-search__input::-webkit-search-decoration {
    -webkit-appearance: none;
    appearance: none;
  }

  .predictive-search__input::placeholder {
    color: color-mix(in srgb, var(--color-foreground) 40%, transparent);
  }

  .predictive-search__input:focus {
    outline: none;
    border-block-end: 2px solid var(--color-brand-accent);
    padding-block-end: calc(0.625rem - 1px);
  }

  .predictive-search__field::after {
    content: '';
    position: absolute;
    inset-block-end: 0;
    inset-inline-start: 0;
    inline-size: 35%;
    block-size: 2px;
    background-color: var(--color-brand-accent);
    opacity: 0;
    pointer-events: none;
  }

  .predictive-search[aria-busy='true'] .predictive-search__field::after {
    opacity: 1;
    animation: predictive-search-sweep 0.9s ease-in-out infinite;
  }

  @keyframes predictive-search-sweep {
    0% {
      translate: 0 0;
    }
    50% {
      translate: 186% 0;
    }
    100% {
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .predictive-search[aria-busy='true'] .predictive-search__field::after {
      animation: none;
      inline-size: 100%;
      opacity: 0.4;
    }
  }

  .predictive-search__clear {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-end: 0;
    translate: 0 -50%;
    display: flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .predictive-search__clear[hidden] {
    display: none;
  }

  .predictive-search__clear svg {
    inline-size: 1.25rem;
    block-size: 1.25rem;
  }

  .predictive-search__clear:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
    border-radius: 2px;
  }

  .predictive-search__panel {
    flex: 1;
    min-height: 0;
    margin-block-start: 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    background-color: var(--color-background);
  }

  .predictive-search__panel[hidden] {
    display: none;
  }

  .predictive-search__skeleton {
    padding-block-end: 0.75rem;
  }

  .predictive-search__skeleton-heading,
  .predictive-search__skeleton-thumb,
  .predictive-search__skeleton-line {
    background-color: color-mix(in srgb, var(--color-foreground) 7%, transparent);
    animation: predictive-search-skeleton-pulse 1.4s ease-in-out infinite;
  }

  .predictive-search__skeleton-heading {
    inline-size: 5rem;
    block-size: 0.5rem;
    margin: 1.5rem 1.5rem 0.75rem;
    border-radius: 3px;
  }

  .predictive-search__skeleton-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.75rem 1.5rem;
    border-block-end: 1px solid color-mix(in srgb, var(--color-foreground) 7%, transparent);
  }

  .predictive-search__skeleton-thumb {
    flex: 0 0 auto;
    inline-size: 112px;
    block-size: 112px;
  }

  .predictive-search__skeleton-text {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.5rem;
    min-inline-size: 0;
  }

  .predictive-search__skeleton-line {
    block-size: 0.625rem;
    inline-size: 70%;
    border-radius: 3px;
  }

  .predictive-search__skeleton-line--short {
    block-size: 0.5rem;
    inline-size: 30%;
  }

  @keyframes predictive-search-skeleton-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.55;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .predictive-search__skeleton-heading,
    .predictive-search__skeleton-thumb,
    .predictive-search__skeleton-line {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.main_nav",
  "class": "main-nav-section",
  "settings": [
    {
      "type": "text",
      "id": "brand_name",
      "label": "t:labels.brand_name",
      "info": "t:labels.brand_name_info"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu",
      "default": "main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_all_series",
      "label": "t:sections.main_nav.labels.show_all_series",
      "info": "t:sections.main_nav.labels.show_all_series_info",
      "default": true
    },
    {
      "type": "text",
      "id": "all_series_label",
      "label": "t:sections.main_nav.labels.all_series_label",
      "default": "All series"
    },
    {
      "type": "select",
      "id": "all_series_position",
      "label": "t:sections.main_nav.labels.all_series_position",
      "info": "t:sections.main_nav.labels.all_series_position_info",
      "options": [
        {
          "value": "first",
          "label": "t:sections.main_nav.options.all_series_position.first"
        },
        {
          "value": "before_last",
          "label": "t:sections.main_nav.options.all_series_position.before_last"
        },
        {
          "value": "last",
          "label": "t:sections.main_nav.options.all_series_position.last"
        }
      ],
      "default": "last"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:labels.customer_account_menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "checkbox",
      "id": "show_follow_on_shop",
      "label": "t:labels.follow_on_shop",
      "default": false
    },
    {
      "type": "range",
      "id": "results_limit",
      "label": "t:labels.results_limit",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "t:general.main_nav"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
