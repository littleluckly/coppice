                  <h3 class="nav-drawer__heading" id="{{ section.id }}-nav-panel-{{ forloop.index }}-title">
                    {{ link.title }}
                  </h3>
                  <button
                    type="button"
                    class="nav-drawer__close"
                    aria-label="{{ 'navigation.close' | t }}"
                    data-nav-drawer-close
