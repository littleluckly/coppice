                  {%- endfor -%}
                </ul>
              </div>
            {%- endif -%}
          {%- endfor -%}

          {%- comment -%} ---- 面板 2：每个二级分组的三层叶子列表 ---- {%- endcomment -%}
          {%- for link in menu.links -%}
            {%- if link.links.size > 0 -%}
              {%- for child in link.links -%}
                {%- if child.links.size > 0 -%}
                  <div
                    class="nav-drawer__panel"
                    data-nav-panel
                    id="{{ section.id }}-nav-panel-{{ forloop.parentloop.index }}-{{ forloop.index }}"
                    aria-labelledby="{{ section.id }}-nav-panel-{{ forloop.parentloop.index }}-{{ forloop.index }}-title"
                  >
                    <div class="nav-drawer__head nav-drawer__head--sub">
                      <button
                        type="button"
                        class="nav-drawer__back"
                        aria-label="{{ 'navigation.back' | t }}"
                        data-nav-back
                      >
                        {{ 'icon-arrow-left.svg' | inline_asset_content }}
                      </button>
                      <h3 class="nav-drawer__heading" id="{{ section.id }}-nav-panel-{{ forloop.parentloop.index }}-{{ forloop.index }}-title">
                        {{ child.title }}
                      </h3>
                      <button
                        type="button"
                        class="nav-drawer__close"
                        aria-label="{{ 'navigation.close' | t }}"
