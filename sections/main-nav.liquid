

{%- liquid
  assign menu = section.settings.menu
  assign brand_name = section.settings.brand_name | default: shop.name

  assign show_series = section.settings.show_all_series
  assign series_label = section.settings.all_series_label
  if series_label == blank
    assign series_label = 'navigation.all_series' | t
  endif
  assign series_position = section.settings.all_series_position | default: 'last'
  assign series_at_end = false
  if series_position == 'last'
    assign series_at_end = true
  endif
  if series_position == 'before_last' and menu.links.size <= 1
    assign series_at_end = true
  endif
  assign series_is_current = false
  if template.name == 'list-collections'
    assign series_is_current = true
  endif
-%}

<nav class="main-nav full-width" aria-label="{{ 'navigation.menu' | t }}">

  <span class="main-nav__bug044-guard" aria-hidden="true">→</span>
  <div class="main-nav__desktop" data-nav-pill-anchor>
    <div class="main-nav__inner">

      <a class="main-nav__logo" href="{{ routes.root_url }}">
        {% render 'brand-logo',
          logo_class: 'main-nav__logo-img',
          logo_width: 160,
          logo_widths: '80, 120, 160, 240',
          logo_sizes: '40px',
          logo_alt: '',
          logo_loading: 'eager'
        %}
        <span class="main-nav__brand">{{ brand_name }}</span>
      </a>

      {%- if menu.links.size > 0 or show_series -%}
        <nav-pill class="main-nav__list-wrap">

          {%- capture series_nav_markup -%}

              <li class="main-nav__item main-nav__item--group main-nav__item--series">

                <a
                  class="main-nav__link main-nav__link--group{% if series_is_current %} main-nav__link--current{% endif %}"
                  href="{{ routes.collections_url }}"
                  aria-haspopup="true"
                  {% if series_is_current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{ series_label | escape }}
                </a>
                <div class="main-nav__mega">
                  <div class="main-nav__mega-inner">

                    <div class="main-nav__mega-nav">
                      <span class="main-nav__mega-label">{{ series_label | escape }}</span>
                      <a
                        class="main-nav__mega-viewall"
                        href="{{ routes.collections_url }}"
                      >
                        {{ 'navigation.view_all_series' | t }}
                        <span class="main-nav__mega-viewall-arrow" aria-hidden="true">→</span>
                      </a>
                    </div>
                    <div class="main-nav__mega-content">

                      <ul class="main-nav__mega-cards main-nav__mega-cards--series" role="list">
                        {%- for series_item in collections -%}
                          {%- if series_item.handle == 'frontpage' -%}
                            {%- continue -%}
                          {%- endif -%}
                          {%- if series_item.all_products_count > 0 -%}

                            {%- assign series_link_current = false -%}
                            {%- if template.name == 'collection' and collection.handle == series_item.handle -%}
                              {%- assign series_link_current = true -%}
                            {%- endif -%}

                            {%- assign series_image = series_item.featured_image -%}
                            <li class="main-nav__mega-card">
                              <a
                                class="main-nav__mega-card-link{% if series_link_current %} main-nav__mega-card-link--current{% endif %}"
                                href="{{ series_item.url }}"
                                {% if series_link_current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                {%- if series_image != blank -%}
                                  <span class="main-nav__mega-card-media">
                                    {{
                                      series_image
                                      | image_url: width: 480
                                      | image_tag:
                                        widths: '160, 240, 320, 480',
                                        sizes: '(min-width: 1200px) 11rem, 14rem',
                                        loading: 'lazy',
                                        alt: '',
                                        class: 'main-nav__mega-card-img'
                                    }}
                                  </span>
                                {%- else -%}
                                  <span
                                    class="main-nav__mega-card-media main-nav__mega-card-media--empty"
                                    aria-hidden="true"
                                  ></span>
                                {%- endif -%}
                                <span class="main-nav__mega-card-title">{{ series_item.title | escape }}</span>
                                <span class="main-nav__mega-card-count">
                                  {{- 'navigation.products_count' | t: count: series_item.all_products_count -}}
                                </span>
                              </a>
                            </li>
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                </div>
              </li>
          {%- endcapture -%}
          <ul class="main-nav__list" role="list">
            {%- for link in menu.links -%}
              {%- liquid
                assign has_children = false
                if link.links.size > 0
                  assign has_children = true
                endif
                assign is_current = false
                if link.current
                  assign is_current = true
                endif
                assign in_branch = false
                if link.child_current or link.child_active
                  assign in_branch = true
                endif

                comment
                  面板形态判定（2026-10-28）：子项撑得起 mega 三栏面板才走 mega——
                  即存在「指向有商品集合的二级项」或「带三级子项的二级项」。
                  子项全是页面/博客链接时（如 Support）走普通下拉，
                  避免 mega 中区一片空白、左列孤零零挂在通栏白底左边。
                endcomment
                assign has_mega_content = false
                if has_children
                  for sub in link.links
                    if sub.links.size > 0
                      assign has_mega_content = true
                      break
                    endif
                    if sub.type == 'collection_link' and sub.object != blank and sub.object.all_products_count > 0
                      assign has_mega_content = true
                      break
                    endif
                  endfor
                endif
              -%}

              {%- if show_series and series_position == 'first' and forloop.first -%}
                {{- series_nav_markup -}}
              {%- endif -%}
              {%- if show_series and series_position == 'before_last' and forloop.last and menu.links.size > 1 -%}
                {{- series_nav_markup -}}
              {%- endif -%}
              <li
                class="main-nav__item{% if in_branch %} main-nav__item--in-branch{% endif %}{% if has_children %}{% if has_mega_content %} main-nav__item--group{% else %} main-nav__item--dropdown{% endif %}{% endif %}"
              >
                {%- if has_children -%}

                  <span class="main-nav__link main-nav__link--group" aria-haspopup="true" tabindex="0">
                    {{ link.title }}
                  </span>

                  {%- if has_mega_content -%}

                  <div class="main-nav__mega">
                    <div class="main-nav__mega-inner">
                      <div class="main-nav__mega-nav">
                        <span class="main-nav__mega-label">{{ link.title }}</span>
                        <ul class="main-nav__mega-cats" role="list">
                          {%- for child in link.links -%}
                            <li class="main-nav__mega-cat">
                              {%- if child.links.size > 0 -%}
                                <span
                                  class="main-nav__mega-cat-link main-nav__mega-cat-link--group{% if child.child_current or child.child_active %} main-nav__mega-cat-link--current{% endif %}"
                                  tabindex="0"
                                  data-mega-tab="{{ forloop.index }}"
                                >
                                  {{ child.title }}
                                </span>
                              {%- else -%}
                                <a
                                  class="main-nav__mega-cat-link{% if child.current %} main-nav__mega-cat-link--current{% endif %}"
                                  href="{{ child.url }}"
                                  tabindex="0"
                                  data-mega-tab="{{ forloop.index }}"
                                  {% if child.current %}
                                    aria-current="page"
                                  {% endif %}
                                >
                                  {{ child.title }}
                                </a>
                              {%- endif -%}
                            </li>
                          {%- endfor -%}
                        </ul>

                        <a
                          class="main-nav__mega-viewall"
                          href="{{ routes.all_products_collection_url }}"
                        >
                          {{ 'navigation.view_all_products' | t }}
                          <span class="main-nav__mega-viewall-arrow" aria-hidden="true">→</span>
                        </a>
                      </div>

                      <div class="main-nav__mega-content">
                        {%- for child in link.links -%}
                          {%- liquid
                            assign mega_collection = blank
                            if child.type == 'collection_link' and child.object != blank
                              assign mega_collection = child.object
                            endif
                          -%}

                          {%- if mega_collection != blank and mega_collection.all_products_count > 0 -%}

                            <div class="main-nav__mega-group" data-mega-panel="{{ forloop.index }}">

                              <div class="main-nav__mega-group-head">
                                <a
                                  class="main-nav__mega-group-title-link"
                                  href="{{ mega_collection.url }}"
                                >
                                  {{
                                    'navigation.all_collection_products'
                                    | t: title: mega_collection.title, total: mega_collection.all_products_count
                                  }}
                                  <span class="main-nav__mega-group-all-arrow" aria-hidden="true">→</span>
                                </a>
                              </div>
                              <ul class="main-nav__mega-cards" role="list">
                                {%- for product in mega_collection.products limit: 3 -%}
                                  <li class="main-nav__mega-card">
                                    <a
                                      class="main-nav__mega-card-link"
                                      href="{{ product.url }}"
                                    >
                                      {%- assign card_image = product.featured_image -%}
                                      {%- if card_image != blank -%}
                                        <span class="main-nav__mega-card-media">
                                          {{
                                            card_image
                                            | image_url: width: 640
                                            | image_tag:
                                              widths: '240, 360, 480, 640',
                                              sizes: '20rem',
                                              loading: 'lazy',
                                              alt: '',
                                              class: 'main-nav__mega-card-img'
                                          }}
                                        </span>
                                      {%- else -%}
                                        <span
                                          class="main-nav__mega-card-media main-nav__mega-card-media--empty"
                                          aria-hidden="true"
                                        ></span>
                                      {%- endif -%}
                                      {%- if product.vendor != blank -%}
                                        <span class="main-nav__mega-card-vendor">{{ product.vendor }}</span>
                                      {%- endif -%}
                                      <span class="main-nav__mega-card-title">{{ product.title }}</span>
                                      <span class="main-nav__mega-card-price">
                                        {{ product.price | money }}
                                      </span>
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                              {%- if child.links.size > 0 -%}
                                <ul class="main-nav__mega-sublinks" role="list">
                                  {%- for grandchild in child.links -%}
                                    <li>
                                      <a
                                        class="main-nav__mega-sublink{% if grandchild.current %} main-nav__mega-sublink--current{% endif %}"
                                        href="{{ grandchild.url }}"
                                        {% if grandchild.current %}
                                          aria-current="page"
                                        {% endif %}
                                      >
                                        {{ grandchild.title }}
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              {%- endif -%}
                            </div>
                          {%- elsif child.links.size > 0 -%}

                            <div class="main-nav__mega-group" data-mega-panel="{{ forloop.index }}">
                              <span class="main-nav__mega-group-title">{{ child.title }}</span>
                              <ul class="main-nav__mega-cards" role="list">
                                {%- for grandchild in child.links -%}
                                  <li class="main-nav__mega-card">
                                    <a
                                      class="main-nav__mega-card-link{% if grandchild.current %} main-nav__mega-card-link--current{% endif %}"
                                      href="{{ grandchild.url }}"
                                      {% if grandchild.current %}
                                        aria-current="page"
                                      {% endif %}
                                    >
                                      {%- if grandchild.type == 'collection_link' and grandchild.object != blank -%}
                                        {%- liquid
                                          assign coll = grandchild.object
                                          assign card_image = coll.featured_image
                                          if card_image == blank
                                            assign card_image = coll.products.first.image
                                          endif
                                        -%}
                                        {%- if card_image != blank -%}
                                          <span class="main-nav__mega-card-media">
                                            {{
                                              card_image
                                              | image_url: width: 640
                                              | image_tag:
                                                widths: '240, 360, 480, 640',
                                                sizes: '20rem',
                                                loading: 'lazy',
                                                alt: '',
                                                class: 'main-nav__mega-card-img'
                                            }}
                                          </span>
                                        {%- else -%}

                                          <span
                                            class="main-nav__mega-card-media main-nav__mega-card-media--empty"
                                            aria-hidden="true"
                                          ></span>
                                        {%- endif -%}
                                        <span class="main-nav__mega-card-title">{{ grandchild.title }}</span>
                                        {%- if coll.all_products_count > 0 -%}
                                          <span class="main-nav__mega-card-count">
                                            {{ 'navigation.products_count' | t: count: coll.all_products_count }}
                                          </span>
                                        {%- endif -%}
                                      {%- else -%}

                                        <span
                                          class="main-nav__mega-card-media main-nav__mega-card-media--empty"
                                          aria-hidden="true"
                                        ></span>
                                        <span class="main-nav__mega-card-title">{{ grandchild.title }}</span>
                                      {%- endif -%}
                                    </a>
                                  </li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>

                    </div>
                  </div>
                  {%- else -%}

                    <div class="main-nav__dropdown">
                      <ul class="main-nav__dropdown-list" role="list">
                        {%- for child in link.links -%}
                          <li>
                            <a
                              class="main-nav__dropdown-link{% if child.current %} main-nav__dropdown-link--current{% endif %}"
                              href="{{ child.url }}"
                              {% if child.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ child.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endif -%}
                {%- else -%}

                  <a
                    class="main-nav__link{% if is_current %} main-nav__link--current{% endif %}"
                    href="{{ link.url }}"
                    {% if is_current %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{ link.title }}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if show_series and series_at_end -%}
              {{- series_nav_markup -}}
            {%- endif -%}

          </ul>
        </nav-pill>
      {%- endif -%}

      <div class="main-nav__tools">
        <button
          type="button"
          class="main-nav__search-toggle"
          aria-label="{{ 'search.label' | t }}"
          aria-haspopup="dialog"
          data-search-drawer-open
        >
          {{ 'icon-search.svg' | inline_asset_content }}
        </button>

        {% render 'account-entry', menu: section.settings.customer_account_menu %}

        <ui-tooltip placement="bottom" label="{{ 'compare.entry_tip' | t }}">
          {% render 'compare-entry' %}
        </ui-tooltip>
        {% render 'cart-entry' %}

        {%- if section.settings.show_follow_on_shop and shop.customer_accounts_enabled -%}
          <div class="account__follow">
            {{ shop | login_button }}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="main-nav__mobile">
    <button
      type="button"
      class="main-nav__burger"
      aria-label="{{ 'navigation.menu' | t }}"
      aria-haspopup="dialog"
      data-nav-drawer-open
    >
      {{ 'icon-menu.svg' | inline_asset_content }}
    </button>

    <button
      type="button"
      class="main-nav__search-toggle main-nav__search-toggle--mobile"
      aria-label="{{ 'search.label' | t }}"
      aria-haspopup="dialog"
      data-search-drawer-open
    >
      {{ 'icon-search.svg' | inline_asset_content }}
    </button>

    {% render 'cart-entry', class: 'cart-entry--mobile' %}
  </div>

  <nav-drawer>

    <bottom-sheet>
      <dialog class="nav-drawer" data-nav-drawer scroll-lock aria-labelledby="nav-drawer-title">

        <template data-nav-drawer-template>

          <div class="nav-drawer__grabber" aria-hidden="true"></div>

          <div class="nav-drawer__head nav-drawer__head--root">

            <a class="nav-drawer__brand" href="{{ routes.root_url }}">

              {% render 'brand-logo',
                logo_class: 'nav-drawer__brand-img',
                logo_width: 96,
                logo_widths: '64, 96, 144',
                logo_sizes: '32px',
                logo_alt: '',
                logo_loading: 'lazy'
              %}
              <span class="nav-drawer__brand-name">{{ brand_name }}</span>
            </a>
            <h2 class="nav-drawer__title visually-hidden" id="nav-drawer-title">
              {{ 'navigation.menu' | t }}
            </h2>

            <button
              type="button"
              class="nav-drawer__search"
              aria-label="{{ 'search.label' | t }}"
              data-nav-search
            >
              {{ 'icon-search.svg' | inline_asset_content }}
            </button>
            <button
              type="button"
              class="nav-drawer__close"
              aria-label="{{ 'navigation.close' | t }}"
              data-nav-drawer-close
            >
              {{ 'icon-close.svg' | inline_asset_content }}
            </button>
          </div>

          {%- capture series_drawer_markup -%}
              <li class="nav-drawer__item">
                <a
                  class="nav-drawer__link{% if series_is_current %} nav-drawer__link--current{% endif %}"
                  href="{{ routes.collections_url }}"
                  {% if series_is_current %}
                    aria-current="page"
                  {% endif %}
                >
                  <span>{{ series_label | escape }}</span>
                </a>
              </li>
          {%- endcapture -%}
          <ul class="nav-drawer__list" role="list">
            {%- for link in menu.links -%}
              {%- if show_series and series_position == 'first' and forloop.first -%}
                {{- series_drawer_markup -}}
              {%- endif -%}
              {%- if show_series and series_position == 'before_last' and forloop.last and menu.links.size > 1 -%}
                {{- series_drawer_markup -}}
              {%- endif -%}
              <li class="nav-drawer__item">
                {%- if link.links.size > 0 -%}
                  {%- assign sub_id = section.id | append: '-nav-sub-' | append: forloop.index -%}
                  <button
                    type="button"
                    class="nav-drawer__link nav-drawer__link--group"
                    data-nav-toggle
                    aria-expanded="false"
                    aria-controls="{{ sub_id }}"
                    {% if link.child_current or link.child_active %}data-nav-branch{% endif %}
                  >
                    <span>{{ link.title }}</span>
                    <span class="nav-drawer__chevron" aria-hidden="true">
                      {{ 'icon-chevron-down.svg' | inline_asset_content }}
                    </span>
                  </button>
                  <div class="nav-drawer__sub" id="{{ sub_id }}" inert>
                    <div class="nav-drawer__sub-inner">
                      <ul class="nav-drawer__sublist" role="list">
                        {%- for child in link.links -%}
                          <li class="nav-drawer__item nav-drawer__item--sub">
                            {%- if child.links.size > 0 -%}
                              {%- assign subsub_id = sub_id | append: '-' | append: forloop.index -%}
                              <button
                                type="button"
                                class="nav-drawer__link nav-drawer__link--sub nav-drawer__link--group"
                                data-nav-toggle
                                aria-expanded="false"
                                aria-controls="{{ subsub_id }}"
                                {% if child.child_current or child.child_active %}data-nav-branch{% endif %}
                              >
                                <span>{{ child.title }}</span>
                                <span class="nav-drawer__chevron" aria-hidden="true">
                                  {{ 'icon-chevron-down.svg' | inline_asset_content }}
                                </span>
                              </button>
                              <div class="nav-drawer__sub" id="{{ subsub_id }}" inert>
                                <div class="nav-drawer__sub-inner">
                                  <ul
                                    class="nav-drawer__sublist nav-drawer__sublist--deep"
                                    role="list"
                                  >
                                    {%- for grandchild in child.links -%}
                                      <li class="nav-drawer__item nav-drawer__item--sub">
                                        <a
                                          class="nav-drawer__link nav-drawer__link--sub{% if grandchild.current %} nav-drawer__link--current{% endif %}"
                                          href="{{ grandchild.url }}"
                                          {% if grandchild.current %}
                                            aria-current="page"
                                          {% endif %}
                                        >
                                          <span>{{ grandchild.title }}</span>
                                        </a>
                                      </li>
                                    {%- endfor -%}
                                  </ul>
                                </div>
                              </div>
                            {%- else -%}
                              <a
                                class="nav-drawer__link nav-drawer__link--sub{% if child.current %} nav-drawer__link--current{% endif %}"
                                href="{{ child.url }}"
                                {% if child.current %}
                                  aria-current="page"
                                {% endif %}
                              >
                                <span>{{ child.title }}</span>
                              </a>
                            {%- endif -%}
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                {%- else -%}
                  <a
                    class="nav-drawer__link{% if link.current %} nav-drawer__link--current{% endif %}"
                    href="{{ link.url }}"
                    {% if link.current %}
                      aria-current="page"
                    {% endif %}
                  >
                    <span>{{ link.title }}</span>
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
            {%- if show_series and series_at_end -%}
              {{- series_drawer_markup -}}
            {%- endif -%}

          </ul>

          <div class="nav-drawer__footer">
            {%- if shop.customer_accounts_enabled -%}
              {% render 'account-entry', class: 'account--in-drawer' %}
            {%- endif -%}

            {% render 'compare-entry', class: 'compare-entry--in-drawer', show_label: true %}
            {% render 'cart-entry', class: 'cart-entry--in-drawer', show_label: true %}
          </div>
        </template>
      </dialog>
    </bottom-sheet>
  </nav-drawer>

  <search-drawer>
    <dialog class="search-drawer" data-search-drawer aria-labelledby="search-drawer-title">
      <template data-search-drawer-template>
        <div class="search-drawer__inner">
          <div class="search-drawer__head">
            <h2 class="search-drawer__title" id="search-drawer-title">
              {{ 'search.label' | t }}
            </h2>
            <button
              type="button"
              class="search-drawer__close"
              aria-label="{{ 'navigation.close' | t }}"
              data-search-drawer-close
            >
              {{ 'icon-close.svg' | inline_asset_content }}
            </button>
          </div>

          <div class="search-drawer__body">
            {% render 'predictive-search-entry',
              search_section_id: section.id,
              results_limit: section.settings.results_limit
            %}
          </div>
        </div>
      </template>
    </dialog>
  </search-drawer>

</nav>

<nav-sticky aria-hidden="true"></nav-sticky>

<script src="{{ 'nav-pill.js' | asset_url }}" defer></script>
<script src="{{ 'nav-drawer.js' | asset_url }}" defer></script>
<script src="{{ 'nav-sticky.js' | asset_url }}" defer></script>
<script src="{{ 'predictive-search.js' | asset_url }}" defer></script>
<script src="{{ 'search-drawer.js' | asset_url }}" defer></script>

{% stylesheet %}

  .main-nav__bug044-guard {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .main-nav {
    position: relative;

  }

  .main-nav__inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1.5rem;
    white-space: nowrap;
    max-inline-size: var(--content-width);
    margin-inline: auto;

  }

  .main-nav__logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--color-foreground);
    text-decoration: none;
  }

  .main-nav__logo-img {

    block-size: 2.5rem;
    inline-size: auto;
    max-inline-size: 6rem;
    object-fit: contain;
