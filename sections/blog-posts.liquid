{% comment %}
  Blog posts — 首页选购指南引流（task-index T-2.5，pages-ui §2）。
  文章块 ×3：图（lazy，缺图退化纯文字不裂版）+ 标题 + 日期 + 摘要。
{% endcomment %}

{%- liquid
  assign blog_source = section.settings.blog
  assign limit = section.settings.posts_to_show | default: 3
-%}

{%- if blog_source != blank and blog_source.articles.size > 0 -%}
  <div class="blog-posts">
    {%- if section.settings.heading != blank -%}
      <h2 class="blog-posts__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="blog-posts__grid" role="list">
      {%- for article in blog_source.articles limit: limit -%}
        <li class="blog-posts__item">
          <a class="blog-posts__card" href="{{ article.url }}">
            {%- if article.image != blank -%}
              <span class="blog-posts__media">
                {{
                  article.image
                  | image_url: width: 600
                  | image_tag:
                    widths: '300, 600',
                    sizes: '(min-width: 750px) 20vw, 90vw',
                    width: article.image.width,
                    height: article.image.height,
                    loading: 'lazy',
                    alt: article.image.alt
                }}
              </span>
            {%- endif -%}
            <span class="blog-posts__body">
              <h3 class="blog-posts__title">{{ article.title | escape }}</h3>
              {%- if article.excerpt != blank -%}
                <p class="blog-posts__excerpt">{{ article.excerpt | strip_html | truncate: 90 }}</p>
              {%- elsif article.content != blank -%}
                <p class="blog-posts__excerpt">{{ article.content | strip_html | truncate: 90 }}</p>
              {%- endif -%}
              <span class="blog-posts__read-more">{{ 'sections.blog_posts.read_more' | t }}</span>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

{%- endif -%}

{% stylesheet %}
    .blog-posts__heading {
      font-size: 1.25rem;
      font-weight: 500;
      margin-block-end: 0.75rem;
    }
    .blog-posts__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.75rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    @media (min-width: 750px) {
      .blog-posts__grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .blog-posts__card {
      display: flex;
      gap: 0.9rem;
      height: 100%;
      padding: 0.75rem;
      color: inherit;
      text-decoration: none;
      background-color: rgb(0 0 0 / 4%);
      border-radius: 12px;
    }
    .blog-posts__media {
      flex: 0 0 38%;
    }
    .blog-posts__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      border-radius: 8px;
    }
    .blog-posts__body {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      min-width: 0;
    }
    .blog-posts__title {
      font-size: 1rem;
      font-weight: 500;
      line-height: 1.35;
    }
    .blog-posts__excerpt {
      font-size: 0.85rem;
      color: rgb(0 0 0 / 65%);
    }
    .blog-posts__read-more {
      margin-block-start: auto;
      padding-block-start: 0.25rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-brand-accent);
    }
.blog-posts__read-more {
      margin-block-start: auto;
      padding-block-start: 0.25rem;
      font-size: 0.85rem;
      font-weight: 500;
      color: var(--color-brand-accent);
    }::after {
      content: '\2192';
      margin-inline-start: 0.3rem;
    }
  {% endstylesheet %}


{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "class": "blog-posts-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.blog_posts.defaults.heading"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.posts_to_show",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.name"
    }
  ]
}
{% endschema %}
