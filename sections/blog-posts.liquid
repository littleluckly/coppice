{% comment %}
  Blog posts — 首页选购指南引流（task-index T-2.5，pages-ui §2）。
  文章块 ×3：图（lazy，缺图退化纯文字不裂版）+ 标题 + 日期 + 摘要。
{% endcomment %}

{%- liquid
  assign blog_source = section.settings.blog
  assign limit = section.settings.posts_to_show | default: 3
-%}

{%- if blog_source != blank and blog_source.articles.size > 0 -%}
  <div class="blog-posts">
    {%- if section.settings.heading != blank -%}
      <h2 class="blog-posts__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="blog-posts__grid" role="list">
      {%- for article in blog_source.articles limit: limit -%}
        <li class="blog-posts__item">
          <a class="blog-posts__card" href="{{ article.url }}">
            {%- if article.image != blank -%}
              {{
                article.image
                | image_url: width: 800
                | image_tag:
                  widths: '400, 600, 800',
                  sizes: '(min-width: 750px) 30vw, 90vw',
                  width: article.image.width,
                  height: article.image.height,
                  loading: 'lazy',
                  alt: article.image.alt
              }}
            {%- endif -%}
            <h3 class="blog-posts__title">{{ article.title | escape }}</h3>
            <time class="blog-posts__date" datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
              {{ article.published_at | date: format: 'on_date' }}
            </time>
            {%- if article.excerpt != blank -%}
              <p class="blog-posts__excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
            {%- elsif article.content != blank -%}
              <p class="blog-posts__excerpt">{{ article.content | strip_html | truncate: 120 }}</p>
            {%- endif -%}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>

{%- endif -%}

{% stylesheet %}
    .blog-posts__heading {
      font-size: 1.5rem;
      font-weight: 500;
      margin-block-end: 1rem;
    }
    .blog-posts__grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 1.5rem;
      list-style: none;
      padding: 0;
      margin: 0;
    }
    @media (min-width: 750px) {
      .blog-posts__grid {
        grid-template-columns: repeat(3, 1fr);
      }
    }
    .blog-posts__card {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      height: 100%;
      color: inherit;
      text-decoration: none;
    }
    .blog-posts__card img {
      border-radius: 12px;
      aspect-ratio: 16 / 9;
      object-fit: cover;
    }
    .blog-posts__title {
      font-size: 1.1rem;
      font-weight: 500;
    }
    .blog-posts__date {
      font-size: 0.85rem;
      opacity: 0.7;
    }
    .blog-posts__excerpt {
      font-size: 0.95rem;
      opacity: 0.8;
    }
  {% endstylesheet %}


{% schema %}
{
  "name": "t:sections.blog_posts.name",
  "tag": "section",
  "class": "blog-posts-section",
  "settings": [
    {
      "type": "blog",
      "id": "blog",
      "label": "t:labels.blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.heading",
      "default": "t:sections.blog_posts.defaults.heading"
    },
    {
      "type": "range",
      "id": "posts_to_show",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "t:labels.posts_to_show",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts.name"
    }
  ]
}
{% endschema %}
