

{%- liquid
  assign lookup_group = product.metafields.spec.compare_group.value
  assign lookup_hidden = product.metafields.spec.compare_hidden.value
  assign lookup_emit = false

  if lookup_group != blank and lookup_hidden != 'TRUE'
    assign lookup_group = lookup_group | strip | downcase | remove: '-compare'
    assign lookup_emit = true
  endif
-%}

{%- if lookup_emit -%}
  {%- capture lookup_row_keys -%}{%- render 'compare-row-keys', group: lookup_group -%}{%- endcapture -%}
  {%- assign lookup_row_keys = lookup_row_keys | strip | split: ',' -%}

  {%- capture lookup_values -%}
    {%- for row_key in lookup_row_keys -%}
      {%- capture cell_text -%}{%- render 'compare-cell', product: product, row_key: row_key, as_text: true -%}{%- endcapture -%}
      {{- row_key | json -}}:{{- cell_text | strip | json -}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- capture lookup_json -%}
{"h":{{ product.handle | json }},"g":{{ lookup_group | json }},"v":{ {{- lookup_values -}} }}
  {%- endcapture -%}
  <script type="application/json" data-compare-lookup>{{ lookup_json | strip }}</script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.compare_lookup.name",
  "settings": []
}
{% endschema %}
