

{%- liquid
  assign row_keys_string = 'power_source,operation_type,area_coverage,duty_level,power,weight_kg,noise_db,warranty_months'

  case group
    when 'walk-behind-mower', 'riding-mower'
      assign row_keys_string = 'power_source,operation_type,drive_type,area_coverage,duty_level,cutting_width_mm,power,weight_kg,noise_db,warranty_months'
    when 'chainsaw'
      assign row_keys_string = 'power_source,operation_type,area_coverage,duty_level,bar_length_mm,power,weight_kg,noise_db,warranty_months'
    when 'string-trimmer'
      assign row_keys_string = 'power_source,operation_type,area_coverage,duty_level,cutting_width_mm,power,weight_kg,noise_db,warranty_months'
  endcase
-%}
{{- row_keys_string -}}
