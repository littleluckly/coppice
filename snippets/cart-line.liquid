

{%- if item == blank -%}

{%- else -%}
  {%- liquid
    assign line_product = item.product
    assign line_power = line_product.metafields.spec.power_source.value
    assign line_width = line_product.metafields.spec.cutting_width_mm.value
    assign line_bar = line_product.metafields.spec.bar_length_mm.value

    assign line_shipping_class = line_product.metafields.logistics.shipping_class.value
    assign line_lead_time = line_product.metafields.logistics.lead_time_days.value
    assign line_liftgate = line_product.metafields.logistics.needs_liftgate.value

    assign line_has_price_discount = false
    if item.original_price > item.final_price
      assign line_has_price_discount = true
    endif

    assign line_has_line_discount = false
    if item.original_line_price > item.final_line_price
      assign line_has_line_discount = true
    endif

    assign line_is_oversized = false
    if line_shipping_class == 'Oversized' or line_shipping_class == 'Freight LTL'
      assign line_is_oversized = true
    endif

    comment
      超卖提示：允许超卖、且库存少于本行数量时，告诉顾客其中一部分要等补货。
      三个前提缺一不可——inventory_management 不是 shopify 的商品不跟踪库存，
      这时 inventory_quantity 恒为 0，只判 policy 会把它们全部误标成缺货。
    endcomment
    assign line_variant = item.variant
    assign line_is_backorder = false
    assign line_backorder_available = 0
    if line_variant.inventory_management == 'shopify' and line_variant.inventory_policy == 'continue'
      if line_variant.inventory_quantity < item.quantity
        assign line_is_backorder = true
        assign line_backorder_available = line_variant.inventory_quantity
      endif
    endif

    comment
      官方 Cart page 要求展示 options_with_values。Default Title 是「无选项」的占位值，
      展示它等于在顾客面前写一句 Default Title。
    endcomment
    assign line_has_options = false
    for line_option in item.options_with_values
      if line_option.value != 'Default Title'
        assign line_has_options = true
        break
      endif
    endfor
  -%}

  {%- capture line_meta -%}

    {%- for line_option in item.options_with_values -%}
      {%- if line_option.value != 'Default Title' -%}
        <li>{{ line_option.value | escape }}</li>
      {%- endif -%}
    {%- endfor -%}
    {%- if line_power != blank -%}
      <li>{{ line_power | escape }}</li>
    {%- endif -%}
    {%- if line_has_options == false -%}
      {%- if line_width != blank -%}
        <li>{% render 'spec-value', value: line_width, unit_type: 'length_mm' %}</li>
      {%- elsif line_bar != blank -%}
        <li>{% render 'spec-value', value: line_bar, unit_type: 'length_mm' %}</li>
      {%- endif -%}
    {%- endif -%}
  {%- endcapture -%}

  <div class="cart-line" data-line-key="{{ item.key }}">
    <div class="cart-line__media">
      {%- if item.image -%}
        <a href="{{ item.url }}" tabindex="-1" aria-hidden="true">
          {{
            item.image
            | image_url: width: 288
            | image_tag:
              widths: '96, 144, 192, 288',
              sizes: '96px',
              loading: 'lazy',
              alt: item.image.alt
          }}
        </a>
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'cart-line__placeholder' }}
      {%- endif -%}
    </div>

    <div class="cart-line__info">
      <a class="cart-line__title" href="{{ item.url }}">{{ line_product.title | escape }}</a>

      {%- if line_meta != blank -%}
        <ul class="cart-line__meta" role="list">{{ line_meta }}</ul>
      {%- endif -%}

      {%- if item.selling_plan_allocation != blank -%}
        <p class="cart-line__plan">
          {{- 'cart.selling_plan' | t: name: item.selling_plan_allocation.selling_plan.name -}}
        </p>
      {%- endif -%}

      {%- if line_is_oversized -%}
        <p class="cart-line__logistics">
          <span class="cart-line__logistics-tag">{{ line_shipping_class | escape }}</span>
          {%- if line_liftgate -%}
            <span>{{ 'cart.liftgate_note' | t }}</span>
          {%- endif -%}
          {%- if line_lead_time > 0 -%}
            <span>{{ 'cart.lead_time' | t: days: line_lead_time }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if show_stock and item.variant.available and item.variant.inventory_policy != 'continue' -%}
        <p class="cart-line__stock">{{ 'cart.in_stock' | t }}</p>
      {%- endif -%}

      {%- if line_is_backorder -%}
        <p class="cart-line__backorder">
          {%- if line_backorder_available > 0 -%}
            {{- 'cart.partial_backorder' | t: available: line_backorder_available -}}
          {%- else -%}
            {{- 'cart.backorder' | t -}}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- for line_discount in item.line_level_discount_allocations -%}
        {%- assign line_discount_amount = line_discount.amount | money -%}
        <p class="cart-line__discount">
          {{-
            'cart.line_discount'
            | t: title: line_discount.discount_application.title, amount: line_discount_amount
          -}}
        </p>
      {%- endfor -%}

      <a
        class="cart-line__remove"
        href="{{ item.url_to_remove }}"
        data-cart-remove
        data-line-key="{{ item.key }}"
        aria-label="{{ 'cart.remove_item' | t: title: line_product.title }}"
      >
        {{ 'cart.remove' | t }}
      </a>
    </div>

    <p class="cart-line__price">
      <span class="visually-hidden">{{ 'cart.price' | t }}</span>
      {%- if line_has_price_discount -%}
        <s class="cart-line__price-compare">{{ item.original_price | money }}</s>
        <span class="cart-line__price-current">{{ item.final_price | money }}</span>
      {%- else -%}
        <span class="cart-line__price-current">{{ item.final_price | money }}</span>
      {%- endif -%}

      {%- if item.unit_price_measurement != blank -%}
        {%- assign line_unit_price = item.unit_price | money -%}
        {%- assign line_unit_label = item.unit_price_measurement.reference_value
          | append: item.unit_price_measurement.reference_unit
        -%}
        <span class="cart-line__unit">
          {{- 'cart.unit_price' | t: price: line_unit_price, unit: line_unit_label -}}
        </span>
      {%- endif -%}
    </p>

    <div class="cart-line__qty">
      <button
        type="button"
        class="cart-line__qty-btn"
        data-cart-qty="-1"
        aria-controls="CartLineQty-{{ item.key }}"
        aria-label="{{ 'cart.decrease_quantity' | t }}"
      >
        <span aria-hidden="true">−</span>
      </button>

      <label class="visually-hidden" for="CartLineQty-{{ item.key }}">{{ 'cart.quantity' | t }}</label>
      <input
        id="CartLineQty-{{ item.key }}"
        class="cart-line__qty-input"
        type="number"
        name="updates[]"
        value="{{ item.quantity }}"
        min="0"
        step="1"
        inputmode="numeric"
        data-cart-qty-input
        data-line-key="{{ item.key }}"
      >

      <button
        type="button"
        class="cart-line__qty-btn"
        data-cart-qty="1"
        aria-controls="CartLineQty-{{ item.key }}"
        aria-label="{{ 'cart.increase_quantity' | t }}"
      >
        <span aria-hidden="true">+</span>
      </button>
    </div>

    <p class="cart-line__total">
      <span class="visually-hidden">{{ 'cart.total' | t }}</span>
      {%- if line_has_line_discount -%}
        <s class="cart-line__total-compare">{{ item.original_line_price | money }}</s>
      {%- endif -%}
      <span class="cart-line__total-value">{{ item.final_line_price | money }}</span>
    </p>
  </div>
{%- endif -%}
