{% doc %}
  product-card — 商品卡（首页 featured-collection 与集合页共用，task-index T-1.2）。

  输出（视觉基准：效果图-首页 Featured Products 区；标签行基准 2026-10-16 刘工参考图）：
  图 + 收藏心 + 标题 + 规格横排行（宽·排量·动力源）+ 价格三件套（现价 / 划线原价 /
  折扣胶囊 "Save N%"，2026-10-29 对齐产品详情页）+ 星级
  + 规格标签行（胶囊：电池电压·切割宽·操作方式·动力源）+ Compare。

  纪律：
  - 参数行逐项判空：缺值跳项，分隔符自动正确（li+li::before），不留空位（SDD §5.7）
  - 星级读官方 Product Reviews app 的 reviews.rating / reviews.rating_count metafield；
    app 未装或无数据 → 星级行整个不渲染（不显示 0，Dawn 同款方案）
  - 收藏为 localStorage 版（ib:wishlist:v1，assets/wishlist-toggle.js）：
    本机持久、不跨设备同步——UI 不承诺同步（评估结论 2026-10-09）
  - 对比按钮 spec.compare_hidden == 'TRUE' 或 compare_group 为空 → 不渲染

  @param {product} product - product 对象（必填）
  @param {boolean} lazy - true → 图片 lazy（非首屏）；缺省 false → eager
  @param {boolean} show_width - true → 规格行显示切割宽度（经 spec-value 换算）
  @param {boolean} show_cc - true → 规格行显示排量（cc，不换算）
  @param {boolean} show_power - true → 规格行显示动力源（枚举原样）
  @param {boolean} show_weight - true → 规格行显示整机重量（经 spec-value 换算）
  @param {string} sizes - 图片 sizes 提示，**必传**（theme check 规则：@param 全部必传）。
    调用方按自己的列数估：首页 6 列 '15vw/30vw/45vw'，集合页桌面 3 列 '25vw/32vw/45vw'。
  @param {boolean} quick_add - true → 单变体款渲染快速加购（2026-10-13 拍板：
    仅单变体且 available 渲染；多变体卡不渲染任何 CTA；售罄置灰 disabled；
    无 JS 降级为表单 POST /cart/add；交互由 assets/quick-add.js 的 quick-add 自定义元素接管）
{% enddoc %}

{%- if product != blank -%}
  {%- comment -%} 根节点是 tilt-element 自定义元素（2026-10-17 建、2026-10-20 泛化）：
     hover 3D 倾斜由 assets/tilt-element.js 驱动，配色走 CSS 变量
     （参考 dev-docs/local-assets/product-3d.html）。倾斜目标 = 媒体图，
     触发区 = 媒体盒（与泛化前一致）；无 JS 时仅失去倾斜，卡片照常显示；
     role="article" 补回原生 article 语义。 {%- endcomment -%}
  <tilt-element
    class="product-card"
    role="article"
    data-tilt-target=".product-card__media img"
    data-tilt-area=".product-card__media"
  >
    <div class="product-card__media-wrap">
      <a class="product-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
        {%- if product.featured_image -%}
          {{
            product.featured_image
            | image_url: width: 800
            | image_tag:
              widths: '200, 300, 400, 600, 800',
              sizes: sizes,
              width: product.featured_image.width,
              height: product.featured_image.height,
              loading: lazy,
              alt: product.featured_image.alt
          }}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
        {%- endif -%}
      </a>

      {%- if product.metafields.spec.compare_group.value != blank
        and product.metafields.spec.compare_hidden.value != 'TRUE' -%}
        <button
          type="button"
          class="product-card__wishlist"
          aria-pressed="false"
          data-wishlist-handle="{{ product.handle }}"
          aria-label="{{ 'products.product_card.add_to_wishlist' | t }}"
        >
          <svg class="product-card__heart" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
            <path d="M12 21s-7.5-4.9-10-9.3C.4 8.6 2 4.5 5.7 4.1c2.1-.2 4.1.9 5.3 2.7h2c1.2-1.8 3.2-2.9 5.3-2.7 3.7.4 5.3 4.5 3.7 7.6C19.5 16.1 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.5"/>
          </svg>
        </button>
      {%- endif -%}
    </div>

    <h3 class="product-card__title">
      <a href="{{ product.url }}">{{ product.title | escape }}</a>
    </h3>

    {%- comment -%} 规格横排行：宽 · 排量 · 动力源（缺值跳项，分隔符由 CSS 补） {%- endcomment -%}
    {%- liquid
      assign has_specs = false
      if show_width and product.metafields.spec.cutting_width_mm.value != blank
        assign has_specs = true
      endif
      if show_cc and product.metafields.spec.displacement_cc.value != blank
        assign has_specs = true
      endif
      if show_power and product.metafields.spec.power_source.value != blank
        assign has_specs = true
      endif
      if show_weight and product.metafields.spec.weight_kg.value != blank
        assign has_specs = true
      endif
    -%}
    {%- if has_specs -%}
      <ul class="product-card__specs" role="list">
        {%- if show_width -%}
          {%- assign width_value = product.metafields.spec.cutting_width_mm.value -%}
          {%- if width_value != blank -%}
            <li class="product-card__spec">
              {%- render 'spec-value', value: width_value, unit_type: 'length_mm', spec_class: 'card' -%}
            </li>
          {%- endif -%}
        {%- endif -%}
        {%- if show_cc -%}
          {%- assign cc_value = product.metafields.spec.displacement_cc.value -%}
          {%- if cc_value != blank -%}
            <li class="product-card__spec">{{ cc_value }} cc</li>
          {%- endif -%}
        {%- endif -%}
        {%- if show_power -%}
          {%- assign power_value = product.metafields.spec.power_source.value -%}
          {%- if power_value != blank -%}
            <li class="product-card__spec">{{ power_value }}</li>
          {%- endif -%}
        {%- endif -%}
        {%- if show_weight -%}
          {%- assign weight_value = product.metafields.spec.weight_kg.value -%}
          {%- if weight_value != blank -%}
            <li class="product-card__spec">
              {%- render 'spec-value', value: weight_value, unit_type: 'weight_kg', spec_class: 'card' -%}
            </li>
          {%- endif -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- comment -%}
      价格三件套（2026-10-29 刘工：对齐产品详情页）——现价 / 划线原价 / 折扣百分比。
      现价与划线价绑成 .product-card__price-main 一组（nowrap），折扣胶囊作为整体
      换到第二行：窄卡（手机两列，卡内容宽约 106px）装不下三件套，
      绑成组之后换行点在"价格块 / 胶囊"之间，不会把两个价格拆开。
      折扣缺数据时只出现现价，不留空位、不显示 0%（AGENTS §6）。
      百分比与 PDP 同一算法（main-product.liquid 顶部同款），两处不会漂。
    {%- endcomment -%}
    {%- liquid
      assign card_has_discount = false
      assign card_save_percent = 0
      if product.compare_at_price > product.price
        assign card_has_discount = true
        assign card_price_diff = product.compare_at_price | minus: product.price
        assign card_save_percent = card_price_diff | times: 100.0 | divided_by: product.compare_at_price | round
      endif
    -%}
    <p class="product-card__price">
      <span class="product-card__price-main">
        <span class="product-card__price-current">{{ product.price | money }}</span>
        {%- if card_has_discount -%}
          <s class="product-card__price-compare">{{ product.compare_at_price | money }}</s>
        {%- endif -%}
      </span>
      {%- if card_has_discount -%}
        <span class="product-card__price-save">
          {{- 'products.product.save_percent' | t: percent: card_save_percent -}}
        </span>
      {%- endif -%}
    </p>

    {%- comment -%} 星级：官方 Product Reviews app metafield；无数据整行不渲染 {%- endcomment -%}    {%- liquid
      assign rating_value = product.metafields.reviews.rating.value.rating
      assign rating_count = product.metafields.reviews.rating_count.value
    -%}
    {%- if rating_value != blank -%}
      <a class="product-card__rating" href="{{ product.url }}#reviews">
        <svg class="product-card__star" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" focusable="false">
          <path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9L12 2.5Z" fill="currentColor"/>
        </svg>
        <span class="product-card__rating-value">{{ rating_value | round: 1 }}</span>
        {%- if rating_count != blank -%}
          <span class="product-card__rating-count">({{ rating_count }})</span>
        {%- endif -%}
        <span class="visually-hidden">{{ 'products.product_card.rating_label' | t: rating: rating_value }}</span>
      </a>
    {%- endif -%}

    {%- comment -%} 规格标签行（2026-10-16 刘工参考图）：胶囊标签，纯展示不可点。
        电池 = platform.battery_platform（'N/A' 跳过）；尺寸 = cutting width（跟
        show_width 开关、经 spec-value 换算）；操作方式 = spec.drive_type（'N/A' 跳过）；
        动力源 = spec.power_source（跟 show_power 开关）。缺值跳项，整行可空。 {%- endcomment -%}
    {%- liquid
      assign battery_platform = product.metafields.platform.battery_platform.value
      assign drive_type = product.metafields.spec.drive_type.value
      assign has_tags = false
      if battery_platform != blank and battery_platform != 'N/A'
        assign has_tags = true
      endif
      if show_width and product.metafields.spec.cutting_width_mm.value != blank
        assign has_tags = true
      endif
      if drive_type != blank and drive_type != 'N/A'
        assign has_tags = true
      endif
      if show_power and product.metafields.spec.power_source.value != blank
        assign has_tags = true
      endif
    -%}
    {%- if has_tags -%}
      <ul class="product-card__tags" role="list">
        {%- if battery_platform != blank and battery_platform != 'N/A' -%}
          <li class="product-card__tag">{{ battery_platform }}</li>
        {%- endif -%}
        {%- if show_width and product.metafields.spec.cutting_width_mm.value != blank -%}
          <li class="product-card__tag">
            {%- render 'spec-value', value: product.metafields.spec.cutting_width_mm.value, unit_type: 'length_mm', spec_class: 'card' -%}
          </li>
        {%- endif -%}
        {%- if drive_type != blank and drive_type != 'N/A' -%}
          <li class="product-card__tag">{{ drive_type }}</li>
        {%- endif -%}
        {%- if show_power and product.metafields.spec.power_source.value != blank -%}
          <li class="product-card__tag">{{ product.metafields.spec.power_source.value }}</li>
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- comment -%} 对比入口（SDD §6.2.8）：行为由 assets/compare.js 的
        <compare-toggle> 接管；文案与上限全部由 Liquid 下发，脚本不硬编码。
        分组键为空或 compare_hidden 为真 → 整个入口不渲染。
        缩略图存 480px 派生：底部条把它缩到 40px 显示，对比页表头则要铺到 ~400px ——
        存 120px 会在表头上被放大成糊图（2026-10-22 实测）。同一张图两处复用，不多一次请求。 {%- endcomment -%}
    {%- if product.metafields.spec.compare_group.value != blank
      and product.metafields.spec.compare_hidden.value != 'TRUE' -%}
      {%- assign compare_group = product.metafields.spec.compare_group.value -%}
      {%- assign compare_image = '' -%}
      {%- if product.featured_image -%}
        {%- assign compare_image = product.featured_image | image_url: width: 480 -%}
      {%- endif -%}
      <compare-toggle
        class="product-card__compare-toggle"
        data-group="{{ compare_group | escape }}"
        data-handle="{{ product.handle }}"
        data-title="{{ product.title | escape }}"
        data-url="{{ product.url }}"
        {%- if compare_image != '' %} data-image="{{ compare_image }}"{% endif %}
        data-max="4"
        data-label-added="{{ 'compare.added' | t }}"
        data-label-conflict-cross-group="{{ 'compare.conflict.cross_group' | t }}"
        data-label-conflict-clear-and-add="{{ 'compare.conflict.clear_and_add' | t }}"
        data-label-conflict-full="{{ 'compare.conflict.full' | t: max: 4 }}"
        data-label-conflict-cancel="{{ 'compare.conflict.cancel' | t }}"
      >
        <button
          type="button"
          class="product-card__compare"
          aria-pressed="false"
        >
          <span class="product-compare__box" aria-hidden="true">
            {{- 'icon-compare.svg' | inline_asset_content -}}
          </span>
          <span class="product-compare__label">{{ 'products.product_card.add_to_compare' | t }}</span>
        </button>
      </compare-toggle>
    {%- endif -%}

    {%- comment -%} 快速加购（T-1.1）：仅调用方传 quick_add 且单变体时渲染；多变体无 CTA；售罄置灰。
        无 JS 时整表单 POST /cart/add（默认跳转购物车页），JS 由 quick-add 自定义元素拦截为 fetch。
        2026-10-16 刘工：挪到卡内最末 + margin-top:auto，各卡文字行数不一时按钮仍统一贴卡底。 {%- endcomment -%}
    {%- if quick_add and product.variants.size == 1 -%}
      <quick-add class="product-card__quick-add">
        <form method="post" action="{{ routes.cart_add_url }}" accept-charset="UTF-8">
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <input type="hidden" name="quantity" value="1">
          <button
            type="submit"
            class="product-card__add"
            {% unless product.available %}disabled{% endunless %}
            data-added-label="{{ 'products.product_card.added' | t }}"
            data-added-message="{{ 'products.product_card.added_message' | t: title: product.title }}"
            data-error-message="{{ 'products.product_card.add_error' | t }}"
          >
            {%- if product.available -%}
              {{ 'products.product_card.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product_card.sold_out' | t }}
            {%- endif -%}
          </button>
        </form>
        <p class="visually-hidden" role="status" data-quick-add-status></p>
      </quick-add>
    {%- endif -%}
  </tilt-element>
{%- endif -%}
