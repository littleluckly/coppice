

<compare-entry
  class="compare-entry{% if class != blank %} {{ class }}{% endif %}"
  {% render 'compare-page-urls' %}
  data-max="4"
  data-empty
  data-pending
  data-label-empty="{{ 'compare.entry_label_empty' | t }}"
  data-label-count="{{ 'compare.entry_label' | t: count: '[count]' }}"
  data-tip-empty="{{ 'compare.entry_tip' | t }}"
  data-tip-count="{{ 'compare.entry_tip_count' | t: count: '[count]' }}"
>
  <a class="compare-entry__link" href="#" aria-label="{{ 'compare.entry_label_empty' | t }}">
    {{ 'icon-compare.svg' | inline_asset_content }}
    {%- if show_label -%}
      <span class="compare-entry__label">{{ 'compare.heading' | t }}</span>
    {%- endif -%}
    <span class="compare-entry__count" data-compare-count hidden aria-hidden="true"></span>
  </a>
</compare-entry>
