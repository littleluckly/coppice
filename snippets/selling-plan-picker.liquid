

{%- liquid
  assign picker_variant = variant | default: product.selected_or_first_available_variant
  assign plan_heading = true
  if product.requires_selling_plan and product.selling_plan_groups.size == 1
    assign plan_heading = false
  endif
-%}

{%- capture plan_data -%}
  {
  {%- for v in product.variants -%}
    "{{ v.id }}": {
      "price": {{ v.price | money | json }},
      "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
      "save": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}{% else %}0{% endif %},
      "requiresPlan": {{ v.requires_selling_plan | default: false }},
      "plans": {
        {%- for allocation in v.selling_plan_allocations -%}
          "{{ allocation.selling_plan.id }}": {
            "price": {{ allocation.price | money | json }},
            "compare": {% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | money | json }}{% else %}null{% endif %},
            "save": {% if allocation.compare_at_price > allocation.price %}{{ allocation.compare_at_price | minus: allocation.price | times: 100.0 | divided_by: allocation.compare_at_price | round }}{% else %}0{% endif %}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
  }
{%- endcapture -%}

<selling-plan-picker
  class="product-plans"
  data-variant-id="{{ picker_variant.id }}"
  data-save-template="{{ 'products.product.save_percent' | t: percent: '[percent]' | escape }}"
  data-required-message="{{ 'products.product.choose_purchase_option' | t | escape }}"
>
  <script type="application/json" data-plan-json>{{ plan_data | strip }}</script>

  <fieldset class="product-plans__set">
    {%- if plan_heading -%}
      <legend class="product-plans__heading">{{ 'products.product.purchase_options' | t }}</legend>
    {%- else -%}
      <legend class="visually-hidden">{{ 'products.product.purchase_options' | t }}</legend>
    {%- endif -%}

    {%- unless product.requires_selling_plan -%}
      <div class="product-plans__group" data-plan-group>
        <label class="product-plans__option" data-plan-option>
          <input
            class="product-plans__radio"
            type="radio"
            id="plan-{{ section.id }}-one-time"
            name="selling_plan"
            value=""
            data-plan-radio
            data-one-time
            {% if product.selected_selling_plan == blank %}
              checked
            {% endif %}
          >
          <span class="product-plans__body">
            <span class="product-plans__name">{{ 'products.product.one_time_purchase' | t }}</span>
          </span>
        </label>
      </div>
    {%- endunless -%}

    {%- for group in product.selling_plan_groups -%}
      <div class="product-plans__group" data-plan-group>
        <p class="product-plans__group-name">{{ group.name | escape }}</p>

        {%- for plan in group.selling_plans -%}

          {%- assign plan_save = 0 -%}
          {%- if plan.price_adjustments.size == 1 -%}
            {%- assign first_adjustment = plan.price_adjustments.first -%}
            {%- if first_adjustment.value_type == 'percentage' -%}
              {%- assign plan_save = first_adjustment.value -%}
            {%- endif -%}
          {%- endif -%}
          {%- if plan.name contains '%' -%}
            {%- assign plan_save = 0 -%}
          {%- endif -%}

          <label class="product-plans__option" data-plan-option>
            <input
              class="product-plans__radio"
              type="radio"
              id="plan-{{ section.id }}-{{ plan.id }}"
              name="selling_plan"
              value="{{ plan.id }}"
              data-plan-radio
              data-plan-id="{{ plan.id }}"
              {% if product.selected_selling_plan.id == plan.id %}
                checked
              {% endif %}
            >
            <span class="product-plans__body">
              <span class="product-plans__name">{{ plan.name | escape }}</span>
              {%- if plan_save > 0 -%}
                <span class="product-plans__save">
                  {{- 'products.product.save_percent' | t: percent: plan_save -}}
                </span>
              {%- endif -%}
            </span>
          </label>
        {%- endfor -%}
      </div>
    {%- endfor -%}
  </fieldset>
</selling-plan-picker>
