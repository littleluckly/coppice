{% doc %}
  compare-bar — 底部临时确认条（SDD §6.2.8）。

  **与页头图标的分工**：页头图标是持久状态（有几款在比），这里只在「刚加入一款」
  时冒头，告诉用户刚做了什么、并提供移除/查看的快捷方式。

  · **常驻**：只要清单非空就一直显示（2026-10-22 刘工改）。不设自动消失计时
    （WCAG 2.2.1）；用户可点「收起」折成右下角胶囊，点胶囊还原，**收起不持久化**。
  · DOM 惰性构建：内容放在 `<template>` 里，首次需要时才实例化。
  · 没有分组配置对比页时不渲染（`compare-page-urls` 输出 hidden 时无从跳转）。
  · 关闭后焦点交还 `#MainContent`，不落回 body。

  @param {string} [class] - 追加到根元素的 class
{% enddoc %}

<compare-bar
  class="compare-bar{% if class != blank %} {{ class }}{% endif %}"
  {% render 'compare-page-urls' %}
  data-max="4"
  data-label-progress="{{ 'compare.bar.progress' | t: count: '[count]', max: '[max]' }}"
  data-label-remove="{{ 'compare.remove' | t }}"
  data-label-view="{{ 'compare.view' | t }}"
  data-label-added="{{ 'compare.announce.added' | t: count: '[count]' }}"
  hidden
>
  <template>
    <div class="compare-bar__inner" data-compare-inner>
      <p class="compare-bar__progress" data-compare-progress></p>
      <ul class="compare-bar__items" role="list" data-compare-items></ul>
      <a class="compare-bar__view" href="#" data-compare-view>{{ 'compare.view' | t }}</a>
      <button
        type="button"
        class="compare-bar__close"
        data-compare-collapse
        aria-label="{{ 'compare.bar.collapse' | t }}"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </div>

    {%- comment -%}
      收起态：只留一个胶囊，点开还原。底部条是**常驻**的（有对比项就在），
      收起只是让开内容，不是关闭功能。
    {%- endcomment -%}
    <button
      type="button"
      class="compare-bar__pill"
      data-compare-expand
      aria-label="{{ 'compare.bar.expand' | t }}"
    >
      {{ 'icon-compare.svg' | inline_asset_content }}
      <span class="compare-bar__pill-count" data-compare-pill-count>0</span>
    </button>

    <p class="visually-hidden" role="status" aria-live="polite" data-compare-status></p>
  </template>
</compare-bar>
