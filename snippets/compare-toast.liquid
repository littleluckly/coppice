

<compare-toast hidden>
  <div class="compare-toast__inner">
    <span class="compare-toast__icon" aria-hidden="true">!</span>
    <p class="compare-toast__message" id="compare-toast-message" data-compare-toast-message></p>
    <button
      type="button"
      class="compare-toast__close"
      data-compare-toast-close
      aria-label="{{ 'compare.toast.close' | t }}"
    >
      {{ 'icon-close.svg' | inline_asset_content }}
    </button>
    <div class="compare-toast__actions">
      <button
        type="button"
        class="compare-toast__primary"
        data-compare-toast-primary
        aria-describedby="compare-toast-message"
        hidden
      ></button>
    </div>
  </div>
</compare-toast>
