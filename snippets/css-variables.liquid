{% style %}
  {% # Loads all font variantions with display: swap %}
  {{ settings.type_primary_font | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'weight', 'bold' | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {{ settings.type_primary_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}

  :root {
    --font-primary--family: {{ settings.type_primary_font.family }}, {{ settings.type_primary_font.fallback_families }};
    --font-primary--style: {{ settings.type_primary_font.style }};
    --font-primary--weight: {{ settings.type_primary_font.weight }};
    --page-width: {{ settings.max_page_width }};
    --page-margin: {{ settings.min_page_margin }}px;
    --color-background: {{ settings.background_color }};
    --color-foreground: {{ settings.foreground_color }};
    --color-brand: {{ settings.brand_color }};
    --color-brand-accent: {{ settings.brand_accent }};

    /* 次级文字色（2026-10-21）：规格行 / 划线价 / 评论数这类"比正文轻一档"的小字。
       定在 70% 是有依据的，不是随手取：本主题前景 #333 与白底按 60% 混出来是
       #858585 = 3.69:1，**低于 WCAG AA 对小字的 4.5:1**；临界点约 68%，
       70% 得到 ≈4.95:1，Noir 深底上 ≈8:1。调这个值之前先算对比度，
       别再往 60% 以下走（Lighthouse color-contrast 会挂）。 */
    --color-foreground-muted: color-mix(in srgb, var(--color-foreground) 70%, transparent);

    /* 语义色：警告。**不跟随 preset 品牌色** —— 警告必须与品牌绿区分开。
       配色的两条硬约束：
       1) 这组黄**不许配白字**：#FBBF24 + #FFF 约 1.9:1，连非文本图形的 3:1 都不到；
       2) 压在上面的字**也不用纯黑**：黑与黄是互补跳色，观感生硬。
          用同色系压暗的深黄棕 #5C3D00 —— 对比度 5.92:1，视觉连续。
       固定值不跟 preset（深底 preset 下若取 background 会变成深色、反而贴同色调）。 */
    --color-warning: #FBBF24;
    --color-warning-on: #5C3D00;

    /* 浅品牌绿（2026-10-17）：hover 光晕等场合用。oklch from 只取品牌色相，
       亮度/饱和度独立定值——商家换任何深浅的品牌绿，算出来的浅绿都够亮
       （当前 Coppice 品牌色下 ≈ #74C4A7；Noir 同色）。
       两行同写是有意的：后一行是相对颜色语法（oklch from），不支持的旧浏览器
       整行解析作废、落到前一行静态 fallback。调明暗改 0.76（0.68 深 → 0.80 浅）。 */
    --color-brand-light: #74C4A7;
    --color-brand-light: oklch(from {{ settings.brand_color | default: '#1E4B3C' }} 0.76 0.09 h);

    /* 骨架（页头组 + 页脚）配色。留空 = 回落到上方全局色，即浅色骨架，
       渲染结果与既有实现逐像素一致；填入深色值即得到深色骨架——
       只有页头/页脚翻转，内容区不动（映射规则见 assets/critical.css）。
       三个变量不写 defaults 是有意的：color 设置清空后返回 blank，
       这里靠 default 过滤器回落，商家才能表达"跟随全局"。 */
    --color-skeleton-background: {{ settings.skeleton_background_color | default: settings.background_color }};
    --color-skeleton-foreground: {{ settings.skeleton_foreground_color | default: settings.foreground_color }};
    --color-skeleton-accent: {{ settings.skeleton_accent_color | default: settings.brand_color }};

    /* 页头底色（2026-10-28 刘工）：不单开设置项，直接跟着骨架明暗走——
       浅色骨架 → 取品牌色色相、极高明度的淡绿（非常浅的绿，但一眼能看出是"彩色页头"）；
       深色骨架 → 纯黑，比内容区再暗一档，靠明度差形成分隔。
       判据是 color_brightness（0–255），128 为明暗中线；
       Liquid 的 if 不支持过滤器，所以必须先 assign 再比。
       两行同写：oklch 相对颜色语法在 Chrome 119 / Safari 16.4 以下整行作废，
       落到上一行的 color-mix（灰绿，不如下面鲜，但不会变透明——与 --color-brand-light 同一写法）。 */
    {%- assign header_base = settings.skeleton_background_color | default: settings.background_color -%}
    {%- assign header_luma = header_base | color_brightness -%}
    {%- if header_luma > 128 -%}
      --color-header-surface: color-mix(in srgb, var(--color-skeleton-accent) 8%, var(--color-skeleton-background));
      --color-header-surface: oklch(from var(--color-skeleton-accent) 0.955 0.024 h);
    {%- else -%}
      --color-header-surface: #000000;
    {%- endif -%}

    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;
  }
{% endstyle %}
