

{%- liquid
  assign output = ''
  if value == blank or value == 0
    assign output = ''
  else
    assign unit_system = settings.spec_unit_system | default: 'imperial'
    case unit_type
      when 'length_mm'
        if unit_system == 'imperial'
          assign converted = value | times: 0.0393701 | round: 1
          assign output = converted | append: ' in'
        else
          assign output = value | append: ' mm'
        endif
      when 'weight_kg'
        if unit_system == 'imperial'
          assign converted = value | times: 2.20462 | round
          assign output = converted | append: ' lb'
        else
          assign output = value | append: ' kg'
        endif
      when 'area_sqft'
        if unit_system == 'imperial'
          assign output = value | append: ' sq ft'
        else
          assign converted = value | times: 0.092903 | round
          assign output = converted | append: ' m2'
        endif
      when 'displacement_cc'
        assign output = value | append: ' cc'
      when 'power_w'
        if unit_system == 'imperial'
          assign converted = value | times: 0.00134102 | round: 1
          assign output = converted | append: ' hp'
        else
          assign output = value | append: ' W'
        endif
    endcase
  endif

  assign output = output | replace: '.0 ', ' '
-%}
{%- if output != blank -%}
  <span class="spec-value{% if spec_class %} spec-value--{{ spec_class }}{% endif %}" data-unit-system="{{ unit_system }}">{{ output }}</span>
{%- endif -%}
