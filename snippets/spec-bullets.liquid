

{%- liquid
  assign b1_value = product.metafields.spec.cutting_width_mm.value
  assign b1_unit = 'length_mm'
  assign b1_icon = 'icon-spec-width.svg'
  assign b1_label = 'products.product.spec_cutting_width' | t
  if b1_value == blank
    assign b1_value = product.metafields.spec.bar_length_mm.value
    assign b1_icon = 'icon-spec-bar.svg'
    assign b1_label = 'products.product.spec_bar_length' | t
  endif

  assign b2_is_text = false
  assign b2_value = ''
  assign b2_unit = 'displacement_cc'
  assign b2_label = 'products.product.spec_engine' | t

  if product.metafields.spec.power_source.value == 'Battery'
    assign b2_label = 'products.product.spec_power' | t
    if product.metafields.spec.power_w.value != blank
      assign b2_value = product.metafields.spec.power_w.value
      assign b2_unit = 'power_w'
    elsif product.metafields.platform.battery_platform.value != blank
      assign b2_is_text = true
      assign b2_value = product.metafields.platform.battery_platform.value
      assign b2_label = 'products.product.spec_battery' | t
    endif
  else
    assign b2_value = product.metafields.spec.displacement_cc.value
  endif

  assign b3_value = product.metafields.spec.drive_type.value
  if b3_value == 'N/A'
    assign b3_value = ''
  endif
  assign b3_show_label = true
  assign b3_lower = b3_value | downcase
  if b3_lower contains 'drive'
    assign b3_show_label = false
  endif
-%}

{%- if b1_value != blank or b2_value != blank or b3_value != blank -%}
  <ul class="spec-bullets" role="list">
    {%- if b1_value != blank -%}
      <li class="spec-bullets__item">
        <span class="spec-bullets__icon" aria-hidden="true">{{ b1_icon | inline_asset_content }}</span>
        <span class="spec-bullets__text">
          {%- render 'spec-value', value: b1_value, unit_type: b1_unit %}
          <span class="spec-bullets__label">{{ b1_label }}</span>
        </span>
      </li>
    {%- endif -%}

    {%- if b2_value != blank -%}
      <li class="spec-bullets__item">
        <span class="spec-bullets__icon" aria-hidden="true">{{ 'icon-spec-engine.svg' | inline_asset_content }}</span>
        <span class="spec-bullets__text">
          {%- if b2_is_text -%}
            <span class="spec-bullets__value">{{ b2_value }}</span>
          {%- else -%}
            {%- render 'spec-value', value: b2_value, unit_type: b2_unit %}
          {%- endif -%}
          <span class="spec-bullets__label">{{ b2_label }}</span>
        </span>
      </li>
    {%- endif -%}

    {%- if b3_value != blank -%}
      <li class="spec-bullets__item">
        <span class="spec-bullets__icon" aria-hidden="true">{{ 'icon-spec-drive.svg' | inline_asset_content }}</span>
        <span class="spec-bullets__text">
          <span class="spec-bullets__value">{{ b3_value }}</span>
          {%- if b3_show_label %}
            <span class="spec-bullets__label">{{ 'products.product.spec_drive' | t }}</span>
          {%- endif -%}
        </span>
      </li>
    {%- endif -%}
  </ul>
{%- endif -%}
