[
  {
    "name": "theme_info",
    "theme_name": "Coppice",
    "theme_version": "0.1.0",
    "theme_author": "Shopify",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "t:general.primary"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "t:labels.page_width",
        "options": [
          {
            "value": "90rem",
            "label": "t:options.page_width.narrow"
          },
          {
            "value": "110rem",
            "label": "t:options.page_width.wide"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      }
    ]
  },
  {
    "name": "t:general.spec_units",
    "settings": [
      {
        "type": "select",
        "id": "spec_unit_system",
        "label": "t:labels.spec_unit_system",
        "options": [
          {
            "value": "imperial",
            "label": "t:options.spec_unit_system.imperial"
          },
          {
            "value": "metric",
            "label": "t:options.spec_unit_system.metric"
          }
        ],
        "default": "imperial",
        "info": "t:labels.spec_unit_system_info"
      }
    ]
  },
  {
    "name": "t:general.colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "t:labels.background"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#333333",
        "label": "t:labels.foreground"
      },
      {
        "type": "color",
        "id": "brand_color",
        "default": "#1E4B3C",
        "label": "t:labels.brand"
      },
      {
        "type": "color",
        "id": "brand_accent",
        "default": "#2E6B4E",
        "label": "t:labels.brand_accent"
      },
      {
        "type": "header",
        "content": "t:general.header_skeleton"
      },
      {
        "type": "color",
        "id": "skeleton_background_color",
        "label": "t:labels.skeleton_background",
        "info": "t:labels.skeleton_background_info",
        "placeholder": "Inherited"
      },
      {
        "type": "color",
        "id": "skeleton_foreground_color",
        "label": "t:labels.skeleton_foreground",
        "info": "t:labels.skeleton_foreground_info",
        "placeholder": "Inherited"
      },
      {
        "type": "color",
        "id": "skeleton_accent_color",
        "label": "t:labels.skeleton_accent",
        "info": "t:labels.skeleton_accent_info",
        "placeholder": "Inherited"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
  {
    "name": "t:general.compare",
    "settings": [
      {
        "type": "header",
        "content": "t:general.compare_groups_header"
      },
      {
        "type": "text",
        "id": "compare_groups",
        "label": "t:labels.compare_groups",
        "info": "t:labels.compare_groups_info",
        "default": "walk-behind-mower,riding-mower,chainsaw,string-trimmer"
      },
      {
        "type": "header",
        "content": "t:general.compare_page_header"
      },
      {
        "type": "collection_list",
        "id": "compare_collections",
        "label": "t:labels.compare_collections",
        "info": "t:labels.compare_collections_info",
        "limit": 12
      },
      {
        "type": "range",
        "id": "compare_default_columns",
        "min": 2,
        "max": 4,
        "step": 1,
        "label": "t:labels.compare_default_columns",
        "info": "t:labels.compare_default_columns_info",
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "compare_page_indexing",
        "label": "t:labels.compare_page_indexing",
        "info": "t:labels.compare_page_indexing_info",
        "default": true
      }
    ]
  }
]
