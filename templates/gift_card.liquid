{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {% style %}
      main {
        text-align: center;
      }
      main img {
        display: unset;
      }
    {% endstyle %}

    {{ content_for_header }}
  </head>

  <body>
    <main>
      <div class="shopify-section">
        <h1>{{ gift_card.balance | money }}</h1>

        {% if gift_card.enabled == false or gift_card.expired %}
          <p>{{ 'gift_card.expired' | t }}</p>
        {% endif %}

        {% if gift_card.expires_on %}
          {% assign expires_on = gift_card.expires_on | date: '%B %e, %Y' %}
          <p>
            {{ 'gift_card.expires_on' | t: expires_on: expires_on }}
          </p>
        {% endif %}

        <p>
          {%- comment -%}
            G-13: this branch used to read `settings.logo` before that global
            setting existed, so it was always false. Now the global Brand logo
            is real; snippets/brand-logo.liquid also picks the dark variant.
            Keep the built-in card illustration as the no-logo fallback.
          {%- endcomment -%}
          {%- if settings.logo != blank or settings.logo_dark != blank -%}
            {% render 'brand-logo',
              logo_class: 'gift-card__logo',
              logo_width: 300,
              logo_widths: '150, 300, 450',
              logo_sizes: '300px',
              logo_alt: shop.name,
              logo_loading: 'eager'
            %}
          {%- else -%}
            <img
              src="{{ 'gift-card/card.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.card' | t }}"
              width="300"
              height="200"
            >
          {%- endif -%}
        </p>

        <h2>{{ shop.name }}</h2>
        <p>{{ 'gift_card.use_at_checkout' | t }}</p>
        <p>{{ gift_card.code | format_code }}</p>

        {% if gift_card.pass_url %}
          <a href="{{ gift_card.pass_url }}">
            <img
              src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
              alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
              width="200"
              height="60"
            >
          </a>
        {% endif %}
      </div>
    </main>
  </body>
</html>
