def lb_to_g(lb: float) -> int:
    return round(lb * 453.592)


def _num(v) -> str:
    """可选数字字段：缺省（None）→ 空字符串，绝不能落成 'None' 或 0。"""
    return "" if v is None or v == "" else str(v)


def build_rows():
    rows = []
    for p in PRODUCTS:
        is_acc = p.get("kind") == "acc"
        # 配件不公布重量 → 变体克重留空（Shopify 允许），不用密度/估值反推
        grams = "" if is_acc else str(lb_to_g(p["weight_lb"]))
        imgs = IMAGES[p["handle"]]
        base = {c: "" for c in OFFICIAL_KEEP}
        base.update({
            "Title": p["title"],
            "URL handle": p["handle"],
            "Description": p["desc"],
            "Vendor": p.get("vendor", "Northbark"),
            "Product category": p["category"],
            "Type": p["ptype"],
            "Tags": p["tags"],
            "Published on online store": "TRUE",
            "Status": "Active",
            "SKU": p["sku"],
            "Option1 name": "Title",
            "Option1 value": "Default Title",
            "Price": p["price"],
            "Charge tax": "TRUE",
            "Inventory tracker": "shopify",
            "Inventory quantity": "25",
            "Continue selling when out of stock": "DENY",
            "Weight value (grams)": grams,
            "Weight unit for display": "lb",
            "Requires shipping": "TRUE",
            "Fulfillment service": "manual",
            "Image position": "1",
            "Product image URL": imgs["main"][0],
            "Image alt text": imgs["main"][1],
        })
        meta = {h: "" for h in META_HEADER}
        if is_acc:
            # 配件只写三项：物流档 + 备货天数 + 适配说明。其余全部真空。
            meta.update({
                "Shipping class (product.metafields.logistics.shipping_class)": "Parcel",
                "Lead time (days) (product.metafields.logistics.lead_time_days)": str(p.get("lead", 3)),
                "Fitment note (product.metafields.acc.fitment_note)": p["fitment"],
            })
        else:
            meta.update({
                "Power source (product.metafields.spec.power_source)": p["power_source"],
                "Operation type (product.metafields.spec.operation_type)": p["operation"],
                "Drive type (product.metafields.spec.drive_type)": p["drive"],
                "Area coverage (product.metafields.spec.area_coverage)": p["area"],
                # duty 缺省 Residential；Semi-pro / Commercial 由产品显式声明
                "Duty level (product.metafields.spec.duty_level)": p.get("duty", "Residential"),
                "Compare group (product.metafields.spec.compare_group)": p["compare_group"],
                "Displacement (cc) (product.metafields.spec.displacement_cc)": _num(p.get("cc")),
                "Power (W) (product.metafields.spec.power_w)": _num(p.get("power_w")),
                "Cutting width (mm) (product.metafields.spec.cutting_width_mm)": _num(p.get("cut_mm")),
                "Bar length (mm) (product.metafields.spec.bar_length_mm)": _num(p.get("bar_mm")),
                "Weight (kg) (product.metafields.spec.weight_kg)": f"{p['weight_kg']}",
                "Noise (dB A) (product.metafields.spec.noise_db)": _num(p.get("noise")),
                # 面积分段 N/A（打草机 / 链锯）→ 数字版必须真空，不能落 0
                "Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)":
                    str(AREA_SQFT[p["area"]]) if p["area"] in AREA_SQFT else "",
                "Spec variance note (product.metafields.spec.spec_variance_note)": p.get("spec_note", ""),
                "Warranty (months) (product.metafields.spec.warranty_months)": str(p["warranty_mo"]),
                "Battery platform (product.metafields.platform.battery_platform)": p["battery_platform"],
                "Shipping class (product.metafields.logistics.shipping_class)": p["shipping_class"],
                "Needs liftgate (product.metafields.logistics.needs_liftgate)": p["liftgate"],
                "Assembly required (product.metafields.logistics.assembly_required)": p["assembly"],
                "Lead time (days) (product.metafields.logistics.lead_time_days)": str(p["lead"]),
            })
        rows.append({**base, **meta})
        # 第二张图行：Shopify CSV 规范——图片行只填 handle + 图片列，其余留空
        if imgs["second"][0]:
            img_row = {c: "" for c in OFFICIAL_KEEP + META_HEADER}
            img_row.update({
                "URL handle": p["handle"],
                "Image position": "2",
                "Product image URL": imgs["second"][0],
                "Image alt text": imgs["second"][1],
            })
            rows.append(img_row)
    return rows


# ---------------------------------------------------------------- 校验（SDD §5.9 预校验口径）

def validate(rows):
    errors, warnings, infos = [], [], []
    n_cols = len(OFFICIAL_KEEP) + len(META_HEADER)

    skus = set()
    handles = set()
    main_handles = {r["URL handle"] for r in rows if r["SKU"]}
    for i, row in enumerate(rows):
        if len(row) != n_cols:
            errors.append(f"行 {i+1}: 列数 {len(row)} != {n_cols}")
        h = row["URL handle"]
        if not h:
            errors.append(f"行 {i+1}: URL handle 为空")
        # 图片行（第二张图）：只带 handle + 图片列，专走图片行校验
        is_img_row = (not row["SKU"]) and bool(h)
        if is_img_row:
            if h not in main_handles:
                errors.append(f"行 {i+1}: 图片行 handle 无对应主行: {h}")
            if row["Image position"] != "2":
                errors.append(f"行 {i+1}: 图片行 Image position 应为 2")
            if not row["Product image URL"].startswith("https://cdn.shopify.com/"):
                errors.append(f"行 {i+1}: 图片行 URL 非 Shopify CDN")
            if not row["Image alt text"]:
                errors.append(f"行 {i+1}: 图片行 alt 为空（无障碍硬要求）")
            continue
        if h in handles:
            errors.append(f"行 {i+1}: URL handle 重复 {h}")
        handles.add(h)
        sku = row["SKU"]
        if not sku:
            errors.append(f"行 {i+1}: SKU 为空")
        if sku in skus:
            errors.append(f"行 {i+1}: SKU 重复 {sku}")
        skus.add(sku)
        if row["Image position"] != "1":
            errors.append(f"行 {i+1}: 主行 Image position 应为 1")
        # 图片列（T-0.2）：URL 缺失记警告（导入后无主图），alt 缺失记错误（无障碍硬要求）
        if not row["Product image URL"]:
            warnings.append(f"行 {i+1}: Product image URL 为空（{row['URL handle']}，导入后无主图）")
        elif not row["Product image URL"].startswith("https://cdn.shopify.com/"):
            warnings.append(f"行 {i+1}: Product image URL 非 Shopify CDN: {row['Product image URL'][:60]}")
        if not row["Image alt text"]:
            errors.append(f"行 {i+1}: Image alt text 为空（无障碍硬要求）")
        # 单变体固定写法
        if row["Option1 name"] != "Title" or row["Option1 value"] != "Default Title":
            errors.append(f"行 {i+1}: 单变体商品必须 Option1 = Title / Default Title")
        # 商品级字段只在首行：本文件每商品只有一行，Title 必须非空
        if not row["Title"]:
            errors.append(f"行 {i+1}: Title 为空")
        # 值域校验
        enum_checks = [
            ("Power source (product.metafields.spec.power_source)", "power_source"),
            ("Operation type (product.metafields.spec.operation_type)", "operation_type"),
            ("Drive type (product.metafields.spec.drive_type)", "drive_type"),
            ("Area coverage (product.metafields.spec.area_coverage)", "area_coverage"),
            ("Duty level (product.metafields.spec.duty_level)", "duty_level"),
            ("Compare group (product.metafields.spec.compare_group)", "compare_group"),
            ("Shipping class (product.metafields.logistics.shipping_class)", "shipping_class"),
        ]
        for col, enum_name in enum_checks:
            v = row[col]
            if v and v not in ENUMS[enum_name]:
                errors.append(f"行 {i+1}: {col} 值 '{v}' 不在预设值域内")
        bp = row["Battery platform (product.metafields.platform.battery_platform)"]
        ps = row["Power source (product.metafields.spec.power_source)"]
        if ps == "Battery":
            if bp not in ENUMS["battery_platform"] - {"N/A"}:
                errors.append(f"行 {i+1}: 电池商品 battery_platform 必填（20V/40V/60V/80V）")
        elif bp:
            warnings.append(f"行 {i+1}: 非电池商品填了 battery_platform={bp}（应为空）")
        # 数字列不得含单位字符
        for col in [
            "Displacement (cc) (product.metafields.spec.displacement_cc)",
            "Power (W) (product.metafields.spec.power_w)",
            "Cutting width (mm) (product.metafields.spec.cutting_width_mm)",
            "Bar length (mm) (product.metafields.spec.bar_length_mm)",
            "Weight (kg) (product.metafields.spec.weight_kg)",
            "Noise (dB A) (product.metafields.spec.noise_db)",
            "Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)",
            "Warranty (months) (product.metafields.spec.warranty_months)",
            "Lead time (days) (product.metafields.logistics.lead_time_days)",
        ]:
            v = row[col]
            if v and not v.replace(".", "").isdigit():
                errors.append(f"行 {i+1}: {col} 含非数字字符: '{v}'")
        # 面积分段与数字版一致性；N/A 必须配空数字（不能落 0 —— 0 会被排序与对比当成真值）
        area = row["Area coverage (product.metafields.spec.area_coverage)"]
        sqft = row["Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)"]
        if area in AREA_SQFT:
            if sqft and AREA_SQFT[area] != int(sqft):
                errors.append(f"行 {i+1}: area_coverage '{area}' 与 sqft {sqft} 不一致")
            if not sqft:
                errors.append(f"行 {i+1}: area_coverage '{area}' 必须有 sqft 数字版")
        elif area == "N/A" and sqft:
            errors.append(f"行 {i+1}: area_coverage = N/A 但 sqft 有值 {sqft}（应为空）")
        # 切割尺寸互斥：割草机/打草机填 cutting_width，链锯填 bar_length，二者不得同时出现
        cw = row["Cutting width (mm) (product.metafields.spec.cutting_width_mm)"]
        bl = row["Bar length (mm) (product.metafields.spec.bar_length_mm)"]
        if cw and bl:
            errors.append(f"行 {i+1}: cutting_width 与 bar_length 同时有值（互斥）")
        if row["Product category"] == TAXO_CHAINSAW and not bl:
            errors.append(f"行 {i+1}: 链锯必须填 bar_length_mm")
        if row["Product category"] in (TAXO_LAWN_MOWER, TAXO_RIDING, TAXO_TRIMMER) and not cw:
            errors.append(f"行 {i+1}: 割草机/打草机必须填 cutting_width_mm")
        if row["Product category"] != TAXO_CHAINSAW and bl:
            errors.append(f"行 {i+1}: 非链锯填了 bar_length_mm（SDD §5.3：只给链锯）")
        # 重量一致性（metafield kg vs 变体克重，±0.3 kg 容差，电池款克重含电池另计）
        # 配件两者都空 → 跳过（不把 "空 vs 空" 当成一致，也不要求配件必须有重量）
        kg_raw = row["Weight (kg) (product.metafields.spec.weight_kg)"]
        g_raw = row["Weight value (grams)"]
        if kg_raw and g_raw:
            kg = float(kg_raw)
            g = int(g_raw) / 1000.0
            if abs(kg - g) > 0.3:
                infos.append(f"行 {i+1}: metafield 重量 {kg} kg 与变体重量 {g} kg 差异超容差（若为电池款含/不含电池差异则属预期）")
        # compare_group 跨类型检查（判据：Product category 受控词表，不用自由文本 Type）
        cat = row["Product category"]
        group = row["Compare group (product.metafields.spec.compare_group)"]
        if cat in ACCESSORY_CATEGORIES:
            # 配件必须无分组：有分组 → 商品卡出 Compare 按钮，却进不了任何对比页
            if group:
                errors.append(f"行 {i+1}: 配件不得填 compare_group（现为 '{group}'）")
        else:
            expected = CATEGORY_GROUP.get(cat)
            if expected is None:
                errors.append(f"行 {i+1}: Product category 不在本文件允许的分类法节点内: {cat}")
            elif group != expected:
                errors.append(f"行 {i+1}: 分类 '{cat.split(' > ')[-1]}' 应属 {expected}，实为 '{group}'")

    return errors, warnings, infos


