def lb_to_g(lb: float) -> int:
    return round(lb * 453.592)


def build_rows():
    rows = []
    for p in PRODUCTS:
        grams = lb_to_g(p["weight_lb"])
        base = {c: "" for c in OFFICIAL_KEEP}
        base.update({
            "Title": p["title"],
            "URL handle": p["handle"],
            "Description": p["desc"],
            "Vendor": p["vendor"],
            "Product category": p["category"],
            "Type": p["ptype"],
            "Tags": p["tags"],
            "Published on online store": "TRUE",
            "Status": "Active",
            "SKU": p["sku"],
            "Option1 name": "Title",
            "Option1 value": "Default Title",
            "Price": p["price"],
            "Charge tax": "TRUE",
            "Inventory tracker": "shopify",
            "Inventory quantity": "25",
            "Continue selling when out of stock": "DENY",
            "Weight value (grams)": str(grams),
            "Weight unit for display": "lb",
            "Requires shipping": "TRUE",
            "Fulfillment service": "manual",
            "Product image URL": IMAGES[p["handle"]][0],
            "Image alt text": IMAGES[p["handle"]][1],
        })
        meta = {h: "" for h in META_HEADER}
        meta.update({
            "Power source (product.metafields.spec.power_source)": p["power_source"],
            "Operation type (product.metafields.spec.operation_type)": p["operation"],
            "Drive type (product.metafields.spec.drive_type)": p["drive"],
            "Area coverage (product.metafields.spec.area_coverage)": p["area"],
            "Duty level (product.metafields.spec.duty_level)": "Residential",
            "Compare group (product.metafields.spec.compare_group)": p["compare_group"],
            "Displacement (cc) (product.metafields.spec.displacement_cc)": str(p["cc"]),
            "Cutting width (mm) (product.metafields.spec.cutting_width_mm)": str(p["cut_mm"]),
            "Weight (kg) (product.metafields.spec.weight_kg)": f"{p['weight_kg']}",
            "Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)": str(AREA_SQFT[p["area"]]),
            "Warranty (months) (product.metafields.spec.warranty_months)": str(p["warranty_mo"]),
            "Battery platform (product.metafields.platform.battery_platform)": p["battery_platform"],
            "Shipping class (product.metafields.logistics.shipping_class)": p["shipping_class"],
            "Needs liftgate (product.metafields.logistics.needs_liftgate)": p["liftgate"],
            "Assembly required (product.metafields.logistics.assembly_required)": p["assembly"],
            "Lead time (days) (product.metafields.logistics.lead_time_days)": str(p["lead"]),
        })
        rows.append({**base, **meta})
    return rows


# ---------------------------------------------------------------- 校验（SDD §5.9 预校验口径）

def validate(rows):
    errors, warnings, infos = [], [], []
    n_cols = len(OFFICIAL_KEEP) + len(META_HEADER)

    skus = set()
    handles = set()
    for i, row in enumerate(rows):
        if len(row) != n_cols:
            errors.append(f"行 {i+1}: 列数 {len(row)} != {n_cols}")
        h = row["URL handle"]
        if not h:
            errors.append(f"行 {i+1}: URL handle 为空")
        if h in handles:
            errors.append(f"行 {i+1}: URL handle 重复 {h}")
        handles.add(h)
        sku = row["SKU"]
        if not sku:
            errors.append(f"行 {i+1}: SKU 为空")
        if sku in skus:
            errors.append(f"行 {i+1}: SKU 重复 {sku}")
        skus.add(sku)
        # 图片列（T-0.2）：URL 缺失记警告（导入后无主图），alt 缺失记错误（无障碍硬要求）
        if not row["Product image URL"]:
            warnings.append(f"行 {i+1}: Product image URL 为空（{row['URL handle']}，导入后无主图）")
        elif not row["Product image URL"].startswith("https://cdn.shopify.com/"):
            warnings.append(f"行 {i+1}: Product image URL 非 Shopify CDN: {row['Product image URL'][:60]}")
        if not row["Image alt text"]:
            errors.append(f"行 {i+1}: Image alt text 为空（无障碍硬要求）")
        # 单变体固定写法
        if row["Option1 name"] != "Title" or row["Option1 value"] != "Default Title":
            errors.append(f"行 {i+1}: 单变体商品必须 Option1 = Title / Default Title")
        # 商品级字段只在首行：本文件每商品只有一行，Title 必须非空
        if not row["Title"]:
            errors.append(f"行 {i+1}: Title 为空")
        # 值域校验
        enum_checks = [
            ("Power source (product.metafields.spec.power_source)", "power_source"),
            ("Operation type (product.metafields.spec.operation_type)", "operation_type"),
            ("Drive type (product.metafields.spec.drive_type)", "drive_type"),
            ("Area coverage (product.metafields.spec.area_coverage)", "area_coverage"),
            ("Duty level (product.metafields.spec.duty_level)", "duty_level"),
            ("Compare group (product.metafields.spec.compare_group)", "compare_group"),
            ("Shipping class (product.metafields.logistics.shipping_class)", "shipping_class"),
        ]
        for col, enum_name in enum_checks:
            v = row[col]
            if v and v not in ENUMS[enum_name]:
                errors.append(f"行 {i+1}: {col} 值 '{v}' 不在预设值域内")
        bp = row["Battery platform (product.metafields.platform.battery_platform)"]
        ps = row["Power source (product.metafields.spec.power_source)"]
        if ps == "Battery":
            if bp not in ENUMS["battery_platform"] - {"N/A"}:
                errors.append(f"行 {i+1}: 电池商品 battery_platform 必填（20V/40V/60V/80V）")
        elif bp:
            warnings.append(f"行 {i+1}: 非电池商品填了 battery_platform={bp}（应为空）")
        # 数字列不得含单位字符
        for col in [
            "Displacement (cc) (product.metafields.spec.displacement_cc)",
            "Cutting width (mm) (product.metafields.spec.cutting_width_mm)",
            "Weight (kg) (product.metafields.spec.weight_kg)",
            "Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)",
            "Warranty (months) (product.metafields.spec.warranty_months)",
            "Lead time (days) (product.metafields.logistics.lead_time_days)",
        ]:
            v = row[col]
            if v and not v.replace(".", "").isdigit():
                errors.append(f"行 {i+1}: {col} 含非数字字符: '{v}'")
        # 面积分段与数字版一致性
        area = row["Area coverage (product.metafields.spec.area_coverage)"]
        sqft = row["Area coverage (sq ft) (product.metafields.spec.area_coverage_sqft)"]
        if area and sqft and AREA_SQFT[area] != int(sqft):
            errors.append(f"行 {i+1}: area_coverage '{area}' 与 sqft {sqft} 不一致")
        # 重量一致性（metafield kg vs 变体克重，±0.3 kg 容差，电池款克重含电池另计）
        kg = float(row["Weight (kg) (product.metafields.spec.weight_kg)"])
        g = int(row["Weight value (grams)"]) / 1000.0
        if abs(kg - g) > 0.3:
            infos.append(f"行 {i+1}: metafield 重量 {kg} kg 与变体重量 {g} kg 差异超容差（若为电池款含/不含电池差异则属预期）")
        # compare_group 跨类型检查（判据：Product category 父级）
        if row["Product category"] == TAXO_RIDING and row["Compare group (product.metafields.spec.compare_group)"] != "riding-mower":
            errors.append(f"行 {i+1}: 骑乘式分类但 compare_group 不是 riding-mower")
        if row["Product category"] == TAXO_LAWN_MOWER and row["Compare group (product.metafields.spec.compare_group)"] != "walk-behind-mower":
            errors.append(f"行 {i+1}: 走步式分类但 compare_group 不是 walk-behind-mower")

    return errors, warnings, infos


def main():
    # 1) 读取官方模板列头，逐字校验保留列名
    with open(TEMPLATE_PATH, newline="", encoding="utf-8-sig") as f:
        template_header = next(csv.reader(f))
    template_header = [h.strip() for h in template_header]
    missing = [c for c in OFFICIAL_KEEP if c not in template_header]
    if missing:
        print("✗ 以下列名在官方模板中不存在（请逐字核对）：")
        for c in missing:
            print("   -", repr(c))
        sys.exit(1)

    # 2) 组装
    rows = build_rows()
    errors, warnings, infos = validate(rows)

    # 3) 写出
    header = OFFICIAL_KEEP + META_HEADER
    with open(OUT_PATH, "w", newline="", encoding="utf-8") as f:
        w = csv.DictWriter(f, fieldnames=header, lineterminator="\n")
        w.writeheader()
        for r in rows:
            w.writerow(r)

    # 4) 报告
    print(f"✓ 已写出 {OUT_PATH}")
    print(f"  列数 = {len(header)}（官方 {len(OFFICIAL_KEEP)} + metafield {len(META_HEADER)}）")
    print(f"  商品数 = {len(rows)}（全部单变体，共 {len(rows)} 行）")
    print(f"  校验：0 错误 / {len(warnings)} 警告 / {len(infos)} 信息" if not errors
          else f"✗ 校验失败：{len(errors)} 错误")
    for e in errors:
        print("  ERROR:", e)
    for w_ in warnings:
        print("  WARN:", w_)
    for i_ in infos:
        print("  INFO:", i_)
    if errors:
        sys.exit(1)


if __name__ == "__main__":
    main()
